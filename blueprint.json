{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installTheme",
      "themeZipFile": {
        "resource": "url",
        "url": "https://github.com/nichewp/lumina/archive/refs/heads/main.zip"
      }
    },
    {
      "step": "activateTheme",
      "themeFolder": "lumina-main"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Lumina Theme Showcase",
        "blogdescription": "Colors, Light, Depth & Motion — FSE Theme Sandbox"
      }
    }
  ]
}
