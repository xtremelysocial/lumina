{	
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Blocks",
	"description": "A high-end evolution of the flat design aesthetic. Featuring atmospheric depth, tactile hardware inspiration, and kinetic motion.",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"yellow": "var(--wp--preset--color--foreground-alt)"
				},
				"border": "var(--wp--preset--color--neutral-alt)",
				"field": { 
					"outline": "rgba(0, 0, 0, 0.25)" 
				},
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"hoverOpacity": "0.8" 
				},
				"link": {
					"hoverOpacity": "0.8" 
				},
				"heading": {
					"text": "var(--wp--preset--color--very-dark-alt)",
					"separator": "var(--wp--preset--color--primary)"
				}				
			},
			"link": {
				"style": "solid",
				"thickness": "1px",
				"position": "under",
				"offset": "0.05em",
				"decorationColor": "currentColor",
				"specialStyle": "dotted",
				"decorationSpecialColor": "rgba(27, 27, 27, 0.4)"
			},			
			"border": {
				"radius": "var(--wp--preset--border-radius--xl, 18px)"
			},
			"button": {
				"radius": "9999px"
			},
			"spacing": {
				"gap": "24px"
			},
			"sidebar": {
				"width": "360px"
			},		
			"animation": {
				"duration": {
					"short": "250ms",
					"medium": "500ms",
					"normal": "800ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.03)",
					"hoverTransform": "scale(1.05)",
					"hoverLargeTransform": "scale(1.08)",
					"objectSmallTransform": "translateY(-3px)",
					"objectTransform": "translateY(-4px)"
				}
			},
			"typography": {
				"fontWeight": {
					"normal": "300",
					"medium": "400",
					"bold": "400"
				}
			},			
			"shadow": {
				"natural": "1px 3px 6px rgba(42, 50, 61, 0.08), 1px 2px 2px rgba(42, 50, 61, 0.06)",
				"deep":    "2px 6px 10px rgba(42, 50, 61, 0.10), 1px 4px 4px rgba(42, 50, 61, 0.08)",
				"sharp":   "4px 10px 18px rgba(42, 50, 61, 0.12), 2px 8px 8px rgba(42, 50, 61, 0.08)",
				"crisp":   "6px 14px 24px rgba(42, 50, 61, 0.11), 3px 12px 12px rgba(42, 50, 61, 0.07)",
				"outline": "0 0 0 2px var(--wp--preset--color--neutral-alt), 1px 3px 6px rgba(42, 50, 61, 0.08)",
				"default": "var:preset|shadow|natural",
				"hover": "var:preset|shadow|deep",
				"hoverHigh": "var:preset|shadow|sharp"
			},
			"typography": {
				"fontWeight": {
					"light": "200",
					"normal": "300",
					"medium": "400",
					"bold": "500"
				}
			}
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1100px",
			"allowCustomContentAndWideSize": false
		},		
		"dimensions": {
			"aspectRatios": [
				{
					"name": "Slim - 16:4.5",
					"slug": "slim",
					"ratio": "16/4.5"
				}
			]
		},		
		"blocks": {
			"core/image": {
				"lightbox": {
					"allowEditing": true,
					"enabled": false
				}
			},
			"core/gallery": {
				"lightbox": {
					"allowEditing": true,
					"enabled": true
				},
				"spacing": {
					"blockGap": true
				}
			}
		},			
		"spacing": {
			"spacingSizes": [
				{
					"slug": "20",
					"size": "calc(0.25 * var(--wp--custom--spacing--gap))",
					"name": "2X-Small"
				},
				{
					"slug": "30",
					"size": "calc(0.5 * var(--wp--custom--spacing--gap))",
					"name": "X-Small"
				},
				{
					"slug": "40",
					"size": "clamp(1rem, 0.85rem + 0.5vw, 1.5rem)",
					"name": "Small (Global Block Gap)"
				},
				{
					"slug": "50",
					"size": "clamp(1.5rem, 1.25rem + 1vw, 2.25rem)",
					"name": "Medium (Page Margins)"
				},
				{
					"slug": "60",
					"size": "clamp(calc(1.5 * var(--wp--custom--spacing--gap)), 4.5svh, calc(2 * var(--wp--custom--spacing--gap)))",
					"name": "Large"
				},
				{
					"slug": "70",
					"size": "calc(1.5 * var(--wp--preset--spacing--60))",
					"name": "X Large"
				},
				{
					"slug": "80",
					"size": "calc(2 * var(--wp--preset--spacing--60))",
					"name": "2X Large"
				}
			]
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#749A8B", "name": "Primary (Crisp Sage)" },
				{ "slug": "primary-alt", "color": "#517064", "name": "Primary Alt (Deep Alpine Sage)" },
				{ "slug": "secondary", "color": "#6885A6", "name": "Secondary (Rich Sapphire Slate)" },
				{ "slug": "secondary-alt", "color": "#435B74", "name": "Secondary Alt (Structural Navy)" },
				{ "slug": "tertiary", "color": "#AB8B63", "name": "Tertiary (Antique Gold)" },
				{ "slug": "tertiary-alt", "color": "#7E6444", "name": "Tertiary Alt (Burnished Ochre)" },
				{ "slug": "primary-subtle", "color": "#CDDBD5", "name": "Primary Subtle (Light Sage)" },
				{ "slug": "primary-subtle-alt", "color": "#A0BAB0", "name": "Primary Subtle Alt (Sage Seam)" },
				{ "slug": "secondary-subtle", "color": "#C8D4DF", "name": "Secondary Subtle (Ice Slate)" },
				{ "slug": "secondary-subtle-alt", "color": "#98AFC3", "name": "Secondary Subtle Alt (Slate Steel)" },
				{ "slug": "tertiary-subtle", "color": "#E1D5C7", "name": "Tertiary Subtle (Light Parchment)" },
				{ "slug": "tertiary-subtle-alt", "color": "#C6B095", "name": "Tertiary Subtle Alt (Parchment)" },
				{ "slug": "base", "color": "#FAF9F6", "name": "Base (Off White)" },
				{ "slug": "contrast", "color": "#1B1B1B", "name": "Contrast (Not Quite Black)" },
				{ "slug": "neutral", "color": "#F7F6F2", "name": "Neutral (Very Light Gray)" },
				{ "slug": "neutral-alt", "color": "#EBEAE5", "name": "Neutral Alt (Light Gray)" },
				{ "slug": "foreground-alt", "color": "#FDFDFB", "name": "Foreground Alt (Bone White)" },
				{ "slug": "highlight", "color": "#A3D9C1", "name": "Highlight (Luminous Sage for Dark BG)"},
				{ "slug": "highlight-alt", "color": "#287456", "name": "Highlight Alt (Rich Jade for Light BG)"},
				{ "slug": "dark", "color": "#517064", "name": "Dark (Forest Sage)" },
				{ "slug": "dark-alt", "color": "#32443B", "name": "Dark Alt (Deep Forest Balanced)" },
				{ "slug": "very-dark", "color": "#3A495A", "name": "Very Dark (Midnight Slate)" },
				{ "slug": "very-dark-alt", "color": "#303C4A", "name": "Very Dark Alt (Deep Midnight)" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "off-white", "color": "#FAF9F6", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "#EBEAE5", "name": "Very Light Gray (Ash Mist)" },
				{ "slug": "light-gray", "color": "#E2DFD7", "name": "Light Gray (Silt)" },
				{ "slug": "gray", "color": "#B0AFA9", "name": "Gray (Pebble)" },
				{ "slug": "dark-gray", "color": "#706F6A", "name": "Dark Gray (Stone)" },
				{ "slug": "very-dark-gray", "color": "#3D3D3A", "name": "Very Dark Gray (Muted Obsidian)" },
				{ "slug": "almost-black", "color": "#2D2D2D", "name": "Almost Black (Carbon)" },
				{ "slug": "not-quite-black", "color": "#1B1B1B", "name": "Not Quite Black (Rich Carbon)" },
				{ "slug": "black", "color": "#000000", "name": "Black (True Black)" },
				{ "slug": "very-light-green", "color": "#CDDBD5", "name": "Very Light Green (Moss Subtle 83%)" },
				{ "slug": "light-green", "color": "#A0BAB0", "name": "Light Green (Moss Subtle Alt 68%)" },
				{ "slug": "green", "color": "#749A8B", "name": "Green (Moss Primary 53%)" },
				{ "slug": "dark-green", "color": "#517064", "name": "Dark Green (Moss Alt Anchor 38%)" },
				{ "slug": "very-light-yellow", "color": "#E1D5C7", "name": "Very Light Yellow (Ochre Subtle 83%)" },
				{ "slug": "light-yellow", "color": "#C6B095", "name": "Light Yellow (Ochre Subtle Alt 68%)" },
				{ "slug": "yellow", "color": "#AB8B63", "name": "Yellow (Ochre Primary 53%)" },
				{ "slug": "dark-yellow", "color": "#7E6444", "name": "Dark Yellow (Ochre Alt Anchor 38%)" },
				{ "slug": "very-light-orange", "color": "#E1CCC6", "name": "Very Light Orange (Flame Subtle 83%)" },
				{ "slug": "light-orange", "color": "#C79E94", "name": "Light Orange (Flame Subtle Alt 68%)" },
				{ "slug": "orange", "color": "#AC7162", "name": "Orange (Flame Primary 53%)" },
				{ "slug": "dark-orange", "color": "#7F4F43", "name": "Dark Orange (Flame Alt Anchor 38%)" },
				{ "slug": "very-light-blue", "color": "#C8D4DF", "name": "Very Light Blue (Ocean Subtle 83%)" },
				{ "slug": "light-blue", "color": "#98AFC3", "name": "Light Blue (Ocean Subtle Alt 68%)" },
				{ "slug": "blue", "color": "#6885A6", "name": "Blue (Ocean Primary 53%)" },
				{ "slug": "dark-blue", "color": "#435B74", "name": "Dark Blue (Ocean Alt Anchor 38%)" },
				{ "slug": "midnight-blue", "color": "#3A495A", "name": "Midnight Blue (Atmos Balanced 29%)" },
				{ "slug": "dark-midnight-blue", "color": "#303C4A", "name": "Dark Midnight Blue (Atmos Balanced 24%)" },
				{ "slug": "very-light-purple", "color": "#D6D1D5", "name": "Very Light Purple (Velvet Subtle 83%)" },
				{ "slug": "light-purple", "color": "#B2A9AF", "name": "Light Purple (Velvet Subtle Alt 68%)" },
				{ "slug": "purple", "color": "#8E808A", "name": "Purple (Velvet Primary 53%)" },
				{ "slug": "dark-purple", "color": "#675B63", "name": "Dark Purple (Velvet Alt Anchor 38%)" },
				{ "slug": "very-light-red", "color": "#DBCDCD", "name": "Very Light Red (Ember Subtle 83%)" },
				{ "slug": "light-red", "color": "#BAA0A0", "name": "Light Red (Ember Subtle Alt 68%)" },
				{ "slug": "red", "color": "#9A7474", "name": "Red (Ember Primary 53%)" },
				{ "slug": "dark-red", "color": "#705151", "name": "Dark Red (Ember Alt Anchor 38%)" }
			],
			"duotone": [
				{ "colors": ["#0F1613", "#FAF9F6"], "slug": "primary", "name": "Primary (Obsidian Pine)" },
				{ "colors": ["#16221E", "#EAEFEA"], "slug": "primary-alt", "name": "Primary Alt (Muted Sage)" },
				{ "colors": ["#0E1318", "#FAF9F6"], "slug": "secondary", "name": "Secondary (Deep Ink)" },
				{ "colors": ["#171F26", "#E6EEF4"], "slug": "secondary-alt", "name": "Secondary Alt (Steel Slate)" },
				{ "colors": ["#14110E", "#FAF9F6"], "slug": "tertiary", "name": "Tertiary (Dark Espresso)" },
				{ "colors": ["#1F1A15", "#F5EFEB"], "slug": "tertiary-alt", "name": "Tertiary Alt (Warm Sand)" },
				{ "colors": ["#0A0C10", "#94A3B8"], "slug": "midnight", "name": "Midnight (SaaS Dark Mode)" },
				{ "colors": ["#000000", "#FFFFFF"], "slug": "grayscale", "name": "Grayscale (Pure Crisp)" },
				{ "colors": ["#111111", "#A1A1AA"], "slug": "dark-grayscale", "name": "Dark Grayscale (Muted Carbon)" }
			],
			"gradients": [
				{ "slug": "primary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary), var(--wp--preset--color--primary-alt))", "name": "Primary" },
				{ "slug": "secondary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--secondary), var(--wp--preset--color--secondary-alt))", "name": "Secondary" },
				{ "slug": "tertiary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--tertiary-alt))", "name": "Tertiary" },
				{ "slug": "green", "gradient": "linear-gradient(160deg, var(--wp--preset--color--green), var(--wp--preset--color--dark-green))", "name": "Green" },
				{ "slug": "yellow", "gradient": "linear-gradient(160deg, var(--wp--preset--color--yellow), var(--wp--preset--color--dark-yellow))", "name": "Yellow" },
				{ "slug": "blue", "gradient": "linear-gradient(160deg, var(--wp--preset--color--blue), var(--wp--preset--color--dark-blue))", "name": "Blue" },
				{ "slug": "orange", "gradient": "linear-gradient(160deg, var(--wp--preset--color--orange), var(--wp--preset--color--dark-orange))", "name": "Orange" },
				{ "slug": "purple", "gradient": "linear-gradient(160deg, var(--wp--preset--color--purple), var(--wp--preset--color--dark-purple))", "name": "Purple" },
				{ "slug": "red", "gradient": "linear-gradient(160deg, var(--wp--preset--color--red), var(--wp--preset--color--dark-red))", "name": "Red" },
				{ "slug": "midnight", "gradient": "linear-gradient(160deg, var(--wp--preset--color--dark-midnight-blue), var(--wp--preset--color--blue))", "name": "Midnight" },
				{ "slug": "gray", "gradient": "linear-gradient(160deg, var(--wp--preset--color--gray), var(--wp--preset--color--dark-gray))", "name": "Gray" },
				{ "slug": "dark-gray", "gradient": "linear-gradient(160deg, var(--wp--preset--color--dark-gray), var(--wp--preset--color--very-dark-gray))", "name": "Dark Gray" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Natural", "slug": "natural", "shadow": "var(--wp--custom--shadow--natural)" },
				{ "name": "Deep", "slug": "deep", "shadow": "var(--wp--custom--shadow--deep)" },
				{ "name": "Sharp", "slug": "sharp", "shadow": "var(--wp--custom--shadow--sharp)" },
				{ "name": "Crisp", "slug": "crisp", "shadow": "var(--wp--custom--shadow--crisp)" },
				{ "name": "Outline", "slug": "outline", "shadow": "var(--wp--custom--shadow--outline)" }
			]
		},
		"border": {
			"customRadius": true,
			"radiusSizes": [			
				{ "name": "Extra Small", "slug": "xs", "size": "3px" },
				{ "name": "Small", "slug": "sm", "size": "6px" },
				{ "name": "Medium", "slug": "md", "size": "9px" },
				{ "name": "Large", "slug": "lg", "size": "12px" },
				{ "name": "Extra Large", "slug": "xl", "size": "18px" },
				{ "name": "2X-Large", "slug": "2-xl", "size": "24px" },
				{ "name": "3X-Large", "slug": "3-xl", "size": "30px" }
			]			
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|50",
				"bottom": "0",
				"left": "var:preset|spacing|50"
			}
		},	
		"typography": {
			"fontSize": "var:preset|font-size|normal",		
			"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
			"lineHeight": "1.6"
		},
		"color": {
			"background": "var:preset|color|base",
			"text": "#1B1B1B /*var:preset|color|contrast*/"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				},
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)"
				}
			},
			"h6": { 
				"typography": { 
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"textTransform": "uppercase"					
				} 
			},
			"link": {
				"color": { 
					"text": "var:preset|color|highlight-alt" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight-alt" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight-alt" 
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--custom--color--button--background)",
					"text": "var:preset|color|foreground-alt"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|30"
					}
				},
				"border": {
					"radius": "var(--wp--custom--button--radius)"
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "var(--wp--custom--typography--font-weight--medium)"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|primary-alt"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|primary-alt"
					}
				}						
			} 
		},			
		"blocks": {
			"core/button" : {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var:preset|border-radius|md"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var:preset|border-radius|md"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|highlight-alt"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|highlight-alt"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|highlight-alt"
							}
						}
					}
				}	
			},
			"core/site-logo": {
				"border": {
					"radius": "var(--wp--custom--border--radius)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"letterSpacing": "-0.01em"
				}
			},
			"core/query-title": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"letterSpacing": "-0.01em"
				}
			},
			"core/post-featured-image": {
				"border": {
					"style": "none",
					"color": "none",
					"width": 0,
					"radius": "var:preset|border-radius|sm"
				},
				"shadow": "none"
			},
			"core/gallery": {
				"spacing": {
					"blockGap": "var:preset|spacing|30"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|normal"
				},
				"spacing": {
                    "blockGap": "var:preset|spacing|30"
                }				
			},
			"core/search": {
				"elements": {
					"button": {
						"border": {
							"radius": "var(--wp--custom--button--radius)"
						}
					}
				}
    		},
			"core/separator": {
                "color": {
                    "background": "var(--wp--custom--color--border)"
                },
                "spacing": {
                	"margin": {
                		"left": 0,
                		"right": 0
                	}
                }
            },
			"core/query-pagination": {
				"shadow": "none"
			},
			"core/accordion": {
				"elements": {
					"button": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header-home",
			"title": "Home Page Header",
			"description": "Header for the Home page",
			"area": "header"
		},
		{
			"name": "featured-image",
			"title": "Featured Image",
			"description": "Featured image",
			"area": "content"
		},
		{
			"name": "featured-image-slim",
			"title": "Slim Featured Image",
			"description": "Slim 16:4.5 ratio featured image",
			"area": "content"
		},
		{
			"name": "author-bio",
			"title": "Author Bio",
			"description": "Author avatar, name, and bio",
			"area": "content"
		},
		{
			"name": "footer-light",
			"title": "Footer Light",
			"description": "Light footer",
			"area": "footer"
		}
	]
}