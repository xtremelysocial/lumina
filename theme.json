					"color": { 
						"text": "var:preset|color|highlight-alt" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight-alt" 
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--custom--color--button--background)",
 					"text": "var(--wp--custom--color--button--text)"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|30"
					}
				},
				"border": {
					"radius": "var(--wp--custom--button--radius)"
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "var(--wp--custom--typography--font-weight--medium)"
				}						
			}
		},			
		"blocks": {
			"core/button" : {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var:preset|border-radius|md"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var:preset|border-radius|md"
						}
					}
				}
			},
			"core/icon": {
                "dimensions": {
                    "width": "42px"
                }
            },
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|highlight-alt"
						}
					},
					":hover": {
						"color": {
							"text": "var:preset|color|highlight-alt"
						}
					},
					":active": {
						"color": {
							"text": "var:preset|color|highlight-alt"
						}
					}
				}	
			},
			"core/site-logo": {
				"border": {
					"radius": "var:preset|border-radius|lg"
				}
			},
			"core/post-featured-image": {
				"border": {
					"style": "none",
					"color": "none",
					"width": 0,
					"radius": "var:preset|border-radius|sm"
				},
				"shadow": "none"
			},
			"core/gallery": {
				"spacing": {
					"blockGap": "var:preset|spacing|30"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|normal"
				},
				"spacing": {
                    "blockGap": ".75em"
                }
			},
			"core/search": {
				"elements": {
					"button": {
						"border": {
							"radius": "var(--wp--custom--button--radius)"
						}
					}
				}
    		},
			"core/quote": {
				"border": {
					"left": {
						"style": "solid",
						"color": "var:preset|color|primary",
						"width": "6px"
					}
				}
			},
			"core/pullquote": {
				"border": {
					"bottom": {
						"width": "2px",
						"style": "solid",
						"color": "var:preset|color|primary"
					},
					"left": {
						"style": "none"
					},
					"right": {
						"style": "none"
					},
					"top": {
						"width": "2px",
						"style": "solid",
						"color": "var:preset|color|primary"
					}
				}
			},
			"core/separator": {
                "color": {
                    "background": "var:preset|color|tertiary"
                },
                "spacing": {
                	"margin": {
                		"left": 0,
                		"right": 0
                	}
                },
                "variations": {
					"thick": {
						"color": {
							"background": "var:preset|color|tertiary"
						}
					},
					"thick-wide": {
						"color": {
							"background": "var:preset|color|tertiary"
						}
					}					
				}
            },
			"core/query-pagination": {
				"shadow": "none"
			},
			"core/accordion": {
				"elements": {
					"button": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			},
			"core/tag-cloud": {
				"variations": {
					"outline": {
						"elements": {
							"link": {
								"border": {
									"width": "2px",
									"color": "var:preset|color|neutral-alt",
									"radius": "var(--wp--custom--button--radius)"
								},
								"shadow": "none"
							}
						}
					}
				}
			},
			"core/comments-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            }
		}
