				{ "name": "Small", "slug": "sm", "size": "calc(0.5 * var(--wp--custom--border--radius))" },
				{ "name": "Medium", "slug": "md", "size": "calc(0.75 * var(--wp--custom--border--radius))" },
				{ "name": "Large", "slug": "lg", "size": "var(--wp--custom--border--radius)" },
				{ "name": "Extra Large", "slug": "xl", "size": "calc(1.25 * var(--wp--custom--border--radius))" },
				{ "name": "2X-Large", "slug": "2-xl", "size": "calc(1.5 * var(--wp--custom--border--radius))" },
				{ "name": "3X-Large", "slug": "3-xl", "size": "calc(2 * var(--wp--custom--border--radius))" }
