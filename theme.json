		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Natural", "slug": "natural", "shadow": "var(--wp--custom--color--shadow--natural)" },
				{ "name": "Deep", "slug": "deep", "shadow": "var(--wp--custom--color--shadow--deep)" },
				{ "name": "Sharp", "slug": "sharp", "shadow": "var(--wp--custom--color--shadow--sharp)" },
				{ "name": "Crisp", "slug": "crisp", "shadow": "var(--wp--custom--color--shadow--crisp)" },
				{ "name": "Outline", "slug": "outline", "shadow": "var(--wp--custom--color--shadow--outline)" }
			]
		},
		"border": {
			"customRadius": false,
			"radiusSizes": [			
				{ "name": "Extra Small", "slug": "xs", "size": "calc(0.25 * var(--wp--custom--border--radius))" },
				{ "name": "Small", "slug": "sm", "size": "calc(0.5 * var(--wp--custom--border--radius))" },
				{ "name": "Medium", "slug": "md", "size": "calc(0.75 * var(--wp--custom--border--radius))" },
				{ "name": "Large", "slug": "lg", "size": "var(--wp--custom--border--radius)" },
				{ "name": "Extra Large", "slug": "xl", "size": "calc(1.25 * var(--wp--custom--border--radius))" },
				{ "name": "2X-Large", "slug": "2-xl", "size": "calc(1.5 * var(--wp--custom--border--radius))" },
				{ "name": "3X-Large", "slug": "3-xl", "size": "calc(2 * var(--wp--custom--border--radius))" }
			]
		},
		"lightbox": {
			"allowEditing": true,
			"enabled": false
		}
	},
	"styles": {
		"spacing": {
			"blockGap": 	"var:preset|spacing|40",
			"padding": {
				"top": 		"0",
				"right": 	"var:preset|spacing|50",
				"bottom": 	"0",
				"left": 	"var:preset|spacing|50"
			}
		},	
		"typography": {
			"fontSize": 	"var:preset|font-size|normal",		
			"fontWeight": 	"var(--wp--custom--typography--font-weight--normal)",
			"lineHeight": 	"1.6"
		},
		"color": {
			"background": 	"var:preset|color|base",
			"text": 		"var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				},
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)"
				}
			},
			"h6": { 
				"typography": { 
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"textTransform": "uppercase"					
				} 
			},
			"link": {
				"color": { 
					"text": "var:preset|color|highlight-alt" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight-alt" 
					} 
				},
