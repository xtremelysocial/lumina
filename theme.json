		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Natural", "slug": "natural", "shadow": "var(--wp--custom--color--shadow--natural)" },
				{ "name": "Deep", "slug": "deep", "shadow": "var(--wp--custom--color--shadow--deep)" },
				{ "name": "Sharp", "slug": "sharp", "shadow": "var(--wp--custom--color--shadow--sharp)" },
				{ "name": "Crisp", "slug": "crisp", "shadow": "var(--wp--custom--color--shadow--crisp)" },
				{ "name": "Outline", "slug": "outline", "shadow": "var(--wp--custom--color--shadow--outline)" }
			]
		},
