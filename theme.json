{	
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina",
	"description": "A refined modern theme inspired by the colors, ambient light and natural depth of the environment around us, featuring subtle animation on actionable elements",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": 	"is-light-theme",
					"scheme": 	"lumina",
					"imageFolders": [
						"lumina"
					],
					"imageDefault": "/assets/images/samples/image-lumina-featured.webp"
				},
				"opacity": {
					"faint": 	"color-mix(in srgb, currentColor 5%, transparent)",
					"subtle": 	"color-mix(in srgb, currentColor 15%, transparent)",
					"emphasis": "color-mix(in srgb, currentColor 35%, transparent)",
					"muted": 	"color-mix(in srgb, currentColor 60%, transparent)"
				},
				"border": 		"color-mix(in srgb, currentColor 15%, transparent)",
				"field": { 
					"outline": 	"color-mix(in srgb, currentColor 20%, transparent)" 
				},
				"button": {
					"background": 	"var(--wp--preset--color--primary)",
					"text": 		"var(--wp--preset--color--foreground-alt)",
					"hover": 		"var(--wp--preset--color--primary-alt)",
					"hoverOpacity": "0.8" 
				},
				"link": {
					"hoverOpacity": "0.6" 
				},
				"heading": {
					"text": 		"var(--wp--preset--color--contrast)",
					"separator": 	"var(--wp--preset--color--tertiary)"
				},
				"shadow": {
					"natural": "1px 4px 8px rgba(42, 50, 61, 0.14), 1px 2px 3px rgba(42, 50, 61, 0.08)",
					"deep":    "2px 8px 16px rgba(42, 50, 61, 0.20), 1px 4px 6px rgba(42, 50, 61, 0.12)",
					"sharp":   "4px 12px 22px rgba(42, 50, 61, 0.24), 2px 8px 10px rgba(42, 50, 61, 0.14)",
					"crisp":   "6px 16px 28px rgba(42, 50, 61, 0.22), 3px 12px 14px rgba(42, 50, 61, 0.12)",
					"outline": "0 0 0 2px var(--wp--preset--color--neutral-alt), 1px 4px 8px rgba(42, 50, 61, 0.14)",
					"default": 	"var:preset|shadow|natural",
					"hover": 	"var:preset|shadow|deep",
					"hoverHigh":"var:preset|shadow|sharp"
				}				
			},
			"link": {
				"style": 			"solid",
				"thickness": 		"1px",
				"position": 		"under",
				"offset": 			"0.05em",
				"decorationColor": 	"currentColor",
				"specialStyle": 	"dotted",
				"decorationSpecialColor": "rgba(27, 27, 27, 0.4)"
			},			
			"border": {
				"radius": 			"16px"
			},
			"button": {
				"radius": 			"9999px"
			},
			"spacing": {
				"gap": 				"24px"
			},
			"sidebar": {
				"width": 			"360px"
			},		
			"animation": {
				"duration": {
					"short": 		"250ms",
					"medium": 		"500ms",
					"normal": 		"800ms"
				},
				"timingFunction": 	"cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": 		"both",
				"default": {
					"hoverSmallTransform": 	"scale(1.03)",
					"hoverTransform": 		"scale(1.05)",
					"hoverLargeTransform": 	"scale(1.08)",
					"objectSmallTransform": "translateY(-3px)",
					"objectTransform": 		"translateY(-4px)"
				}
			},
			"typography": {
				"fontWeight": {
					"light": 		"200",
					"normal": 		"300",
					"medium": 		"400",
					"bold": 		"400"
				}
			}
		},
		"layout": {
			"contentSize": 	"760px",
			"wideSize": 	"1168px",
			"allowCustomContentAndWideSize": false
		},
		"typography": {
			"fontSizes": [
				{
				  "slug": "extra-small",
				  "size": "14px",
				  "name": "Extra Small",
				  "fluid": false
				},
				{
				  "slug": "small",
				  "size": "16px",
				  "name": "Small",
				  "fluid": false
				},
				{
				  "slug": "normal",
				  "size": "18px",
				  "name": "Normal",
				  "fluid": false
				},
				{
				  "slug": "medium",
				  "size": "21px",
				  "name": "Medium (h4)",
				  "fluid": false
				},
				{
				  "slug": "large",
				  "size": "26px",
				  "name": "Large (h3)",
				  "fluid": {
					"min": "22px",
					"max": "26px"
				  }
				},
				{
				  "slug": "x-large",
				  "size": "32px",
				  "name": "Extra Large (h2)",
				  "fluid": {
					"min": "28px",
					"max": "32px"
				  }
				},
				{
				  "slug": "xx-large",
				  "size": "38px",
				  "name": "2X Large (h1)",
				  "fluid": {
					"min": "34px",
					"max": "38px"
				  }
				},
				{
				  "slug": "huge",
				  "size": "48px",
				  "name": "Huge",
				  "fluid": {
					"min": "40px",
					"max": "48px"
				  }
				},
				{
				  "slug": "gigantic",
				  "size": "58px",
				  "name": "Gigantic",
				  "fluid": {
					"min": "46px",
					"max": "58px"
				  }
				}
		  	]
		},	
		"dimensions": {
			"aspectRatios": [
				{
					"name": "Slim - 16:4.5",
					"slug": "slim",
					"ratio": "16/4.5"
				}
			]
		},		
		"blocks": {
			"core/image": {
				"lightbox": {
					"allowEditing": true,
					"enabled": true
				}
			},
			"core/post-featured-image": {
				"lightbox": {
					"allowEditing": true,
					"enabled": true
				}
			},
			"core/gallery": {
				"lightbox": {
					"allowEditing": true,
					"enabled": true
				},
				"spacing": {
					"blockGap": true
				}
			}
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "20",
					"size": "5px",
					"name": "2X-Small"
				},
				{
					"slug": "30",
					"size": "calc(0.65 * var(--wp--custom--spacing--gap))",
					"name": "X-Small"
				},
				{
					"slug": "40",
					"size": "clamp(calc(0.65 * var(--wp--custom--spacing--gap)), 2vw, calc(1 * var(--wp--custom--spacing--gap)))",
					"name": "Small (Block Gap)"
				},
				{
					"slug": "50",
					"size": "clamp(calc(0.85 * var(--wp--custom--spacing--gap)), 2.5vw, calc(1.3 * var(--wp--custom--spacing--gap)))",
					"name": "Medium"
				},
				{
					"slug": "60",
					"size": "clamp(calc(1 * var(--wp--custom--spacing--gap)), 3.5vw, calc(2 * var(--wp--custom--spacing--gap)))",
					"name": "Large"
				},
				{
					"slug": "70",
					"size": "clamp(calc(1.3 * var(--wp--custom--spacing--gap)), 5vw, calc(2.625 * var(--wp--custom--spacing--gap)))",
					"name": "X Large"
				},
				{
					"slug": "80",
					"size": "clamp(calc(1.7 * var(--wp--custom--spacing--gap)), 6.5vw, calc(3.5 * var(--wp--custom--spacing--gap)))",
					"name": "2X Large"
				}
			]
		},
		"color": {
