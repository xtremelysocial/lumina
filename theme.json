{	
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Blocks",
	"description": "A high-end evolution of the flat design aesthetic. Featuring atmospheric depth, tactile hardware inspiration, and kinetic motion.",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"yellow": "var(--wp--preset--color--foreground-alt)",
					"bright-green": "var(--wp--preset--color--almost-black)",
					"light-green": "var(--wp--preset--color--almost-black)",
					"light-orange": "var(--wp--preset--color--almost-black)"
				},
				"border": "var(--wp--preset--color--neutral-alt)",
				"field": { 
					"outline": "rgba(0, 0, 0, 0.25)" 
				},
				"button": { 
					"hoverOpacity": "0.8" 
				},
				"link": { 
					"hoverOpacity": "0.8" 
				}
			},
			"border": {
				"radius": "var(--wp--preset--border-radius--lg, 18px)"
			},
			"button": {
				"radius": "9999px"
			},
			"spacing": {
				"gap": "18px"
			},
			"sidebar": {
				"width": "360px"
			},			
			"animation": {
				"duration": {
					"short": "250ms",
					"medium": "500ms",
					"normal": "800ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.03)",
					"hoverTransform": "scale(1.05)",
					"hoverLargeTransform": "scale(1.08)",
					"objectSmallTransform": "translateY(-2px)",
					"objectTransform": "translateY(-3px)"
				}
			},
			"shadow": {
				"natural": "1px 3px 6px rgba(42, 50, 61, 0.08), 1px 2px 2px rgba(42, 50, 61, 0.06)",
				"deep":    "2px 6px 10px rgba(42, 50, 61, 0.10), 1px 4px 4px rgba(42, 50, 61, 0.08)",
				"sharp":   "4px 10px 18px rgba(42, 50, 61, 0.12), 2px 8px 8px rgba(42, 50, 61, 0.08)",
				"crisp":   "6px 14px 24px rgba(42, 50, 61, 0.11), 3px 12px 12px rgba(42, 50, 61, 0.07)",
				"outline": "0 0 0 2px var(--wp--preset--color--neutral-alt), 1px 3px 6px rgba(42, 50, 61, 0.08)",
				"default": "var(--wp--preset--shadow--natural)",
				"hover": "var(--wp--preset--shadow--deep)",
				"hoverHigh": "var(--wp--preset--shadow--sharp)"
			},
			"typography": {
				"fontWeight": {
					"light": "200",
					"normal": "300",
					"medium": "400",
					"bold": "500"
				}
			},
			"link": {
				"style": "dotted",
				"thickness": "1px",
				"postion": "under",
				"offset": "2px"
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#78A391", "name": "Primary (Green)" },
				{ "slug": "primary-alt", "color": "#4A6E5D", "name": "Primary Alt (Dark Bright Green)" },
				{ "slug": "secondary", "color": "#26323C", "name": "Secondary (Atmos Midnight Navy)" },
				{ "slug": "secondary-alt", "color": "#171E24", "name": "Secondary Alt (Deep Atmos Shadow)" },
				{ "slug": "tertiary", "color": "#B38B59", "name": "Tertiary (Yellow)" },
				{ "slug": "tertiary-alt", "color": "#946E42", "name": "Tertiary Alt (Antique Gold)" },
				{ "slug": "base", "color": "#FAF9F6", "name": "Base (Off White)" },
				{ "slug": "contrast", "color": "#1B1B1B", "name": "Contrast (Not Quite Black)" },
				{ "slug": "neutral", "color": "#F7F6F2", "name": "Neutral (Airy Template Fill)" },
				{ "slug": "neutral-alt", "color": "#EBEAE5", "name": "Neutral Alt (Structural Border)" },
				{ "slug": "foreground-alt", "color": "#FDFDFB", "name": "Foreground Alt (Bone White)" },
				{ "slug": "highlight", "color": "#77B399", "name": "Luminous Sage" },
				{ "slug": "highlight-alt", "color": "#629681", "name": "Deep Sage" },
				{ "slug": "dark", "color": "#2C3831", "name": "Dark (Midnight Sage)" },
				{ "slug": "dark-alt", "color": "#1E2621", "name": "Dark Alt (Deep Forest Shadow)" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White (Pure White)" },
				{ "slug": "off-white", "color": "#FAF9F6", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "#F1EFEA", "name": "Very Light Gray (Ash Mist)" },
				{ "slug": "light-gray", "color": "#E2DFD7", "name": "Light Gray (Silt)" },
				{ "slug": "gray", "color": "#B0AFA9", "name": "Gray (Pebble)" },
				{ "slug": "dark-gray", "color": "#706F6A", "name": "Dark Gray (Stone)" },
				{ "slug": "very-dark-gray", "color": "#3D3D3A", "name": "Very Dark Gray (Muted Obsidian)" },
				{ "slug": "light-green", "color": "#F2F6F4", "name": "Light Green (Alabaster Mint)" },
				{ "slug": "green", "color": "#78A391", "name": "Green (Luminous Sage)" },
				{ "slug": "bright-green", "color": "#8DBA9D", "name": "Bright Green (Spring Sage)" },
				{ "slug": "dark-bright-green", "color": "#4A6E5D", "name": "Dark Bright Green (Deep Sage)" },
				{ "slug": "dark-green", "color": "#2C3831", "name": "Dark Green (Midnight Sage)" },
				{ "slug": "very-dark-green", "color": "#1E2621", "name": "Very Dark Green (Deep Forest Shadow)" },
				{ "slug": "light-yellow", "color": "#F7F5F0", "name": "Light Yellow (Gallery Ivory)" },
				{ "slug": "yellow", "color": "#B38B59", "name": "Yellow (Muted Gold)" },
				{ "slug": "dark-yellow", "color": "#544129", "name": "Dark Yellow (Burnished Bronze)" },
				{ "slug": "light-orange", "color": "#F7F2EF", "name": "Light Orange (Chalk Sand)" },
				{ "slug": "orange", "color": "#A36555", "name": "Orange (Terra Cotta)" },
				{ "slug": "dark-orange", "color": "#7D483B", "name": "Dark Orange (Burnt Sienna)" },
				{ "slug": "light-blue", "color": "#F1F5F7", "name": "Light Blue (Misty Slate White)" },
				{ "slug": "blue", "color": "#536A78", "name": "Blue (Steel)" },
				{ "slug": "dark-blue", "color": "#33414A", "name": "Dark Blue (Deep Steel Slate)" },
				{ "slug": "midnight-blue", "color": "#26323C", "name": "Midnight Blue (Atmos Midnight)" },
				{ "slug": "dark-midnight-blue", "color": "#171E24", "name": "Dark Midnight Blue (Deep Atmos)" },
				{ "slug": "light-purple", "color": "#F4F2F5", "name": "Light Purple (Alabaster Heather)" },
				{ "slug": "purple", "color": "#7D7178", "name": "Purple (Muted Heather)" },
				{ "slug": "dark-purple", "color": "#574E53", "name": "Dark Purple (Deep Heather)" },
				{ "slug": "light-red", "color": "#F7F1F1", "name": "Light Red (Chalk Blush)" },
				{ "slug": "red", "color": "#946B6B", "name": "Red (Muted Clay)" },
				{ "slug": "dark-red", "color": "#6E4C4C", "name": "Dark Red (Deep Clay)" },
				{ "slug": "almost-black", "color": "#2D2D2D", "name": "Almost Black (Carbon)" },
				{ "slug": "not-quite-black", "color": "#1A1A1A", "name": "Not Quite Black (Rich Carbon)" },
				{ "slug": "black", "color": "#000000", "name": "Black (True Black)" }
			],
			"duotone": [
				{ "colors": ["#4A6E5D", "#FAF9F6"], "slug": "primary", "name": "Primary" },
				{ "colors": ["#78A391", "#FAF9F6"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["#26323C", "#FAF9F6"], "slug": "secondary", "name": "Secondary" },
				{ "colors": ["#171E24", "#FAF9F6"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["#B38B59", "#FAF9F6"], "slug": "tertiary", "name": "Tertiary" },
				{ "colors": ["#946E42", "#FAF9F6"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["#7D7178", "#B38B59"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["#171E24", "#946B6B"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["#2D2D2D", "#26323C"], "slug": "midnight", "name": "Midnight" },
				{ "colors": ["#946B6B", "#B38B59"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["#7D7178", "#78A391"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["#26323C", "#A36555"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["#000000", "#FFFFFF"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["#000000", "#706F6A"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			],
			"gradients": [
				{ "slug": "primary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary), var(--wp--preset--color--primary-alt))", "name": "Primary" },
				{ "slug": "secondary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--secondary), var(--wp--preset--color--secondary-alt))", "name": "Secondary" },
				{ "slug": "tertiary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--tertiary-alt))", "name": "Tertiary" },
				{ "slug": "primary-to-secondary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary), var(--wp--preset--color--secondary))", "name": "Primary to Secondary" },
				{ "slug": "secondary-to-primary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--secondary), var(--wp--preset--color--primary))", "name": "Secondary to Primary" },
				{ "slug": "primary-to-tertiary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary), var(--wp--preset--color--tertiary))", "name": "Primary to Tertiary" },
				{ "slug": "tertiary-to-primary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--primary))", "name": "Tertiary to Primary" },
				{ "slug": "secondary-to-tertiary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--secondary), var(--wp--preset--color--tertiary))", "name": "Secondary to Tertiary" },
				{ "slug": "tertiary-to-secondary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--secondary))", "name": "Tertiary to Secondary" },
				{ "slug": "green", "gradient": "linear-gradient(160deg, var(--wp--preset--color--green), var(--wp--preset--color--dark-green))", "name": "Green" },
				{ "slug": "yellow", "gradient": "linear-gradient(160deg, var(--wp--preset--color--yellow), var(--wp--preset--color--dark-yellow))", "name": "Yellow" },
				{ "slug": "blue", "gradient": "linear-gradient(160deg, var(--wp--preset--color--blue), var(--wp--preset--color--dark-blue))", "name": "Blue" },
				{ "slug": "orange", "gradient": "linear-gradient(160deg, var(--wp--preset--color--orange), var(--wp--preset--color--dark-orange))", "name": "Orange" },
				{ "slug": "purple", "gradient": "linear-gradient(160deg, var(--wp--preset--color--purple), var(--wp--preset--color--dark-purple))", "name": "Purple" },
				{ "slug": "red", "gradient": "linear-gradient(160deg, var(--wp--preset--color--red), var(--wp--preset--color--dark-red))", "name": "Red" },
				{ "slug": "purple-yellow", "gradient": "linear-gradient(160deg, var(--wp--preset--color--purple), var(--wp--preset--color--yellow))", "name": "Purple to Yellow" },
				{ "slug": "purple-green", "gradient": "linear-gradient(160deg, var(--wp--preset--color--purple), var(--wp--preset--color--green))", "name": "Purple to Green" },
				{ "slug": "blue-red", "gradient": "linear-gradient(160deg, var(--wp--preset--color--blue), var(--wp--preset--color--dark-red))", "name": "Blue to Red" },
				{ "slug": "blue-orange", "gradient": "linear-gradient(160deg, var(--wp--preset--color--blue), var(--wp--preset--color--orange))", "name": "Blue to Orange" },
				{ "slug": "midnight", "gradient": "linear-gradient(160deg, var(--wp--preset--color--dark-midnight-blue), var(--wp--preset--color--blue))", "name": "Midnight" },
				{ "slug": "gray", "gradient": "linear-gradient(160deg, var(--wp--preset--color--gray), var(--wp--preset--color--dark-gray))", "name": "Gray" },
				{ "slug": "dark-gray", "gradient": "linear-gradient(160deg, var(--wp--preset--color--dark-gray), var(--wp--preset--color--very-dark-gray))", "name": "Dark Gray" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Natural", "slug": "natural", "shadow": "var(--wp--custom--shadow--natural)" },
				{ "name": "Deep", "slug": "deep", "shadow": "var(--wp--custom--shadow--deep)" },
				{ "name": "Sharp", "slug": "sharp", "shadow": "var(--wp--custom--shadow--sharp)" },
				{ "name": "Crisp", "slug": "crisp", "shadow": "var(--wp--custom--shadow--crisp)" },
				{ "name": "Outline", "slug": "outline", "shadow": "var(--wp--custom--shadow--outline)" }
			]
		},
		"border": {
			"customRadius": true,
			"radiusSizes": [
				{ "name": "Extra Small", "slug": "xs", "size": "4.5px" },
				{ "name": "Small", "slug": "sm", "size": "9px" },
				{ "name": "Medium", "slug": "md", "size": "13.5px" },
				{ "name": "Large", "slug": "lg", "size": "18px" },
				{ "name": "Extra Large", "slug": "xl", "size": "22.5px" },
				{ "name": "2X-Large", "slug": "2-xl", "size": "27px" },
				{ "name": "3X-Large", "slug": "3-xl", "size": "36px" }
			]
		}
	},
	"styles": {
		"border": {
			"radius": "var(--wp--custom--border--radius)"
		},	
		"typography": {
			"fontSize": "var:preset|font-size|normal",		
			"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
			"lineHeight": "1.6"
		},
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
                    "text": "var(--wp--preset--color--secondary)"
                },
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"letterSpacing": "0.01em",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)",
					"letterSpacing": "-0.01em"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)",
					"letterSpacing": "-0.01em"
				}
			},
			"h6": { 
				"typography": { 
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"textTransform": "uppercase"					
				} 
			},
			"link": {
				"color": { "text": "var:preset|color|highlight-alt" },
				"typography": {
					"textDecoration": "none"
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight" 
					}
				}				
			},
			"button": {
				"color": {
					"background": "var:preset|color|highlight",
					"text": "var:preset|color|foreground-alt"
				},
				"border": {
					"radius": "var(--wp--custom--button--radius)"
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "var(--wp--custom--typography--font-weight--medium)"
				}		
			} 
		},			
		"blocks": {
			"core/button" : {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--xs, 4.5px)"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--xs, 4.5px)"
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)"
				}
			},
			"core/site-logo": {
				"border": {
					"radius": "var(--wp--custom--border--radius)"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"letterSpacing": "-0.01em"
				}
			},
			"core/query-title": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"letterSpacing": "-0.01em"
				}
			},
			"core/post-date": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			},
			"core/post-terms": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			},
			"core/post-time-to-read": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			},
			"core/post-comments-link": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			},
			"core/post-author-name": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|normal"
				}
			},
			"core/search": {
				"elements": {
					"button": {
						"border": {
							"radius": "var(--wp--custom--button--radius)"
						}
					}
				}
    		},
			"core/separator": {
                "color": {
                    "background": "var(--wp--custom--color--border)"
                },
                "spacing": {
                	"margin": {
                		"left": 0,
                		"right": 0
                	}
                }
            },
			"core/query-pagination": {
				"shadow": "none"
			},
			"core/accordion": {
				"elements": {
					"button": {
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header-home",
			"title": "Home Page Header",
			"description": "Header for the Home page",
			"area": "header"
		},
		{
			"name": "author-bio",
			"title": "Author Bio",
			"description": "Author avatar, name, and bio",
			"area": "content"
		}		
	]
}