{	
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina",
	"description": "A refined modern theme inspired by the colors, ambient light and natural depth of the environment around us, featuring subtle animation on actionable elements",
	"settings": {
		"custom": {
			"color": {
				"bodyClasses": "is-light-theme",
				"contrast": {
					"yellow": "var(--wp--preset--color--foreground-alt)",
					"lightGreen": "var(--wp--preset--color--contrast)",
					"lightOrange": "var(--wp--preset--color--contrast)",
					"lightBlue": "var(--wp--preset--color--contrast)",
					"lightPurple": "var(--wp--preset--color--contrast)",
					"lightRed": "var(--wp--preset--color--contrast)"
				},
				"border": "var(--wp--preset--color--neutral-alt)",				
				"field": { 
					"outline": "rgba(0, 0, 0, 0.25)" 
				},
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--foreground-alt)",
					"hover": "var(--wp--preset--color--primary-alt)",
					"hoverOpacity": "0.8" 
				},
				"link": {
					"hoverOpacity": "0.6" 
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--tertiary)"
				}				
			},
			"link": {
				"style": "solid",
				"thickness": "1px",
				"position": "under",
				"offset": "0.05em",
				"decorationColor": "currentColor",
				"specialStyle": "dotted",
				"decorationSpecialColor": "rgba(27, 27, 27, 0.4)"
			},			
			"border": {
				"radius": "18px"
			},
			"button": {
				"radius": "9999px"
			},
			"spacing": {
				"gap": "24px"
			},
			"sidebar": {
				"width": "360px"
			},		
			"animation": {
				"duration": {
					"short": "250ms",
					"medium": "500ms",
					"normal": "800ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.03)",
					"hoverTransform": "scale(1.05)",
					"hoverLargeTransform": "scale(1.08)",
					"objectSmallTransform": "translateY(-3px)",
					"objectTransform": "translateY(-4px)"
				}
			},
			"typography": {
				"fontWeight": {
					"light": "200",
					"normal": "300",
					"medium": "400",
					"bold": "400"
				}
			},			
			"shadow": {
				"natural": "1px 3px 6px rgba(42, 50, 61, 0.08), 1px 2px 2px rgba(42, 50, 61, 0.06)",
				"deep":    "2px 6px 10px rgba(42, 50, 61, 0.10), 1px 4px 4px rgba(42, 50, 61, 0.08)",
				"sharp":   "4px 10px 18px rgba(42, 50, 61, 0.12), 2px 8px 8px rgba(42, 50, 61, 0.08)",
				"crisp":   "6px 14px 24px rgba(42, 50, 61, 0.11), 3px 12px 12px rgba(42, 50, 61, 0.07)",
				"outline": "0 0 0 2px var(--wp--preset--color--neutral-alt), 1px 3px 6px rgba(42, 50, 61, 0.08)",
				"default": "var:preset|shadow|natural",
				"hover": "var:preset|shadow|deep",
				"hoverHigh": "var:preset|shadow|sharp"
			}
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1100px",
			"allowCustomContentAndWideSize": false
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "extra-small",
					"size": "14px",
					"name": "Extra Small",
					"fluid": false
				},
				{
					"slug": "small",
					"size": "16px",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "normal",
					"size": "18px",
					"name": "Normal",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "23px",
					"name": "Medium (h4)",
					"fluid": {
						"min": "21px",
						"max": "23px"
					}
				},
				{
					"slug": "large",
					"size": "28px",
					"name": "Large (h3)",
					"fluid": {
						"min": "25px",
						"max": "28px"
					}
				},
				{
					"slug": "x-large",
					"size": "36px",
					"name": "Extra Large (h2)",
					"fluid": {
						"min": "32px",
						"max": "36px"
					}
				},
				{
					"slug": "xx-large",
					"size": "48px",
					"name": "2X Large (h1)",
					"fluid": {
						"min": "40px",
						"max": "48px"
					}
				},
				{
					"slug": "huge",
					"size": "56px",
					"name": "Huge",
					"fluid": {
						"min": "46px",
						"max": "56px"
					}
				},
				{
					"slug": "gigantic",
					"size": "68px",
					"name": "Gigantic",
					"fluid": {
						"min": "54px",
						"max": "68px"
					}
				}
			]
		},	
		"dimensions": {
			"aspectRatios": [
				{
					"name": "Slim - 16:4.5",
					"slug": "slim",
					"ratio": "16/4.5"
				}
			]
		},		
		"blocks": {
			"core/image": {
				"lightbox": {
					"allowEditing": true,
					"enabled": false
				}
			},
			"core/gallery": {
				"lightbox": {
					"allowEditing": true,
					"enabled": true
				},
				"spacing": {
					"blockGap": true
				}
			}
		},			
		"spacing": {
			"spacingSizes": [
				{
					"slug": "20",
					"size": "calc(0.25 * var(--wp--custom--spacing--gap))",
					"name": "2X-Small"
				},
				{
					"slug": "30",
					"size": "calc(0.5 * var(--wp--custom--spacing--gap))",
					"name": "X-Small"
				},
				{
					"slug": "40",
					"size": "clamp(calc(0.5 * var(--wp--custom--spacing--gap)), 4vw, calc(1 * var(--wp--custom--spacing--gap)))",
					"name": "Small (Block Gap)"
				},
				{
					"slug": "50",
					"size": "clamp(calc(0.65 * var(--wp--custom--spacing--gap)), 5vw, calc(1.3 * var(--wp--custom--spacing--gap)))",
					"name": "Medium"
				},
				{
					"slug": "60",
					"size": "clamp(calc(0.85 * var(--wp--custom--spacing--gap)), 6vw, calc(1.75 * var(--wp--custom--spacing--gap)))",
					"name": "Large"
				},
				{
					"slug": "70",
					"size": "calc(1.5 * var(--wp--preset--spacing--60))",
					"name": "X Large"
				},
				{
					"slug": "80",
					"size": "calc(2 * var(--wp--preset--spacing--60))",
					"name": "2X Large"
				}
			]
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(154, 24%, 48%)", "name": "Primary (Crisp Sage 48%)" },
				{ "slug": "secondary", "color": "hsl(206, 24%, 44%)", "name": "Secondary (Ocean Blue 44%)" },
				{ "slug": "tertiary", "color": "hsl(34, 32%, 48%)", "name": "Tertiary (Antique Gold 48%)" },

				{ "slug": "primary-alt", "color": "hsl(154, 26%, 38%)", "name": "Primary Alt (Deep Alpine Sage 38%)" },
				{ "slug": "secondary-alt", "color": "hsl(206, 26%, 34%)", "name": "Secondary Alt (Storm Navy 34%)" },
				{ "slug": "tertiary-alt", "color": "hsl(34, 34%, 38%)", "name": "Tertiary Alt (Burnished Ochre 38%)" },

				{ "slug": "primary-subtle", "color": "hsl(154, 20%, 91%)", "name": "Primary Subtle (Whisper Sage Fill 91%)" },
				{ "slug": "secondary-subtle", "color": "hsl(206, 24%, 91%)", "name": "Secondary Subtle (Whisper Sky Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(34, 22%, 91%)", "name": "Tertiary Subtle (Whisper Parchment Fill 91%)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(154, 16%, 83%)", "name": "Primary Subtle Alt (Sage Border Seam 83%)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(206, 18%, 83%)", "name": "Secondary Subtle Alt (Sky Border Seam 83%)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(34, 16%, 83%)", "name": "Tertiary Subtle Alt (Parchment Border Seam 83%)" },

				{ "slug": "neutral", "color": "hsl(32, 16%, 96%)", "name": "Neutral (Crisp Sand Well 96%)" },
				{ "slug": "neutral-alt", "color": "hsl(32, 12%, 88%)", "name": "Neutral Alt (Sand Border Seam 88%)" },
				
				{ "slug": "base", "color": "hsl(32, 20%, 97%)", "name": "Base (Almond White)" },
				{ "slug": "contrast", "color": "hsl(214, 12%, 11%)", "name": "Contrast (Midnight Indigo Typographic Ink)" },
				{ "slug": "foreground-alt", "color": "hsl(32, 20%, 98%)", "name": "Foreground Alt (Light Almond White)" },
				
				{ "slug": "very-light-gray", "color": "hsl(32, 14%, 91%)", "name": "Very Light Gray (Warm Sand Footer Floor 91%)" },
				{ "slug": "light-gray", "color": "hsl(32, 10%, 83%)", "name": "Light Gray (Warm Sand Inner Well 83%)" },
				{ "slug": "gray", "color": "hsl(32, 6%, 71%)", "name": "Gray (Warm Structural Border 71%)" },
				{ "slug": "dark-gray", "color": "hsl(32, 4%, 44%)", "name": "Dark Gray (Muted Espresso Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(32, 2%, 25%)", "name": "Very Dark Gray (Smoky Sand Shadow 25%)" },
								
				{ "slug": "primary-dark", "color": "hsl(170, 45%, 20%)", "name": "Primary Dark (Deep Forest Sage)"},
				{ "slug": "dark", "color": "hsl(208, 21%, 22%)", "name": "Dark (Lumina Midnight Balanced 22%)" },
				{ "slug": "tertiary-dark", "color": "hsl(34, 34%, 22%)", "name": "Dark Tertiary (Antique Gold Deep 22%)" },

				{ "slug": "primary-dark-alt", "color": "hsl(170, 50%, 15%)", "name": "Primary Dark Alt (Rich Hero Green)"},
				{ "slug": "dark-alt", "color": "hsl(209, 24%, 16%)", "name": "Dark Alt (Lumina Midnight Balanced 16%)" },				
				{ "slug": "tertiary-dark-alt", "color": "hsl(34, 34%, 14%)", "name": "Dark Tertiary Alt (Antique Gold Abyssal 14%)" },

				{ "slug": "highlight", "color": "hsl(154, 65%, 68%)", "name": "Highlight (Electric Sage for Dark BG)" },
				{ "slug": "highlight-alt", "color": "hsl(154, 75%, 28%)", "name": "Highlight Alt (Vivid Pine Link Ink)" },

				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(32, 20%, 97%)", "name": "Off White (Desert Alabaster)" },
				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black (Pure Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black (Rich Carbon Body Copy)" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black (True Black)" },
				
				{ "slug": "very-light-green", "color": "hsl(154, 20%, 91%)", "name": "Very Light Green (Moss Subtle 91%)" },
				{ "slug": "light-green", "color": "hsl(154, 16%, 83%)", "name": "Light Green (Moss Subtle Alt 83%)" },
				{ "slug": "green", "color": "hsl(154, 24%, 48%)", "name": "Green (Moss Primary 48%)" },
				{ "slug": "dark-green", "color": "hsl(154, 26%, 38%)", "name": "Dark Green (Moss Alt Anchor 38%)" },
				
				{ "slug": "very-light-yellow", "color": "hsl(34, 22%, 91%)", "name": "Very Light Yellow (Ochre Subtle 91%)" },
				{ "slug": "light-yellow", "color": "hsl(34, 16%, 83%)", "name": "Light Yellow (Ochre Subtle Alt 83%)" },
				{ "slug": "yellow", "color": "hsl(34, 32%, 48%)", "name": "Yellow (Ochre Primary 48%)" },
				{ "slug": "dark-yellow", "color": "hsl(34, 34%, 38%)", "name": "Dark Yellow (Ochre Alt Anchor 38%)" },

				{ "slug": "very-light-orange", "color": "hsl(22, 26%, 91%)", "name": "Very Light Orange (Flame Subtle 91%)" },
				{ "slug": "light-orange", "color": "hsl(22, 22%, 83%)", "name": "Light Orange (Flame Subtle Alt 83%)" },
				{ "slug": "orange", "color": "hsl(12, 32%, 48%)", "name": "Orange (Flame Primary 48%)" },
				{ "slug": "dark-orange", "color": "hsl(12, 32%, 38%)", "name": "Dark Orange (Flame Alt Anchor 38%)" },
				
				{ "slug": "very-light-blue", "color": "hsl(206, 24%, 91%)", "name": "Very Light Blue (Ocean Subtle 91%)" },
				{ "slug": "light-blue", "color": "hsl(206, 18%, 83%)", "name": "Light Blue (Ocean Subtle Alt 83%)" },
				{ "slug": "blue", "color": "hsl(206, 24%, 44%)", "name": "Blue (Ocean Primary 44%)" },
				{ "slug": "dark-blue", "color": "hsl(206, 26%, 34%)", "name": "Dark Blue (Ocean Alt Anchor 34%)" },
				{ "slug": "midnight-blue", "color": "hsl(208, 21%, 22%)", "name": "Midnight Blue (Lumina Balanced 22%)" },
				{ "slug": "dark-midnight-blue", "color": "hsl(209, 24%, 16%)", "name": "Dark Midnight Blue (Lumina Balanced 16%)" },
				
				{ "slug": "very-light-purple", "color": "hsl(320, 16%, 91%)", "name": "Very Light Purple (Velvet Subtle 91%)" },
				{ "slug": "light-purple", "color": "hsl(320, 12%, 83%)", "name": "Light Purple (Velvet Subtle Alt 83%)" },
				{ "slug": "purple", "color": "hsl(327, 8%, 32%)", "name": "Purple (Velvet Primary 32%)" },
				{ "slug": "dark-purple", "color": "hsl(327, 8%, 22%)", "name": "Dark Purple (Velvet Alt Anchor 22%)" },

				{ "slug": "very-light-red", "color": "hsl(6, 22%, 91%)", "name": "Very Light Red (Ember Subtle 91%)" },
				{ "slug": "light-red", "color": "hsl(6, 18%, 83%)", "name": "Light Red (Ember Subtle Alt 83%)" },
				{ "slug": "red", "color": "hsl(0, 23%, 32%)", "name": "Red (Ember Primary 32%)" },
				{ "slug": "dark-red", "color": "hsl(0, 23%, 22%)", "name": "Dark Red (Ember Alt Anchor 22%)" }
			],
			"duotone": [
				{ "colors": ["hsl(154, 26%, 38%)", "hsl(32, 20%, 97%)"], "slug": "primary", "name": "Primary (Obsidian Pine)" },
				{ "colors": ["hsl(154, 16%, 83%)", "hsl(32, 20%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Muted Sage)" },
				{ "colors": ["hsl(206, 26%, 34%)", "hsl(32, 20%, 97%)"], "slug": "secondary", "name": "Secondary (Deep Ink)" },
				{ "colors": ["hsl(206, 18%, 83%)", "hsl(32, 20%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Steel Slate)" },
				{ "colors": ["hsl(34, 34%, 38%)", "hsl(32, 20%, 97%)"], "slug": "tertiary", "name": "Tertiary (Dark Espresso)" },
				{ "colors": ["hsl(34, 16%, 83%)", "hsl(32, 20%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Warm Sand)" },
				{ "colors": ["hsl(209, 24%, 16%)", "hsl(206, 24%, 44%)"], "slug": "midnight", "name": "Midnight (SaaS Dark Mode)" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale (Pure Crisp)" },
				{ "colors": ["hsl(0, 0%, 11%)", "hsl(32, 6%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale (Muted Carbon)" }
			],
			"gradients": [
				{ "slug": "primary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary), var(--wp--preset--color--primary-alt))", "name": "Primary" },
				{ "slug": "secondary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--secondary), var(--wp--preset--color--secondary-alt))", "name": "Secondary" },
				{ "slug": "tertiary", "gradient": "linear-gradient(160deg, var(--wp--preset--color--tertiary), var(--wp--preset--color--tertiary-alt))", "name": "Tertiary" },
				{ "slug": "green", "gradient": "linear-gradient(160deg, var(--wp--preset--color--green), var(--wp--preset--color--dark-green))", "name": "Green" },
				{ "slug": "yellow", "gradient": "linear-gradient(160deg, var(--wp--preset--color--yellow), var(--wp--preset--color--dark-yellow))", "name": "Yellow" },
				{ "slug": "blue", "gradient": "linear-gradient(160deg, var(--wp--preset--color--blue), var(--wp--preset--color--dark-blue))", "name": "Blue" },
				{ "slug": "orange", "gradient": "linear-gradient(160deg, var(--wp--preset--color--orange), var(--wp--preset--color--dark-orange))", "name": "Orange" },
				{ "slug": "purple", "gradient": "linear-gradient(160deg, var(--wp--preset--color--purple), var(--wp--preset--color--dark-purple))", "name": "Purple" },
				{ "slug": "red", "gradient": "linear-gradient(160deg, var(--wp--preset--color--red), var(--wp--preset--color--dark-red))", "name": "Red" },
				{ "slug": "midnight", "gradient": "linear-gradient(160deg, var(--wp--preset--color--dark-midnight-blue), var(--wp--preset--color--blue))", "name": "Midnight" },
				{ "slug": "gray", "gradient": "linear-gradient(160deg, var(--wp--preset--color--gray), var(--wp--preset--color--dark-gray))", "name": "Gray" },
				{ "slug": "dark-gray", "gradient": "linear-gradient(160deg, var(--wp--preset--color--dark-gray), var(--wp--preset--color--very-dark-gray))", "name": "Dark Gray" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Natural", "slug": "natural", "shadow": "var(--wp--custom--shadow--natural)" },
				{ "name": "Deep", "slug": "deep", "shadow": "var(--wp--custom--shadow--deep)" },
				{ "name": "Sharp", "slug": "sharp", "shadow": "var(--wp--custom--shadow--sharp)" },
				{ "name": "Crisp", "slug": "crisp", "shadow": "var(--wp--custom--shadow--crisp)" },
				{ "name": "Outline", "slug": "outline", "shadow": "var(--wp--custom--shadow--outline)" }
			]
		},
		"border": {
			"customRadius": false,
			"radiusSizes": [			
				{ "name": "Extra Small", "slug": "xs", "size": "calc(0.25 * var(--wp--custom--border--radius))" },
				{ "name": "Small", "slug": "sm", "size": "calc(0.5 * var(--wp--custom--border--radius))" },
				{ "name": "Medium", "slug": "md", "size": "var(--wp--custom--border--radius)" },
				{ "name": "Large", "slug": "lg", "size": "calc(1.25 * var(--wp--custom--border--radius))" },
				{ "name": "Extra Large", "slug": "xl", "size": "calc(1.5 * var(--wp--custom--border--radius))" },
				{ "name": "2X-Large", "slug": "2-xl", "size": "calc(2 * var(--wp--custom--border--radius))" },
				{ "name": "3X-Large", "slug": "3-xl", "size": "calc(2.5 * var(--wp--custom--border--radius))" }
			]			
		}
	},
	"styles": {
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|50",
				"bottom": "0",
				"left": "var:preset|spacing|50"
			}
		},	
		"border": {
			"radius": "var(--wp--custom--border--radius)"
		},		
		"typography": {
			"fontSize": "var:preset|font-size|normal",		
			"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
			"lineHeight": "1.6"
		},
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				},
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"lineHeight": "1.2"
				}
			},
			"h1": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)"
				}
			},
			"h2": {
				"typography": {
					"fontWeight": "var(--wp--custom--typography--font-weight--light)"
				}
			},
			"h6": { 
				"typography": { 
					"fontWeight": "var(--wp--custom--typography--font-weight--normal)",
					"textTransform": "uppercase"					
				} 
			},
			"link": {
				"color": { 
					"text": "var:preset|color|highlight-alt" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight-alt" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight-alt" 
					}
				},
				"typography": {
					"textDecoration": "none"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--custom--color--button--background)",
					"text": "var(--wp--custom--color--button--text)"
				},
				"spacing": {
					"padding": {
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|40",
						"right": "var:preset|spacing|40",
						"top": "var:preset|spacing|30"
					}
				},
				"border": {
					"radius": "var(--wp--custom--button--radius)"
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "var(--wp--custom--typography--font-weight--medium)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--custom--color--button--hover)"
					}
				},
