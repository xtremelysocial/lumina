				{ "slug": "highlight-secondary", "color": "hsl(204, 50%, 82%)", "name": "Highlight Secondary (Titanium Link)" },
				{ "slug": "highlight-tertiary", "color": "hsl(36, 88%, 74%)", "name": "Highlight Tertiary (Hazard Gold Link)" },

				{ "slug": "highlight-alt", "color": "hsl(189, 70%, 50%)", "name": "Highlight Alt (Technical Aqua Button/Heading Ink)" },
