{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Zinc - Industrial Prototype: Machined metal and gunmetal zinc alloy",
	"settings": {
		"custom": {
			"color": {			
				"theme": {
					"mode": "is-dark-theme",
					"scheme": "zinc"
				},
				"contrast": {
					"primary-subtle": 		"var(--wp--preset--color--off-white)",
					"primary-subtle-alt": 	"var(--wp--preset--color--off-white)",
					"secondary-subtle": 	"var(--wp--preset--color--off-white)",
					"secondary-subtle-alt": "var(--wp--preset--color--off-white)",
					"tertiary-subtle": 		"var(--wp--preset--color--off-white)",
					"tertiary-subtle-alt": 	"var(--wp--preset--color--off-white)",
					"neutral": 				"var(--wp--preset--color--off-white)",
					"neutral-alt": 			"var(--wp--preset--color--off-white)",
					"very-light-gray": 		"var(--wp--preset--color--off-white)",
					"light-gray": 			"var(--wp--preset--color--off-white)",
					"very-dark-gray": 		"var(--wp--preset--color--almost-black)"
				},
				"border": 			"color-mix(in srgb, currentColor 10%, transparent)",
				"divider": 			"color-mix(in srgb, currentColor 12%, transparent)",				
				"heading": {
					"text": 		"var(--wp--preset--color--contrast)",
					"separator": 	"var(--wp--preset--color--primary)"
				},
				"button": {
					"background": 	"var(--wp--preset--color--primary)"
				},
				"navigation": {
					"highlight": 	"var(--wp--preset--color--highlight)"
				},	
				"opacity": {
					"tintColor": 	"var(--wp--preset--color--highlight-accent)"
				},
				"shadow": {
					"natural": "0 2px 4px rgba(0, 0, 0, 0.25), 0 4px 10px rgba(0, 0, 0, 0.30)",
					"deep":    "0 3px 6px rgba(0, 0, 0, 0.30), 0 8px 18px rgba(0, 0, 0, 0.40)",
					"sharp":   "0 4px 10px rgba(0, 0, 0, 0.35), 0 12px 26px rgba(0, 0, 0, 0.48)",
					"crisp":   "0 6px 14px rgba(0, 0, 0, 0.40), 0 16px 34px rgba(0, 0, 0, 0.55)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(50, 4%, 42%)", "name": "Primary (Machine Stone Gray 42%)" },
				{ "slug": "secondary", "color": "hsl(210, 18%, 32%)", "name": "Secondary (Midnight Industrial Blue 32%)" },
				{ "slug": "tertiary", "color": "hsl(50, 4%, 22%)", "name": "Tertiary (Machined Gunmetal 22%)" },

				{ "slug": "primary-subtle", "color": "hsl(50, 4%, 18%)", "name": "Primary Subtle (Technical Stone Fill 18%)" },
				{ "slug": "secondary-subtle", "color": "hsl(210, 14%, 16%)", "name": "Secondary Subtle (Gunmetal Blue Fill 16%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(0, 0%, 13%)", "name": "Tertiary Subtle (Carbon Plate Fill 13%)" },

				{ "slug": "primary-alt", "color": "hsl(50, 4%, 30%)", "name": "Primary Alt (Deep Machine Stone 30%)" },
				{ "slug": "secondary-alt", "color": "hsl(210, 18%, 22%)", "name": "Secondary Alt (Dark Midnight Steel 22%)" },
				{ "slug": "tertiary-alt", "color": "hsl(50, 4%, 15%)", "name": "Tertiary Alt (Deep Gunmetal Recess 15%)" },

				{ "slug": "dark", "color": "hsl(210, 18%, 18%)", "name": "Dark (Gunmetal Slate Section Band 18%)" },
				{ "slug": "dark-alt", "color": "hsl(210, 18%, 13%)", "name": "Dark Alt (Deep Gunmetal Band 13%)" },							

				{ "slug": "dark-accent", "color": "hsl(0, 0%, 14%)", "name": "Dark Accent (Carbon Section Band 14%)" },
				{ "slug": "dark-accent-alt", "color": "hsl(0, 0%, 10%)", "name": "Dark Accent Alt (Deep Carbon Band 10%)" },

				{ "slug": "highlight", "color": "hsl(189, 85%, 78%)", "name": "Highlight (Glow Aqua Link)" },
				{ "slug": "highlight-alt", "color": "hsl(189, 70%, 34%)", "name": "Highlight Alt (Deep Technical Aqua Link Ink / Button 34%)" },

				{ "slug": "highlight-accent", "color": "hsl(36, 88%, 74%)", "name": "Highlight Accent (Hazard Gold Link)" },
				{ "slug": "highlight-accent-alt", "color": "hsl(36, 75%, 38%)", "name": "Highlight Accent Alt (Deep Anodized Amber Button / Ink 38%)" },
        
				{ "slug": "neutral", "color": "hsl(0, 0%, 18%)", "name": "Neutral (Industrial Grid Fill)" },
				{ "slug": "neutral-alt", "color": "hsl(50, 4%, 14%)", "name": "Neutral Alt (Technical Structural Border)" },

				{ "slug": "off-white", "color": "hsl(45, 29%, 97%)", "name": "Off White" },
				{ "slug": "very-light-gray", "color": "hsl(50, 4%, 12%)", "name": "Very Light Gray (Inverted Deep Zinc Floor 12%)" },
				{ "slug": "light-gray", "color": "hsl(50, 4%, 20%)", "name": "Light Gray (Inverted Zinc Plate Well 20%)" },
				{ "slug": "gray", "color": "hsl(50, 4%, 35%)", "name": "Gray (Inverted Machined Border Seam 35%)" },
				{ "slug": "dark-gray", "color": "hsl(50, 4%, 65%)", "name": "Dark Gray (Inverted Muted Zinc Typography 65%)" },
				{ "slug": "very-dark-gray", "color": "hsl(50, 4%, 85%)", "name": "Very Dark Gray (Inverted Specular Typography 85%)" },

				{ "slug": "almost-black", "color": "hsl(208, 18%, 18%)", "name": "Almost Black (Tinted Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(209, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" },

				{ "slug": "base", "color": "hsl(0, 0%, 10%)", "name": "Base (Rich Carbon Dark Canvas)" },
				{ "slug": "contrast", "color": "hsl(45, 29%, 97%)", "name": "Contrast (Off White Paper Typography)" }				
			],
			"duotone": [
				{ "colors": ["hsl(50, 4%, 42%)", "hsl(45, 29%, 97%)"], "slug": "primary", "name": "Primary (Machine Gray)" },
				{ "colors": ["hsl(50, 4%, 30%)", "hsl(45, 29%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Deep Machine Stone)" },
				{ "colors": ["hsl(210, 18%, 32%)", "hsl(45, 29%, 97%)"], "slug": "secondary", "name": "Secondary (Midnight Blue)" },
				{ "colors": ["hsl(210, 18%, 22%)", "hsl(45, 29%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Dark Midnight)" },
				{ "colors": ["hsl(50, 4%, 22%)", "hsl(45, 29%, 97%)"], "slug": "tertiary", "name": "Tertiary (Machined Gunmetal)" },
				{ "colors": ["hsl(50, 4%, 15%)", "hsl(45, 29%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Deep Gunmetal Recess)" },
				{ "colors": ["hsl(210, 18%, 13%)", "hsl(50, 4%, 42%)"], "slug": "midnight", "name": "Midnight Gunmetal" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(50, 4%, 42%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"elements": {
			"link": {
				"color": { 
					"text": "var:preset|color|highlight" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight" 
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|highlight"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						}
					}
				}	
			}
		}		
	}
}