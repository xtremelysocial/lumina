				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--tertiary)"
				},
				"button": {
					"background": "var(--wp--preset--color--tertiary)",
					"text": "var(--wp--preset--color--almost-black)"
				}
			}
		},
