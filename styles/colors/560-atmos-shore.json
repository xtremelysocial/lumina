				{ "colors": ["#C8D6CF", "#FAF9F6"], "slug": "tertiary", "name": "Tertiary" },
				{ "colors": ["#78A391", "#FAF9F6"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
