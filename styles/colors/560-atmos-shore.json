{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Elements: Shore (Coastal Fog: Cool slates and misty blues)",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"tertiary": "var(--wp--preset--color--contrast)"
				},
				"heading": {
					"text": "hsl(206, 28%, 8%)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.03)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.04)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.10), 0 6px 12px rgba(0, 0, 0, 0.06)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.12), 0 10px 20px rgba(0, 0, 0, 0.08)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(206, 22%, 44%)", "name": "Primary (Steel Action Core)" },
				{ "slug": "primary-alt", "color": "hsl(206, 20%, 32%)", "name": "Primary Alt (Steel Hover)" },
				{ "slug": "secondary", "color": "hsl(206, 22%, 24%)", "name": "Secondary (Deep Midnight Core)" },
				{ "slug": "secondary-alt", "color": "hsl(206, 24%, 18%)", "name": "Secondary Alt (Midnight Anchor)" },
				{ "slug": "tertiary", "color": "hsl(43, 14%, 68%)", "name": "Tertiary (Bright Sand Core)" },
				{ "slug": "tertiary-alt", "color": "hsl(43, 12%, 54%)", "name": "Tertiary Alt (Warm Driftwood)" },

				{ "slug": "primary-subtle", "color": "hsl(206, 16%, 89%)", "name": "Primary Subtle (Misty Steel Well)" },
				{ "slug": "primary-subtle-alt", "color": "hsl(206, 14%, 86%)", "name": "Primary Subtle Alt (Misty Steel Border)" },
				{ "slug": "secondary-subtle", "color": "hsl(206, 16%, 83%)", "name": "Secondary Subtle (Midnight Well)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(206, 14%, 71%)", "name": "Secondary Subtle Alt (Midnight Border)" },
				{ "slug": "tertiary-subtle", "color": "hsl(43, 14%, 83%)", "name": "Tertiary Subtle (Structured Sand Well)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(43, 12%, 71%)", "name": "Tertiary Subtle Alt (Structured Sand Border)" },

				{ "slug": "base", "color": "hsl(43, 27%, 97%)", "name": "Base (Off White)" },
				{ "slug": "contrast", "color": "hsl(206, 20%, 10%)", "name": "Contrast (Rich Steel Ink)" },
				{ "slug": "neutral", "color": "hsl(40, 20%, 96%)", "name": "Neutral (Linen Fill)" },
				{ "slug": "neutral-alt", "color": "hsl(40, 15%, 91%)", "name": "Neutral Alt (Border)" },
				{ "slug": "foreground-alt", "color": "hsl(0, 0%, 100%)", "name": "Foreground Alt (White)" },

				{ "slug": "highlight", "color": "hsl(206, 32%, 66%)", "name": "Highlight (Misty Sea Link)" },
				{ "slug": "highlight-alt", "color": "hsl(206, 24%, 53%)", "name": "Highlight Alt (Misty Sea Hover)" },

				{ "slug": "dark", "color": "hsl(206, 16%, 14%)", "name": "Dark (Abyss Floor)" },
				{ "slug": "dark-alt", "color": "hsl(206, 22%, 10%)", "name": "Dark Alt (Abyss Base)" },
				{ "slug": "dark-secondary", "color": "hsl(43, 14%, 14%)", "name": "Dark Secondary (Trench Sand Floor)" },
				{ "slug": "dark-secondary-alt", "color": "hsl(43, 12%, 10%)", "name": "Dark Secondary Alt (Trench Sand Base)" },

				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(43, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "hsl(43, 15%, 91%)", "name": "Very Light Gray (Ash Mist)" },
				{ "slug": "light-gray", "color": "hsl(43, 10%, 88%)", "name": "Light Gray (Silt)" },
				{ "slug": "gray", "color": "hsl(43, 4%, 68%)", "name": "Gray (Pebble)" },
				{ "slug": "dark-gray", "color": "hsl(43, 3%, 43%)", "name": "Dark Gray (Stone)" },
				{ "slug": "very-dark-gray", "color": "hsl(60, 2%, 23%)", "name": "Very Dark Gray (Muted Obsidian)" },
				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black (Carbon)" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black (Rich Carbon)" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black (True Black)" }
			],
			"duotone": [
				{ "colors": ["hsl(206, 22%, 44%)", "hsl(43, 27%, 97%)"], "slug": "primary", "name": "Primary (Steel Gradient)" },
				{ "colors": ["hsl(206, 20%, 32%)", "hsl(43, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Steel Hover Gradient)" },
				{ "colors": ["hsl(206, 22%, 24%)", "hsl(43, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Midnight Gradient)" },
				{ "colors": ["hsl(206, 24%, 18%)", "hsl(43, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Deep Midnight Gradient)" },
				{ "colors": ["hsl(43, 14%, 68%)", "hsl(43, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Sand Dune Gradient)" },
				{ "colors": ["hsl(43, 12%, 54%)", "hsl(43, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Driftwood Gradient)" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(207, 22%, 19%)", "hsl(0, 18%, 36%)"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["hsl(0, 0%, 18%)", "hsl(207, 22%, 19%)"], "slug": "midnight", "name": "Midnight Blue" },
				{ "colors": ["hsl(0, 18%, 36%)", "hsl(33, 30%, 51%)"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(155, 16%, 46%)"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["hsl(207, 22%, 19%)", "hsl(12, 31%, 49%)"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(43, 3%, 43%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		}
	}
}