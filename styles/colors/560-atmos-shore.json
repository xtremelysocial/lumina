			"duotone": [
				{ "colors": ["#536A78", "#FAF9F6"], "slug": "primary", "name": "Primary" },
				{ "colors": ["#384952", "#FAF9F6"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["#3D4E5B", "#FAF9F6"], "slug": "secondary", "name": "Secondary" },
