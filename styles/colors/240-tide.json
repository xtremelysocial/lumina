			"duotone": [
				{ "colors": ["hsl(12, 32%, 50%)", "hsl(43, 27%, 97%)"], "slug": "primary", "name": "Primary (Terracotta)" },
				{ "colors": ["hsl(12, 32%, 38%)", "hsl(43, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Deep Terracotta)" },
				{ "colors": ["hsl(38, 18%, 42%)", "hsl(43, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Weathered Bronze)" },
				{ "colors": ["hsl(38, 20%, 28%)", "hsl(43, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Dark Bronze Anchor)" },
				{ "colors": ["hsl(43, 22%, 72%)", "hsl(0, 0%, 11%)"], "slug": "tertiary", "name": "Tertiary (Bright Dune Sand)" },
				{ "colors": ["hsl(43, 24%, 42%)", "hsl(43, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Warm Driftwood)" },
				{ "colors": ["hsl(206, 20%, 11%)", "hsl(43, 27%, 97%)"], "slug": "midnight", "name": "Marine Tide Ink" },
