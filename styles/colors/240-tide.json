	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			},
			"link": {
				"color": { 
					"text": "var:preset|color|primary" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|primary-alt" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|primary-alt" 
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|primary"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|primary-alt"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|primary-alt"
							}
						}
					}
				}	
			}
		}
	}
}