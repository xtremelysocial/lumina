				{ "slug": "tertiary-alt", "color": "hsl(43, 24%, 42%)", "name": "Tertiary Alt (Warm Driftwood Sand 42%)" },

				{ "slug": "primary-subtle", "color": "hsl(206, 24%, 91%)", "name": "Primary Subtle (Whisper Sky Blue Fill 91%)" },
