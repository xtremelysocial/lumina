{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Tide - Coastal Terracotta & Bronze: Burnt terracotta primary over bronze heroes and dune sand wells",
	"settings": {
		"custom": {
			"color": {			
				"theme": {
					"mode": "is-light-theme",
					"scheme": "tide-light"
				},
				"contrast": {
					"tertiary": "var(--wp--preset--color--almost-black)"
				},
				"heading": {
					"text": "var(--wp--preset--color--dark-alt)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"button": {
					"background": "var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(12, 32%, 50%)", "name": "Primary (Muted Terracotta 50%)" },
				{ "slug": "secondary", "color": "hsl(38, 18%, 42%)", "name": "Secondary (Weathered Bronze Core 42%)" },
				{ "slug": "tertiary", "color": "hsl(43, 22%, 72%)", "name": "Tertiary (Bright Dune Sand Core 72%)" },

				{ "slug": "base", "color": "hsl(43, 27%, 97%)", "name": "Base (Light Sun-Bleached Sandstone Canvas)" },

