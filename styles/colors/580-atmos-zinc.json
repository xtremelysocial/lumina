{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
	"title": "Atmos Zinc (Industrial Prototype: Machined metal and gunmetal zinc alloy)",
    "settings": {
		"custom": {
			"color": {			
				"contrast": {
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)"
				},
				"heading": {
					"text": "#EBF1F5",
					"separator": "var(--wp--preset--color--highlight-alt)"
				},				
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.45), 0 1px 3px rgba(0, 0, 0, 0.25)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.55), 0 3px 6px rgba(0, 0, 0, 0.35)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.65), 0 6px 12px rgba(0, 0, 0, 0.40)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.75), 0 10px 20px rgba(0, 0, 0, 0.50)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
        "color": {
			"palette": [
				{ "slug": "primary", "color": "#706F6A", "name": "Primary (Machine Stone Gray)" },
				{ "slug": "primary-alt", "color": "#575652", "name": "Primary Alt (Oiled Gunmetal Steel)" },
				{ "slug": "secondary", "color": "#3D4E5B", "name": "Secondary (Midnight Industrial Blue)" },
				{ "slug": "secondary-alt", "color": "#2A323D", "name": "Secondary Alt (Dark Midnight Steel)" },
				{ "slug": "tertiary", "color": "#B0AFA9", "name": "Tertiary (Machined Silver)" },
				{ "slug": "tertiary-alt", "color": "#8E8D88", "name": "Tertiary Alt (Burnished Zinc)" },
