			"duotone": [
				{ "colors": ["hsl(50, 4%, 44%)", "hsl(45, 29%, 97%)"], "slug": "primary", "name": "Primary (Machine Gray)" },
				{ "colors": ["hsl(50, 4%, 32%)", "hsl(45, 29%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Oiled Gunmetal)" },
				{ "colors": ["hsl(210, 18%, 32%)", "hsl(45, 29%, 97%)"], "slug": "secondary", "name": "Secondary (Midnight Blue)" },
				{ "colors": ["hsl(210, 18%, 22%)", "hsl(45, 29%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Dark Midnight)" },
				{ "colors": ["hsl(50, 4%, 68%)", "hsl(45, 29%, 97%)"], "slug": "tertiary", "name": "Tertiary (Machined Silver)" },
				{ "colors": ["hsl(50, 4%, 56%)", "hsl(45, 29%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Burnished Zinc)" },
				{ "colors": ["hsl(327, 5%, 31%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(210, 22%, 19%)", "hsl(0, 18%, 27%)"], "slug": "blue-red", "name": "Blue and Red" },
