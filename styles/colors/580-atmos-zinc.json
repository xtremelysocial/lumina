				{ "slug": "light-blue", "color": "hsl(202, 13%, 81%)", "name": "Light Blue" },
				{ "slug": "blue", "color": "hsl(207, 18%, 32%)", "name": "Blue" },
				{ "slug": "dark-blue", "color": "hsl(210, 22%, 19%)", "name": "Dark Blue" },
				{ "slug": "midnight-blue", "color": "hsl(208, 21%, 22%)", "name": "Midnight Blue" },
