{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Deep Sea - Oceanic Dark: Dark midnight slate canvas with maritime accents",
	"settings": {
		"custom": {
			"color": {			
				"theme": {
					"mode": "is-dark-theme",
					"scheme": "deep-sea"
				},
				"contrast": {
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)",
					"very-light-gray": "var(--wp--preset--color--foreground-alt)",
					"light-gray": "var(--wp--preset--color--foreground-alt)",
					"very-dark-gray": "var(--wp--preset--color--almost-black)"
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"button": {
					"background": "var(--wp--preset--color--primary)"
				},
				"highlight": "var(--wp--preset--color--highlight)",
				"shadow": {
					"natural": "0 2px 4px rgba(0, 0, 0, 0.25), 0 4px 10px rgba(0, 0, 0, 0.30)",
					"deep":    "0 3px 6px rgba(0, 0, 0, 0.30), 0 8px 18px rgba(0, 0, 0, 0.40)",
					"sharp":   "0 4px 10px rgba(0, 0, 0, 0.35), 0 12px 26px rgba(0, 0, 0, 0.48)",
					"crisp":   "0 6px 14px rgba(0, 0, 0, 0.40), 0 16px 34px rgba(0, 0, 0, 0.55)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(195, 32%, 38%)", "name": "Primary (Glacial Deep Cyan 38%)" },
				{ "slug": "secondary", "color": "hsl(205, 30%, 28%)", "name": "Secondary (Glacial Slate Panel 28%)" },
				{ "slug": "tertiary", "color": "hsl(215, 29%, 18%)", "name": "Tertiary (Abyssal Navy Trench 18%)" },

				{ "slug": "base", "color": "hsl(215, 29%, 10%)", "name": "Base (Dark Deep Sea Canvas)" },

				{ "slug": "primary-alt", "color": "hsl(195, 35%, 28%)", "name": "Primary Alt (Deep Glacial Cyan 28%)" },			
				{ "slug": "secondary-alt", "color": "hsl(205, 32%, 18%)", "name": "Secondary Alt (Hero & CTA Canvas 18%)" },
				{ "slug": "tertiary-alt", "color": "hsl(215, 28%, 12%)", "name": "Tertiary Alt (Deep Abyssal Recess 12%)" },		

				{ "slug": "primary-subtle", "color": "hsl(195, 26%, 18%)", "name": "Primary Subtle (Deep Cyan Fill 18%)" },
				{ "slug": "secondary-subtle", "color": "hsl(205, 24%, 16%)", "name": "Secondary Subtle (Glacial Slate Fill 16%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(215, 24%, 13%)", "name": "Tertiary Subtle (Abyssal Navy Fill 13%)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(195, 22%, 14%)", "name": "Primary Subtle Alt (Deep Cyan Seam 14%)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(205, 22%, 12%)", "name": "Secondary Subtle Alt (Glacial Slate Seam 12%)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(215, 20%, 9%)", "name": "Tertiary Subtle Alt (Navy Marine Seam 9%)" },	

				{ "slug": "highlight", "color": "hsl(195, 82%, 80%)", "name": "Highlight (Glacial Ice Link)" },
				{ "slug": "highlight-secondary", "color": "hsl(172, 56%, 83%)", "name": "Highlight Secondary (Bioluminescent Seafoam Link)" },
				{ "slug": "highlight-tertiary", "color": "hsl(38, 85%, 75%)", "name": "Highlight Tertiary (Bioluminescent Amber Link)" },

				{ "slug": "highlight-alt", "color": "hsl(195, 75%, 50%)", "name": "Highlight Alt (Glacial Cyan Button/Heading Ink)" },
				{ "slug": "highlight-secondary-alt", "color": "hsl(172, 55%, 46%)", "name": "Highlight Secondary Alt (Deep Seafoam Button/Heading Ink)" },
				{ "slug": "highlight-tertiary-alt", "color": "hsl(38, 75%, 50%)", "name": "Highlight Tertiary Alt (Deep Amber Button/Heading Ink)" },

