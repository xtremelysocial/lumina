				{ "slug": "primary-dark-alt", "color": "hsl(195, 35%, 16%)", "name": "Primary Dark Alt (Deep Cyan Band 16%)" },				
				{ "slug": "dark-alt", "color": "hsl(205, 35%, 13%)", "name": "Dark Alt (Deep Slate Band 13%)" },							
				{ "slug": "tertiary-dark-alt", "color": "hsl(215, 35%, 10%)", "name": "Dark Tertiary Alt (Deep Navy Band 10%)" },

				{ "slug": "contrast", "color": "hsl(43, 27%, 97%)", "name": "Contrast (Off White Typography)" },
				{ "slug": "foreground-alt", "color": "hsl(43, 27%, 97%)", "name": "Foreground Alt (Off White)" },

				{ "slug": "neutral", "color": "hsl(215, 29%, 15%)", "name": "Neutral (Submerged Slate)" },
