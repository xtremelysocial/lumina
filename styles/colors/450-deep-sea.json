				{ "slug": "very-light-gray", "color": "hsl(215, 20%, 12%)", "name": "Very Light Gray (Inverted Deep Footer Floor 12%)" },
				{ "slug": "light-gray", "color": "hsl(215, 16%, 22%)", "name": "Light Gray (Inverted Structural Card Well 22%)" },
				{ "slug": "gray", "color": "hsl(215, 12%, 35%)", "name": "Gray (Inverted Technical Border Seam 35%)" },
				{ "slug": "dark-gray", "color": "hsl(215, 10%, 65%)", "name": "Dark Gray (Inverted Muted Typography 65%)" },
				{ "slug": "very-dark-gray", "color": "hsl(215, 12%, 85%)", "name": "Very Dark Gray (Inverted Tech Typography 85%)" },

				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(43, 27%, 97%)", "name": "Off White" },

				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black" },

				{ "slug": "very-light-green", "color": "hsl(154, 20%, 91%)", "name": "Very Light Green (Moss Subtle 91%)" },
				{ "slug": "light-green", "color": "hsl(154, 16%, 83%)", "name": "Light Green (Moss Subtle Alt 83%)" },
				{ "slug": "green", "color": "hsl(154, 24%, 48%)", "name": "Green (Moss Primary 48%)" },
				{ "slug": "dark-green", "color": "hsl(154, 26%, 38%)", "name": "Dark Green (Moss 38%)" },
				
				{ "slug": "very-light-yellow", "color": "hsl(34, 22%, 91%)", "name": "Very Light Yellow (Ochre Subtle 91%)" },
				{ "slug": "light-yellow", "color": "hsl(34, 16%, 83%)", "name": "Light Yellow (Ochre Subtle Alt 83%)" },
				{ "slug": "yellow", "color": "hsl(34, 32%, 48%)", "name": "Yellow (Ochre Primary 48%)" },
				{ "slug": "dark-yellow", "color": "hsl(34, 34%, 38%)", "name": "Dark Yellow (Ochre 38%)" },

				{ "slug": "very-light-orange", "color": "hsl(22, 26%, 91%)", "name": "Very Light Orange (Flame Subtle 91%)" },
				{ "slug": "light-orange", "color": "hsl(22, 22%, 83%)", "name": "Light Orange (Flame Subtle Alt 83%)" },
				{ "slug": "orange", "color": "hsl(12, 32%, 48%)", "name": "Orange (Flame Primary 48%)" },
				{ "slug": "dark-orange", "color": "hsl(12, 32%, 38%)", "name": "Dark Orange (Flame 38%)" },
				
				{ "slug": "very-light-blue", "color": "hsl(206, 24%, 91%)", "name": "Very Light Blue (Ocean Subtle 91%)" },
				{ "slug": "light-blue", "color": "hsl(206, 18%, 83%)", "name": "Light Blue (Ocean Subtle Alt 83%)" },
				{ "slug": "blue", "color": "hsl(206, 24%, 44%)", "name": "Blue (Ocean Primary 44%)" },
				{ "slug": "dark-blue", "color": "hsl(206, 26%, 34%)", "name": "Dark Blue (Ocean 34%)" },
				{ "slug": "midnight-blue", "color": "hsl(208, 21%, 22%)", "name": "Midnight Blue (Lumina Balanced 22%)" },
				{ "slug": "dark-midnight-blue", "color": "hsl(209, 24%, 16%)", "name": "Dark Midnight Blue (Lumina Balanced 16%)" },
				
				{ "slug": "very-light-purple", "color": "hsl(320, 16%, 91%)", "name": "Very Light Purple (Velvet Subtle 91%)" },
				{ "slug": "light-purple", "color": "hsl(320, 12%, 83%)", "name": "Light Purple (Velvet Subtle Alt 83%)" },
				{ "slug": "purple", "color": "hsl(327, 8%, 32%)", "name": "Purple (Velvet Primary 32%)" },
				{ "slug": "dark-purple", "color": "hsl(327, 8%, 22%)", "name": "Dark Purple (Velvet 22%)" },

				{ "slug": "very-light-red", "color": "hsl(6, 22%, 91%)", "name": "Very Light Red (Ember Subtle 91%)" },
				{ "slug": "light-red", "color": "hsl(6, 18%, 83%)", "name": "Light Red (Ember Subtle Alt 83%)" },
				{ "slug": "red", "color": "hsl(0, 23%, 32%)", "name": "Red (Ember Primary 32%)" },
				{ "slug": "dark-red", "color": "hsl(0, 23%, 22%)", "name": "Dark Red (Ember 22%)" }		
			],
			"duotone": [
				{ "colors": ["hsl(195, 32%, 38%)", "hsl(43, 27%, 97%)"], "slug": "primary", "name": "Primary (Glacial Cyan)" },
				{ "colors": ["hsl(195, 35%, 28%)", "hsl(43, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Deep Glacial)" },
				{ "colors": ["hsl(205, 30%, 28%)", "hsl(43, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Glacial Slate)" },
				{ "colors": ["hsl(205, 32%, 18%)", "hsl(43, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Hero Canvas)" },
				{ "colors": ["hsl(215, 29%, 18%)", "hsl(43, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Abyssal Navy)" },
				{ "colors": ["hsl(215, 28%, 12%)", "hsl(43, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Deep Abyssal)" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(215, 29%, 15%)", "hsl(0, 18%, 36%)"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["hsl(215, 30%, 7%)", "hsl(195, 32%, 38%)"], "slug": "midnight", "name": "Midnight" },
				{ "colors": ["hsl(0, 18%, 36%)", "hsl(33, 30%, 51%)"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(155, 16%, 46%)"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["hsl(195, 32%, 38%)", "hsl(12, 31%, 49%)"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(215, 29%, 15%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			},
			"link": {
				"color": { 
					"text": "var:preset|color|highlight" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight" 
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|highlight"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						}
					}
				}	
			}
		}
	}
}