				{ 
					"slug": "green", 
					"gradient": "linear-gradient(160deg, hsl(154, 24%, 48%), hsl(154, 26%, 38%))", 
					"name": "Moss Green" 
				},
				{ 
					"slug": "yellow", 
					"gradient": "linear-gradient(160deg, hsl(34, 32%, 48%), hsl(34, 34%, 38%))", 
					"name": "Ochre Yellow" 
				},
				{ 
					"slug": "blue", 
					"gradient": "linear-gradient(160deg, hsl(206, 24%, 44%), hsl(206, 26%, 34%))", 
					"name": "Ocean Blue" 
				},
				{ 
					"slug": "orange", 
					"gradient": "linear-gradient(160deg, hsl(12, 32%, 48%), hsl(12, 32%, 38%))", 
					"name": "Flame Orange" 
				},
				{ 
					"slug": "purple", 
					"gradient": "linear-gradient(160deg, hsl(327, 8%, 32%), hsl(327, 8%, 22%))", 
					"name": "Velvet Purple" 
				},
				{ 
					"slug": "red", 
					"gradient": "linear-gradient(160deg, hsl(0, 23%, 32%), hsl(0, 23%, 22%))", 
					"name": "Ember Red" 
				},
				{ 
					"slug": "midnight", 
					"gradient": "linear-gradient(160deg, hsl(206, 24%, 44%), hsl(209, 24%, 16%))", 
