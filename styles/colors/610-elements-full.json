					"gradient": "linear-gradient(160deg, var(--wp--preset--color--highlight-secondary), var(--wp--preset--color--highlight-secondary-alt))", 
					"name": "Highlight Secondary Accent" 
				},
				{ 
					"slug": "highlight-tertiary", 
					"gradient": "linear-gradient(160deg, var(--wp--preset--color--highlight-tertiary), var(--wp--preset--color--highlight-tertiary-alt))", 
