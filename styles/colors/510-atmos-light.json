{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Light (Clean & Crisp: Bright neutrals and airy sage)",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"primary": "var(--wp--preset--color--almost-black)",
					"tertiary": "var(--wp--preset--color--almost-black)",
					"tertiary-alt": "var(--wp--preset--color--foreground-alt)",
					"highlight": "var(--wp--preset--color--white)",
            		"highlight-alt": "var(--wp--preset--color--white)",
					"bright-green": "var(--wp--preset--color--almost-black)",
					"light-green": "var(--wp--preset--color--almost-black)",
					"yellow": "var(--wp--preset--color--foreground-alt)",
					"light-orange": "var(--wp--preset--color--almost-black)"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.03)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.04)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.10), 0 6px 12px rgba(0, 0, 0, 0.06)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.12), 0 10px 20px rgba(0, 0, 0, 0.08)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
    	},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#C8D6CF", "name": "Primary (Light Green)" },
				{ "slug": "primary-alt", "color": "#78A391", "name": "Primary Alt (Green)" },
				{ "slug": "secondary", "color": "#3D4E5B", "name": "Secondary (Midnight Blue)" },
				{ "slug": "secondary-alt", "color": "#2A323D", "name": "Secondary Alt (Dark Midnight Blue)" },
				{ "slug": "tertiary", "color": "#EDE6D8", "name": "Tertiary (Light Yellow)" },
				{ "slug": "tertiary-alt", "color": "#B38B59", "name": "Tertiary Alt (Yellow)" },
				{ "slug": "neutral", "color": "#F2F1ED", "name": "Neutral (Very Light Gray)" },
				{ "slug": "neutral-alt", "color": "#E5E4DF", "name": "Neutral Alt (Light Gray)" },
				{ "slug": "base", "color": "#FAF9F6", "name": "Base (Off White)" },
				{ "slug": "contrast", "color": "#1B1B1B", "name": "Contrast (Rich Carbon)" },
				{ "slug": "dark", "color": "#3D3D3A", "name": "Dark (Muted Obsidian)" },
				{ "slug": "dark-alt", "color": "#2D2D2D", "name": "Dark Alt (Soft Carbon)" },
				{ "slug": "foreground-alt", "color": "#FAF9F6", "name": "Foreground Alt (Off White)" },
				{
					"slug": "highlight",
					"color": "#007BFF", 
					"name": "Highlight"
				},
				{
					"slug": "highlight-alt",
					"color": "#80BFFF", 
					"name": "Highlight Hover / Dark Mode Link"
				},
				{ "slug": "white", "color": "#FFFFFF", "name": "White (Pure White)" },
				{ "slug": "off-white", "color": "#FAF9F6", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "#F2F1ED", "name": "Very Light Gray (Ash Mist)" },
				{ "slug": "light-gray", "color": "#E5E4DF", "name": "Light Gray (Silt)" },
				{ "slug": "gray", "color": "#B0AFA9", "name": "Gray (Pebble)" },
				{ "slug": "dark-gray", "color": "#706F6A", "name": "Dark Gray (Stone)" },
				{ "slug": "very-dark-gray", "color": "#3D3D3A", "name": "Very Dark Gray (Muted Obsidian)" },
				{ "slug": "light-green", "color": "#C8D6CF", "name": "Light Green (Dusty Sage)" },
				{ "slug": "green", "color": "#78A391", "name": "Green (Luminous Sage)" },
				{ "slug": "bright-green", "color": "#8DBA9D", "name": "Bright Green (Spring Sage)" },
				{ "slug": "dark-bright-green", "color": "#4A6E5D", "name": "Dark Bright Green (Deep Sage)" },
				{ "slug": "light-yellow", "color": "#EDE6D8", "name": "Light Yellow (Cream)" },
				{ "slug": "yellow", "color": "#B38B59", "name": "Yellow (Muted Gold)" },
				{ "slug": "light-orange", "color": "#E6C6BA", "name": "Light Orange (Apricot)" },
				{ "slug": "orange", "color": "#A36555", "name": "Orange (Terra Cotta)" },
				{ "slug": "dark-orange", "color": "#7D483B", "name": "Dark Orange (Burnt Sienna)" },
				{ "slug": "light-blue", "color": "#C0CCD3", "name": "Light Blue (Sky Slate)" },
				{ "slug": "blue", "color": "#536A78", "name": "Blue (Steel)" },
				{ "slug": "dark-blue", "color": "#384952", "name": "Dark Blue (Deep Steel)" },
				{ "slug": "midnight-blue", "color": "#3D4E5B", "name": "Midnight Blue (Atmos Midnight)" },
				{ "slug": "dark-midnight-blue", "color": "#2A323D", "name": "Dark Midnight Blue (Deep Atmos)" },
				{ "slug": "light-purple", "color": "#D2C9CE", "name": "Light Purple (Lavender Mist)" },
				{ "slug": "purple", "color": "#7D7178", "name": "Purple (Muted Heather)" },
				{ "slug": "dark-purple", "color": "#574E53", "name": "Dark Purple (Deep Heather)" },
				{ "slug": "light-red", "color": "#D9C4C4", "name": "Light Red (Rose Mist)" },
				{ "slug": "red", "color": "#946B6B", "name": "Red (Muted Clay)" },
				{ "slug": "dark-red", "color": "#6E4C4C", "name": "Dark Red (Deep Clay)" },
				{ "slug": "almost-black", "color": "#2D2D2D", "name": "Almost Black (Carbon)" },
				{ "slug": "not-quite-black", "color": "#1A1A1A", "name": "Not Quite Black (Rich Carbon)" },
				{ "slug": "black", "color": "#000000", "name": "Black (True Black)" }
			],
			"duotone": [
				{ "colors": ["#78A391", "#FAF9F6"], "slug": "primary", "name": "Primary" },
				{ "colors": ["#C8D6CF", "#FAF9F6"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["#2A323D", "#FAF9F6"], "slug": "secondary", "name": "Secondary" },
				{ "colors": ["#3D4E5B", "#FAF9F6"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["#B38B59", "#FAF9F6"], "slug": "tertiary", "name": "Tertiary" },
				{ "colors": ["#EDE6D8", "#FAF9F6"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["#000000", "#FFFFFF"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["#000000", "#706F6A"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	}
}