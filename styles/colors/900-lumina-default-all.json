					"name": "Highlight Primary Accent" 
				},
				{ 
					"slug": "highlight-accent", 
					"gradient": "linear-gradient(160deg, var(--wp--preset--color--highlight-accent), var(--wp--preset--color--highlight-accent-alt))", 
					"name": "Highlight Tertiary Accent" 
				},
				{ 
					"slug": "green", 
