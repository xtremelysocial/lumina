				{ "slug": "purple", "color": "hsl(323, 20%, 48%)", "name": "Purple (Velvet Primary 48%)" },
				{ "slug": "dark-purple", "color": "hsl(327, 24%, 38%)", "name": "Dark Purple (Velvet Alt Anchor 38%)" },
				
				{ "slug": "very-light-red", "color": "hsl(0, 22%, 91%)", "name": "Very Light Red (Ember Subtle 91%)" },
				{ "slug": "light-red", "color": "hsl(0, 18%, 83%)", "name": "Light Red (Ember Subtle Alt 83%)" },
				{ "slug": "red", "color": "hsl(0, 23%, 48%)", "name": "Red (Ember Primary 48%)" },
				{ "slug": "dark-red", "color": "hsl(0, 26%, 38%)", "name": "Dark Red (Ember Alt Anchor 38%)" }
