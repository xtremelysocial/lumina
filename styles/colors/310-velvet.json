{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Velvet: Plum, sapphire, and crimson jewel tones",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "velvet"
				},
				"heading": {
					"text": "var(--wp--preset--color--almost-black)",
					"separator": "var(--wp--preset--color--tertiary)"
				},
				"link": {
					"hoverOpacity": "0.7" 
				},
				"highlight-alt": {
					"lighten": "brightness(1.75) saturate(0.7)"
				}						
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(327, 12%, 48%)", "name": "Primary (Smoky Heather Velvet 48%)" },
				{ "slug": "secondary", "color": "hsl(207, 22%, 44%)", "name": "Secondary (Midnight Sapphire Slate 44%)" },
				{ "slug": "tertiary", "color": "hsl(0, 28%, 48%)", "name": "Tertiary (Deep Ruby Crimson 48%)" },

				{ "slug": "primary-subtle", "color": "hsl(327, 14%, 92%)", "name": "Primary Subtle (Whisper Lavender 92%)" },
				{ "slug": "secondary-subtle", "color": "hsl(207, 20%, 91%)", "name": "Secondary Subtle (Whisper Sapphire 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(0, 18%, 91%)", "name": "Tertiary Subtle (Whisper Rose 91%)" },

				{ "slug": "primary-alt", "color": "hsl(327, 12%, 38%)", "name": "Primary Alt (Deep Dusky Plum 38%)" },
				{ "slug": "secondary-alt", "color": "hsl(207, 24%, 34%)", "name": "Secondary Alt (Sapphire 34%)" },
				{ "slug": "tertiary-alt", "color": "hsl(0, 28%, 38%)", "name": "Tertiary Alt (Garnet 38%)" },
				
				{ "slug": "dark", "color": "hsl(207, 28%, 22%)", "name": "Dark (Midnight Sapphire 22%)" },
				{ "slug": "dark-alt", "color": "hsl(207, 30%, 15%)", "name": "Dark Alt (Dark Midnight Sapphire 15%)" },				

				{ "slug": "tertiary-dark", "color": "hsl(0, 30%, 22%)", "name": "Dark Accent (Deep Crimson 22%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(0, 30%, 15%)", "name": "Dark Accent Alt (Deep Crimson 15%)" },

				{ "slug": "highlight", "color": "hsl(207, 65%, 72%)", "name": "Highlight (Luminescent Sapphire)" },
				{ "slug": "highlight-alt", "color": "hsl(207, 65%, 36%)", "name": "Highlight Alt (Electric Sapphire 36%)" },

				{ "slug": "highlight-accent", "color": "hsl(327, 55%, 74%)", "name": "Highlight Accent (Luminescent Orchid Links)" },
				{ "slug": "highlight-accent-alt", "color": "hsl(327, 60%, 36%)", "name": "Highlight Accent Alt (Royal Orchid Links)" },

				{ "slug": "neutral", "color": "hsl(40, 18%, 94%)", "name": "Neutral (Warm Sand 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(40, 15%, 88%)", "name": "Neutral Alt (Sand 88%)" },

				{ "slug": "off-white", "color": "hsl(40, 20%, 97.5%)", "name": "Off White (Desert Alabaster 97.5%)" },
				{ "slug": "very-light-gray", "color": "hsl(40, 16%, 91.5%)", "name": "Very Light Gray (Warm Sand 91.5%)" },
				{ "slug": "light-gray", "color": "hsl(40, 14%, 84%)", "name": "Light Gray (Warm Sand 84%)" },
				{ "slug": "gray", "color": "hsl(40, 8%, 71%)", "name": "Gray (Warm Sand 71%)" },
				{ "slug": "dark-gray", "color": "hsl(40, 4%, 44%)", "name": "Dark Gray (Muted Espresso 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(40, 2%, 25%)", "name": "Very Dark Gray (Smoky Sand 25%)" },

				{ "slug": "almost-black", "color": "hsl(327, 10%, 14%)", "name": "Almost Black (Plum Carbon)" },
				{ "slug": "not-quite-black", "color": "hsl(330, 8%, 11%)", "name": "Not Quite Black (Plum Infused Carbon)" },

				{ "slug": "base", "color": "hsl(45, 27%, 97%)", "name": "Base (Off White)" },
				{ "slug": "contrast", "color": "hsl(330, 8%, 11%)", "name": "Contrast (Plum Infused Velvet)" }
			],
			"duotone": [
				{ "colors": ["hsl(327, 12%, 48%)", "hsl(45, 27%, 97%)"], "slug": "primary", "name": "Primary (Smoky Heather Velvet)" },
				{ "colors": ["hsl(327, 12%, 38%)", "hsl(45, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Deep Dusky Plum)" },
				{ "colors": ["hsl(207, 22%, 44%)", "hsl(45, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Midnight Sapphire)" },
				{ "colors": ["hsl(207, 24%, 34%)", "hsl(45, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Sapphire )" },
				{ "colors": ["hsl(0, 28%, 48%)", "hsl(45, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Deep Ruby Crimson)" },
				{ "colors": ["hsl(0, 28%, 38%)", "hsl(45, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Garnet)" },
				{ "colors": ["hsl(330, 8%, 10%)", "hsl(327, 12%, 48%)"], "slug": "midnight", "name": "Midnight Velvet" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(45, 8%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	}
}