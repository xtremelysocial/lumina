{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
    "title": "Atmos Elements: Heritage (The Professor’s Library: Deep greens and rich reds)",
	"settings": {
		"custom": {
			"color": {
				"shadow": {
					"natural": "0 2px 8px rgba(45, 35, 25, 0.20), 0 1px 3px rgba(45, 35, 25, 0.12)",
					"deep":    "0 6px 16px rgba(45, 35, 25, 0.35), 0 3px 6px rgba(45, 35, 25, 0.20)",
					"sharp":   "0 14px 30px rgba(45, 35, 25, 0.45), 0 6px 12px rgba(45, 35, 25, 0.25)",
					"crisp":   "0 24px 50px rgba(45, 35, 25, 0.55), 0 10px 20px rgba(45, 35, 25, 0.35)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(151, 22%, 53%)", "name": "Primary (Alpine Sage Core 53%)" },
				{ "slug": "primary-alt", "color": "hsl(151, 20%, 42%)", "name": "Primary Alt (Shadow Sage Action 42%)" },
				{ "slug": "secondary", "color": "hsl(208, 20%, 32%)", "name": "Secondary (Midnight Blue Core 32%)" },
				{ "slug": "secondary-alt", "color": "hsl(215, 19%, 22%)", "name": "Secondary Alt (Dark Midnight Action 22%)" },
				{ "slug": "tertiary", "color": "hsl(0, 23%, 32%)", "name": "Tertiary (Luxury Crimson Core 32%)" },
				{ "slug": "tertiary-alt", "color": "hsl(0, 23%, 22%)", "name": "Tertiary Alt (Shadow Crimson Action 22%)" },
				
				{ "slug": "primary-subtle", "color": "hsl(151, 16%, 83%)", "name": "Primary Subtle (83% Light Moss)" },
				{ "slug": "primary-subtle-alt", "color": "hsl(151, 15%, 71%)", "name": "Primary Subtle Alt (71% Sage Seam)" },
				{ "slug": "secondary-subtle", "color": "hsl(218, 15%, 83%)", "name": "Secondary Subtle (83% Sapphire Mist)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(218, 15%, 71%)", "name": "Secondary Subtle Alt (71% Tailored Slate)" },
