{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Tide (Deep water receding to expose dark, wet, glistening sand and rocks)",
	"settings": {
		"custom": {
			"color": {			
				"theme": {
					"mode": "is-dark-theme",
					"scheme": "tide"
				},
				"contrast": {
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)",
					"very-light-gray": "var(--wp--preset--color--foreground-alt)",
					"light-gray": "var(--wp--preset--color--foreground-alt)",
					"very-dark-gray": "var(--wp--preset--color--almost-black)"
				},
				"heading": {
					"text": "var(--wp--preset--color--highlight-secondary)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"hover": "var(--wp--preset--color--primary-alt)",
					"hoverOpacity": "0.85"
				},
				"highlight": "var(--wp--preset--color--highlight)",
				"shadow": {
					"natural": "0 2px 4px rgba(0, 0, 0, 0.25), 0 4px 10px rgba(0, 0, 0, 0.30)",
					"deep":    "0 3px 6px rgba(0, 0, 0, 0.30), 0 8px 18px rgba(0, 0, 0, 0.40)",
					"sharp":   "0 4px 10px rgba(0, 0, 0, 0.35), 0 12px 26px rgba(0, 0, 0, 0.48)",
					"crisp":   "0 6px 14px rgba(0, 0, 0, 0.40), 0 16px 34px rgba(0, 0, 0, 0.55)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(12, 32%, 50%)", "name": "Primary (Muted Terracotta)" },
				{ "slug": "secondary", "color": "hsl(50, 4%, 44%)", "name": "Secondary (Machine Stone Gray)" },
				{ "slug": "tertiary", "color": "hsl(37, 14%, 34%)", "name": "Tertiary (Muted Antique Bronze)" },

				{ "slug": "primary-alt", "color": "hsl(12, 32%, 58%)", "name": "Primary Alt (Warm Terracotta)" },
				{ "slug": "secondary-alt", "color": "hsl(50, 4%, 34%)", "name": "Secondary Alt (Oiled Gunmetal)" },
				{ "slug": "tertiary-alt", "color": "hsl(37, 14%, 24%)", "name": "Tertiary Alt (Dark Antique Bronze)" },

				{ "slug": "primary-subtle", "color": "hsl(211, 28%, 14%)", "name": "Primary Subtle (Deep Trench Well)" },
				{ "slug": "secondary-subtle", "color": "hsl(211, 18%, 14%)", "name": "Secondary Subtle (Maritime Blue Well)" },
				{ "slug": "tertiary-subtle", "color": "hsl(37, 8%, 14%)", "name": "Tertiary Subtle (Muted Bronze Well)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(211, 24%, 24%)", "name": "Primary Subtle Alt (Submerged Panel)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(211, 16%, 22%)", "name": "Secondary Subtle Alt (Maritime Panel Border)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(37, 8%, 20%)", "name": "Tertiary Subtle Alt (Muted Bronze Panel)" },

				{ "slug": "highlight", "color": "hsl(14, 85%, 78%)", "name": "Highlight (Glow Terracotta)" },
				{ "slug": "highlight-secondary", "color": "hsl(37, 10%, 93%)", "name": "Highlight Secondary (Sun-Bleached Sandstone)" },
				{ "slug": "highlight-tertiary", "color": "hsl(172, 75%, 76%)", "name": "Highlight Tertiary (Bioluminescent Tidefoam)" },

				{ "slug": "highlight-alt", "color": "hsl(14, 82%, 68%)", "name": "Highlight Alt (Luminous Terracotta)" },
				{ "slug": "highlight-secondary-alt", "color": "hsl(37, 20%, 80%)", "name": "Highlight Secondary Alt (Warm Sandstone Anchor)" },								
				{ "slug": "highlight-tertiary-alt", "color": "hsl(172, 65%, 46%)", "name": "Highlight Tertiary Alt (Deep Tidefoam Teal Anchor)" },

				{ "slug": "primary-dark", "color": "hsl(12, 32%, 12%)", "name": "Primary Dark (Deep Wet Terracotta Floor 12%)" },
				{ "slug": "dark", "color": "hsl(211, 20%, 10%)", "name": "Dark (Abyssal Marine Floor 10%)" },
				{ "slug": "tertiary-dark", "color": "hsl(37, 14%, 12%)", "name": "Dark Tertiary (Deep Wet Bronze Floor 12%)" },

				{ "slug": "primary-dark-alt", "color": "hsl(12, 32%, 8%)", "name": "Primary Dark Alt (Abyssal Terracotta Void 8%)" },
				{ "slug": "dark-alt", "color": "hsl(211, 25%, 6%)", "name": "Dark Alt (Abyssal Marine Void 6%)" },							
				{ "slug": "tertiary-dark-alt", "color": "hsl(37, 14%, 8%)", "name": "Dark Tertiary Alt (Abyssal Bronze Void 8%)" },

				{ "slug": "base", "color": "hsl(211, 28%, 18%)", "name": "Base (Deep Sea Slate Canvas)" },
				{ "slug": "contrast", "color": "hsl(211, 14%, 90%)", "name": "Contrast (Slate-Tinted Bone Typography)" },
				{ "slug": "foreground-alt", "color": "hsl(211, 14%, 95%)", "name": "Foreground Alt (Off White)" },

				{ "slug": "neutral", "color": "hsl(211, 25%, 21%)", "name": "Neutral (Industrial Marine Slate)" },
				{ "slug": "neutral-alt", "color": "hsl(211, 28%, 27%)", "name": "Neutral Alt (Technical Maritime Blue Border)" },

				{ "slug": "very-light-gray", "color": "hsl(211, 15%, 12%)", "name": "Very Light Gray (Inverted Deep Footer Floor 12%)" },
				{ "slug": "light-gray", "color": "hsl(211, 12%, 22%)", "name": "Light Gray (Inverted Structural Card Well 22%)" },
				{ "slug": "gray", "color": "hsl(211, 10%, 35%)", "name": "Gray (Inverted Technical Border Seam 35%)" },
				{ "slug": "dark-gray", "color": "hsl(211, 10%, 65%)", "name": "Dark Gray (Inverted Muted Typography 65%)" },
				{ "slug": "very-dark-gray", "color": "hsl(211, 12%, 85%)", "name": "Very Dark Gray (Inverted Tech Pop Typography 85%)" },
				
				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(43, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				
				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black" },

				{ "slug": "very-light-green", "color": "hsl(154, 20%, 91%)", "name": "Very Light Green (Moss Subtle 91%)" },
				{ "slug": "light-green", "color": "hsl(154, 16%, 83%)", "name": "Light Green (Moss Subtle Alt 83%)" },
				{ "slug": "green", "color": "hsl(154, 24%, 48%)", "name": "Green (Moss Primary 48%)" },
				{ "slug": "dark-green", "color": "hsl(154, 26%, 38%)", "name": "Dark Green (Moss Alt Anchor 38%)" },
				
				{ "slug": "very-light-yellow", "color": "hsl(34, 22%, 91%)", "name": "Very Light Yellow (Ochre Subtle 91%)" },
				{ "slug": "light-yellow", "color": "hsl(34, 16%, 83%)", "name": "Light Yellow (Ochre Subtle Alt 83%)" },
				{ "slug": "yellow", "color": "hsl(34, 32%, 48%)", "name": "Yellow (Ochre Primary 48%)" },
				{ "slug": "dark-yellow", "color": "hsl(34, 34%, 38%)", "name": "Dark Yellow (Ochre Alt Anchor 38%)" },

				{ "slug": "very-light-orange", "color": "hsl(22, 26%, 91%)", "name": "Very Light Orange (Flame Subtle 91%)" },
				{ "slug": "light-orange", "color": "hsl(22, 22%, 83%)", "name": "Light Orange (Flame Subtle Alt 83%)" },
				{ "slug": "orange", "color": "hsl(12, 32%, 48%)", "name": "Orange (Flame Primary 48%)" },
				{ "slug": "dark-orange", "color": "hsl(12, 32%, 38%)", "name": "Dark Orange (Flame Alt Anchor 38%)" },
				
				{ "slug": "very-light-blue", "color": "hsl(206, 24%, 91%)", "name": "Very Light Blue (Ocean Subtle 91%)" },
				{ "slug": "light-blue", "color": "hsl(206, 18%, 83%)", "name": "Light Blue (Ocean Subtle Alt 83%)" },
				{ "slug": "blue", "color": "hsl(206, 24%, 44%)", "name": "Blue (Ocean Primary 44%)" },
				{ "slug": "dark-blue", "color": "hsl(206, 26%, 34%)", "name": "Dark Blue (Ocean Alt Anchor 34%)" },
				{ "slug": "midnight-blue", "color": "hsl(208, 21%, 22%)", "name": "Midnight Blue (Lumina Balanced 22%)" },
				{ "slug": "dark-midnight-blue", "color": "hsl(209, 24%, 16%)", "name": "Dark Midnight Blue (Lumina Balanced 16%)" },
				
				{ "slug": "very-light-purple", "color": "hsl(320, 16%, 91%)", "name": "Very Light Purple (Velvet Subtle 91%)" },
				{ "slug": "light-purple", "color": "hsl(320, 12%, 83%)", "name": "Light Purple (Velvet Subtle Alt 83%)" },
				{ "slug": "purple", "color": "hsl(327, 8%, 32%)", "name": "Purple (Velvet Primary 32%)" },
				{ "slug": "dark-purple", "color": "hsl(327, 8%, 22%)", "name": "Dark Purple (Velvet Alt Anchor 22%)" },

				{ "slug": "very-light-red", "color": "hsl(6, 22%, 91%)", "name": "Very Light Red (Ember Subtle 91%)" },
				{ "slug": "light-red", "color": "hsl(6, 18%, 83%)", "name": "Light Red (Ember Subtle Alt 83%)" },
				{ "slug": "red", "color": "hsl(0, 23%, 32%)", "name": "Red (Ember Primary 32%)" },
				{ "slug": "dark-red", "color": "hsl(0, 23%, 22%)", "name": "Dark Red (Ember Alt Anchor 22%)" }				
				
			],
			"duotone": [
				{ "colors": ["hsl(12, 32%, 50%)", "hsl(211, 14%, 95%)"], "slug": "primary", "name": "Primary (Terracotta)" },
				{ "colors": ["hsl(12, 32%, 58%)", "hsl(211, 14%, 95%)"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["hsl(50, 4%, 44%)", "hsl(211, 14%, 95%)"], "slug": "secondary", "name": "Secondary (Stone Gray)" },
				{ "colors": ["hsl(50, 4%, 34%)", "hsl(211, 14%, 95%)"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["hsl(37, 14%, 34%)", "hsl(211, 14%, 95%)"], "slug": "tertiary", "name": "Tertiary (Muted Bronze)" },
				{ "colors": ["hsl(37, 14%, 24%)", "hsl(211, 14%, 95%)"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["hsl(0, 0%, 6%)", "hsl(211, 28%, 18%)"], "slug": "midnight", "name": "Abyssal Tide Void" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(50, 4%, 44%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			},
			"link": {
				"color": { 
					"text": "var:preset|color|highlight" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight" 
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|highlight"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						}
					}
				}	
			}
		}
	}
}