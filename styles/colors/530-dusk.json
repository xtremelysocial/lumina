{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Dusk (The Blue Hour: Modern, moody evening tones)",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"primary": "var(--wp--preset--color--foreground-alt)",
					"primary-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary": "var(--wp--preset--color--foreground-alt)",
					"secondary-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary": "var(--wp--preset--color--foreground-alt)",
					"tertiary-alt": "var(--wp--preset--color--foreground-alt)",
					"highlight": "var(--wp--preset--color--foreground-alt)",
					"highlight-alt": "var(--wp--preset--color--foreground-alt)",
					"dark": "var(--wp--preset--color--base)",
					"dark-alt": "var(--wp--preset--color--base)",
					"tertiary-dark": "var(--wp--preset--color--base)",
					"tertiary-dark-alt": "var(--wp--preset--color--base)"
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--tertiary)"
				},
				"button": {
					"background": "var(--wp--preset--color--tertiary)",
					"hoverOpacity": "0.85"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.45), 0 1px 3px rgba(0, 0, 0, 0.25)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.55), 0 3px 6px rgba(0, 0, 0, 0.35)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.65), 0 6px 12px rgba(0, 0, 0, 0.40)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.75), 0 10px 20px rgba(0, 0, 0, 0.50)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
