{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Dusk - The Blue Hour: Modern, moody evening tones",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "dusk"
				},
				"heading": {
					"text": "var(--wp--preset--color--dark-alt)",
					"separator": "var(--wp--preset--color--tertiary)"
				},
				"button": {
					"background": "var(--wp--preset--color--tertiary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(214, 18%, 28%)", "name": "Primary (Midnight Slate Core 28%)" },
				{ "slug": "secondary", "color": "hsl(206, 20%, 34%)", "name": "Secondary (Maritime Evening Slate 34%)" },
				{ "slug": "tertiary", "color": "hsl(12, 32%, 48%)", "name": "Tertiary (Twilight Terracotta 48%)" },

				{ "slug": "primary-subtle", "color": "hsl(204, 20%, 91%)", "name": "Primary Subtle (Whisper Sky Slate Fill 91%)" },
				{ "slug": "secondary-subtle", "color": "hsl(146, 20%, 91%)", "name": "Secondary Subtle (Whisper Sage Green Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(24, 22%, 91%)", "name": "Tertiary Subtle (Evening Glow Orange Fill 91%)" },

				{ "slug": "primary-alt", "color": "hsl(214, 18%, 18%)", "name": "Primary Alt (Deep Abyssal Action 18%)" },
				{ "slug": "secondary-alt", "color": "hsl(206, 24%, 24%)", "name": "Secondary Alt (Maritime Panel Base 24%)" },
				{ "slug": "tertiary-alt", "color": "hsl(12, 32%, 38%)", "name": "Tertiary Alt (Burnt Sienna 38%)" },

				{ "slug": "dark", "color": "hsl(206, 20%, 20%)", "name": "Dark (Secondary Maritime Footer Pair 20%)" },
				{ "slug": "dark-alt", "color": "hsl(206, 24%, 15%)", "name": "Dark Alt (Secondary Maritime Footer Deep 15%)" },

				{ "slug": "tertiary-dark", "color": "hsl(12, 32%, 22%)", "name": "Dark Tertiary (Twilight Terracotta Deep 22%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(12, 32%, 14%)", "name": "Dark Tertiary Alt (Twilight Terracotta Abyssal 14%)" },

				{ "slug": "highlight", "color": "hsl(206, 70%, 72%)", "name": "Highlight (Bioluminescent Sky Link)" },
				{ "slug": "highlight-alt", "color": "hsl(206, 55%, 34%)", "name": "Highlight Alt (Deep Maritime Accent)" },

				{ "slug": "highlight-accent", "color": "hsl(12, 65%, 70%)", "name": "Highlight Accent (Twilight Flame Link)" },				
				{ "slug": "highlight-accent-alt", "color": "hsl(12, 58%, 36%)", "name": "Highlight Accent Alt (Burnt Terracotta Accent)" },

				{ "slug": "neutral", "color": "hsl(40, 18%, 94%)", "name": "Neutral (Warm Sand Well 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(40, 15%, 88%)", "name": "Neutral Alt (Sand Border Seam 88%)" },

				{ "slug": "off-white", "color": "hsl(40, 20%, 97.5%)", "name": "Off White (Desert Alabaster Surface 97.5%)" },
				{ "slug": "very-light-gray", "color": "hsl(40, 16%, 91.5%)", "name": "Very Light Gray (Warm Sand Footer Floor 91.5%)" },
				{ "slug": "light-gray", "color": "hsl(40, 14%, 84%)", "name": "Light Gray (Warm Sand Inner Well 84%)" },
				{ "slug": "gray", "color": "hsl(40, 8%, 71%)", "name": "Gray (Warm Structural Border 71%)" },
				{ "slug": "dark-gray", "color": "hsl(40, 4%, 44%)", "name": "Dark Gray (Muted Espresso Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(40, 2%, 25%)", "name": "Very Dark Gray (Smoky Sand Shadow 25%)" },

				{ "slug": "almost-black", "color": "hsl(208, 10%, 14%)", "name": "Almost Black (Tinted Carbon Floor 14%)" },
				{ "slug": "not-quite-black", "color": "hsl(209, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" },

				{ "slug": "base", "color": "hsl(43, 27%, 97%)", "name": "Base (Light Evening Haze Canvas)" },
				{ "slug": "contrast", "color": "hsl(214, 12%, 11%)", "name": "Contrast (Midnight Indigo Typographic Ink)" }				
			],		
			"duotone": [
				{ "colors": ["hsl(214, 18%, 28%)", "hsl(43, 27%, 97%)"], "slug": "primary", "name": "Primary (Dark Midnight Blue)" },
				{ "colors": ["hsl(214, 18%, 18%)", "hsl(43, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Deep Lumina)" },
				{ "colors": ["hsl(206, 20%, 34%)", "hsl(43, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Midnight Blue)" },
				{ "colors": ["hsl(206, 24%, 24%)", "hsl(43, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Dark Midnight)" },
				{ "colors": ["hsl(12, 32%, 48%)", "hsl(43, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Twilight Orange)" },
				{ "colors": ["hsl(12, 32%, 38%)", "hsl(43, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Burnt Sienna)" },
				{ "colors": ["hsl(206, 24%, 15%)", "hsl(206, 20%, 34%)"], "slug": "midnight", "name": "Midnight Blue" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(45, 8%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]	
		}	
	}
}