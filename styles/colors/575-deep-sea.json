{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Deep Sea (Oceanic Dark: Dark midnight slate canvas with technical maritime accents)",
	"settings": {
		"custom": {
			"color": {			
				"theme": {
					"mode": "is-dark-theme",
					"scheme": "deep-sea"
				},
				"contrast": {
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)",
					"very-light-gray": "var(--wp--preset--color--foreground-alt)",
					"light-gray": "var(--wp--preset--color--foreground-alt)",
					"very-dark-gray": "var(--wp--preset--color--almost-black)"
				},
				"heading": {
					"text": "var(--wp--preset--color--highlight-secondary-alt)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"hover": "var(--wp--preset--color--primary-alt)",
					"hoverOpacity": "0.80"
				},
				"highlight": "var(--wp--preset--color--highlight)",
				"shadow": {
					"natural": "0 2px 4px rgba(0, 0, 0, 0.25), 0 4px 10px rgba(0, 0, 0, 0.30)",
					"deep":    "0 3px 6px rgba(0, 0, 0, 0.30), 0 8px 18px rgba(0, 0, 0, 0.40)",
					"sharp":   "0 4px 10px rgba(0, 0, 0, 0.35), 0 12px 26px rgba(0, 0, 0, 0.48)",
					"crisp":   "0 6px 14px rgba(0, 0, 0, 0.40), 0 16px 34px rgba(0, 0, 0, 0.55)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(195, 32%, 38%)", "name": "Primary (Glacial Deep Cyan)" },
				{ "slug": "secondary", "color": "hsl(215, 29%, 15%)", "name": "Secondary (Abyssal Navy Panel)" },
				{ "slug": "tertiary", "color": "hsl(175, 28%, 12%)", "name": "Tertiary (Submerged Maritime Trench)" },

				{ "slug": "primary-alt", "color": "hsl(195, 35%, 48%)", "name": "Primary Alt (Glacial Hover)" },			
				{ "slug": "secondary-alt", "color": "hsl(215, 28%, 20%)", "name": "Secondary Alt (Hero & CTA Canvas)" },
				{ "slug": "tertiary-alt", "color": "hsl(175, 29%, 16%)", "name": "Tertiary Alt (Deep Maritime Recess)" },		

				{ "slug": "primary-subtle", "color": "hsl(195, 26%, 16%)", "name": "Primary Subtle (Deep Cyan Fill)" },
				{ "slug": "secondary-subtle", "color": "hsl(215, 24%, 13%)", "name": "Secondary Subtle (Abyssal Navy Fill)" },
				{ "slug": "tertiary-subtle", "color": "hsl(175, 33%, 6%)", "name": "Tertiary Subtle (Maritime Trench Fill)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(195, 22%, 24%)", "name": "Primary Subtle Alt (Light Cyan Fill)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(215, 20%, 18%)", "name": "Secondary Subtle Alt (Navy Marine Layer)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(175, 33%, 9%)", "name": "Tertiary Subtle Alt (Trench Panel)" },	

				{ "slug": "highlight", "color": "hsl(195, 82%, 80%)", "name": "Highlight (Glacial Ice)" },
				{ "slug": "highlight-secondary", "color": "hsl(172, 56%, 83%)", "name": "Highlight Secondary (Bioluminescent Seafoam)" },
				{ "slug": "highlight-tertiary", "color": "hsl(38, 85%, 75%)", "name": "Highlight Tertiary (Bioluminescent Amber)" },

				{ "slug": "highlight-alt", "color": "hsl(195, 75%, 53%)", "name": "Highlight Alt (Luminous Sky Blue)" },
				{ "slug": "highlight-secondary-alt", "color": "hsl(195, 25%, 82%)", "name": "Highlight Secondary Alt (Glacial Steel Heading Anchor)" },
				{ "slug": "highlight-tertiary-alt", "color": "hsl(38, 75%, 50%)", "name": "Highlight Tertiary Alt (Deep Amber Anchor)" },

				{ "slug": "primary-dark", "color": "hsl(195, 32%, 8%)", "name": "Primary Dark (Deep Glacial Trench 8%)" },
				{ "slug": "dark", "color": "hsl(215, 35%, 6%)", "name": "Dark (Abyssal Navy Floor 6%)" },
				{ "slug": "tertiary-dark", "color": "hsl(175, 30%, 8%)", "name": "Dark Tertiary (Deep Maritime Floor 8%)" },

				{ "slug": "primary-dark-alt", "color": "hsl(195, 35%, 4%)", "name": "Primary Dark Alt (Abyssal Glacial Void 4%)" },				
				{ "slug": "dark-alt", "color": "hsl(215, 35%, 3%)", "name": "Dark Alt (Abyssal Navy Void 3%)" },							
				{ "slug": "tertiary-dark-alt", "color": "hsl(175, 30%, 4%)", "name": "Dark Tertiary Alt (Deep Maritime Void 4%)" },

				{ "slug": "base", "color": "hsl(215, 29%, 10%)", "name": "Base (Dark Deep Sea Canvas)" },
				{ "slug": "contrast", "color": "hsl(43, 27%, 97%)", "name": "Contrast (Off White Typography)" },
				{ "slug": "foreground-alt", "color": "hsl(43, 27%, 97%)", "name": "Foreground Alt (Off White)" },

				{ "slug": "neutral", "color": "hsl(215, 29%, 15%)", "name": "Neutral (Submerged Slate)" },
				{ "slug": "neutral-alt", "color": "hsl(215, 28%, 20%)", "name": "Neutral Alt (Maritime Border)" },

				{ "slug": "very-light-gray", "color": "hsl(215, 20%, 12%)", "name": "Very Light Gray (Inverted Deep Footer Floor 12%)" },
				{ "slug": "light-gray", "color": "hsl(215, 16%, 22%)", "name": "Light Gray (Inverted Structural Card Well 22%)" },
				{ "slug": "gray", "color": "hsl(215, 12%, 35%)", "name": "Gray (Inverted Technical Border Seam 35%)" },
				{ "slug": "dark-gray", "color": "hsl(215, 10%, 65%)", "name": "Dark Gray (Inverted Muted Typography 65%)" },
				{ "slug": "very-dark-gray", "color": "hsl(215, 12%, 85%)", "name": "Very Dark Gray (Inverted Tech Pop Typography 85%)" },

				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(43, 27%, 97%)", "name": "Off White" },

				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black" },

				{ "slug": "very-light-green", "color": "hsl(154, 20%, 91%)", "name": "Very Light Green (Moss Subtle 91%)" },
				{ "slug": "light-green", "color": "hsl(154, 16%, 83%)", "name": "Light Green (Moss Subtle Alt 83%)" },
				{ "slug": "green", "color": "hsl(154, 24%, 48%)", "name": "Green (Moss Primary 48%)" },
				{ "slug": "dark-green", "color": "hsl(154, 26%, 38%)", "name": "Dark Green (Moss Alt Anchor 38%)" },
				
				{ "slug": "very-light-yellow", "color": "hsl(34, 22%, 91%)", "name": "Very Light Yellow (Ochre Subtle 91%)" },
				{ "slug": "light-yellow", "color": "hsl(34, 16%, 83%)", "name": "Light Yellow (Ochre Subtle Alt 83%)" },
				{ "slug": "yellow", "color": "hsl(34, 32%, 48%)", "name": "Yellow (Ochre Primary 48%)" },
				{ "slug": "dark-yellow", "color": "hsl(34, 34%, 38%)", "name": "Dark Yellow (Ochre Alt Anchor 38%)" },

				{ "slug": "very-light-orange", "color": "hsl(22, 26%, 91%)", "name": "Very Light Orange (Flame Subtle 91%)" },
				{ "slug": "light-orange", "color": "hsl(22, 22%, 83%)", "name": "Light Orange (Flame Subtle Alt 83%)" },
				{ "slug": "orange", "color": "hsl(12, 32%, 48%)", "name": "Orange (Flame Primary 48%)" },
				{ "slug": "dark-orange", "color": "hsl(12, 32%, 38%)", "name": "Dark Orange (Flame Alt Anchor 38%)" },
				
				{ "slug": "very-light-blue", "color": "hsl(206, 24%, 91%)", "name": "Very Light Blue (Ocean Subtle 91%)" },
				{ "slug": "light-blue", "color": "hsl(206, 18%, 83%)", "name": "Light Blue (Ocean Subtle Alt 83%)" },
				{ "slug": "blue", "color": "hsl(206, 24%, 44%)", "name": "Blue (Ocean Primary 44%)" },
				{ "slug": "dark-blue", "color": "hsl(206, 26%, 34%)", "name": "Dark Blue (Ocean Alt Anchor 34%)" },
				{ "slug": "midnight-blue", "color": "hsl(208, 21%, 22%)", "name": "Midnight Blue (Lumina Balanced 22%)" },
				{ "slug": "dark-midnight-blue", "color": "hsl(209, 24%, 16%)", "name": "Dark Midnight Blue (Lumina Balanced 16%)" },
				
				{ "slug": "very-light-purple", "color": "hsl(320, 16%, 91%)", "name": "Very Light Purple (Velvet Subtle 91%)" },
				{ "slug": "light-purple", "color": "hsl(320, 12%, 83%)", "name": "Light Purple (Velvet Subtle Alt 83%)" },
				{ "slug": "purple", "color": "hsl(327, 8%, 32%)", "name": "Purple (Velvet Primary 32%)" },
				{ "slug": "dark-purple", "color": "hsl(327, 8%, 22%)", "name": "Dark Purple (Velvet Alt Anchor 22%)" },

				{ "slug": "very-light-red", "color": "hsl(6, 22%, 91%)", "name": "Very Light Red (Ember Subtle 91%)" },
				{ "slug": "light-red", "color": "hsl(6, 18%, 83%)", "name": "Light Red (Ember Subtle Alt 83%)" },
				{ "slug": "red", "color": "hsl(0, 23%, 32%)", "name": "Red (Ember Primary 32%)" },
				{ "slug": "dark-red", "color": "hsl(0, 23%, 22%)", "name": "Dark Red (Ember Alt Anchor 22%)" }		
			],
			"duotone": [
				{ "colors": ["hsl(195, 32%, 38%)", "hsl(43, 27%, 97%)"], "slug": "primary", "name": "Primary (Glacial Cyan)" },
				{ "colors": ["hsl(195, 35%, 48%)", "hsl(43, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["hsl(215, 29%, 15%)", "hsl(43, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Abyssal Navy)" },
				{ "colors": ["hsl(215, 28%, 20%)", "hsl(43, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["hsl(175, 28%, 12%)", "hsl(43, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Maritime Trench)" },
				{ "colors": ["hsl(175, 29%, 16%)", "hsl(43, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(215, 29%, 15%)", "hsl(0, 18%, 36%)"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["hsl(215, 30%, 7%)", "hsl(195, 32%, 38%)"], "slug": "midnight", "name": "Midnight" },
				{ "colors": ["hsl(0, 18%, 36%)", "hsl(33, 30%, 51%)"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(155, 16%, 46%)"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["hsl(195, 32%, 38%)", "hsl(12, 31%, 49%)"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(215, 29%, 15%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			},
			"link": {
				"color": { 
					"text": "var:preset|color|highlight" 
				},
				":hover": { 
					"color": { 
						"text": "var:preset|color|highlight" 
					} 
				},
				":active": {
					"color": { 
						"text": "var:preset|color|highlight" 
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|highlight"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						},
						":active": {
							"color": {
								"text": "var:preset|color|highlight"
							}
						}
					}
				}	
			}
		}
	}
}