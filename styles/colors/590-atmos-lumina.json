{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Elements: Lumina (Precision White: Minimalist, clean-room clarity)",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"primary": "var(--wp--preset--color--foreground-alt)",
					"primary-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary": "var(--wp--preset--color--foreground-alt)",
					"secondary-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary": "var(--wp--preset--color--foreground-alt)",
					"tertiary-alt": "var(--wp--preset--color--foreground-alt)",
					"highlight": "var(--wp--preset--color--foreground-alt)",
					"highlight-alt": "var(--wp--preset--color--foreground-alt)",
					"dark": "var(--wp--preset--color--contrast)",
					"dark-alt": "var(--wp--preset--color--contrast)"
				},
				"heading": {
					"text": "hsl(206, 30%, 12%)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.03)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.04)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.10), 0 6px 12px rgba(0, 0, 0, 0.06)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.12), 0 10px 20px rgba(0, 0, 0, 0.08)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--highlight)"
				}				
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(154, 24%, 43%)", "name": "Primary (Luminous Sage Core 43%)" },
				{ "slug": "primary-alt", "color": "hsl(154, 26%, 32%)", "name": "Primary Alt (Sage Action 32%)" },
				{ "slug": "secondary", "color": "hsl(206, 24%, 43%)", "name": "Secondary (Slate Blue Core 43%)" },
				{ "slug": "secondary-alt", "color": "hsl(206, 26%, 32%)", "name": "Secondary Alt (Slate Blue Action 32%)" },
				{ "slug": "tertiary", "color": "hsl(34, 28%, 43%)", "name": "Tertiary (Muted Gold Core 43%)" },
				{ "slug": "tertiary-alt", "color": "hsl(34, 30%, 32%)", "name": "Tertiary Alt (Muted Gold Action 32%)" },
				
				{ "slug": "primary-subtle", "color": "hsl(154, 20%, 96%)", "name": "Primary Subtle (96% Sage Veil)" },
				{ "slug": "primary-subtle-alt", "color": "hsl(154, 16%, 91%)", "name": "Primary Subtle Alt (91% Sage Border)" },
				{ "slug": "secondary-subtle", "color": "hsl(206, 20%, 96%)", "name": "Secondary Subtle (96% Sky Veil)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(206, 16%, 91%)", "name": "Secondary Subtle Alt (91% Slate Border)" },
				{ "slug": "tertiary-subtle", "color": "hsl(34, 25%, 96%)", "name": "Tertiary Subtle (96% Gold Veil)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(34, 20%, 91%)", "name": "Tertiary Subtle Alt (91% Gold Border)" },
				
				{ "slug": "base", "color": "hsl(0, 0%, 100%)", "name": "Base (Pure White)" },
				{ "slug": "contrast", "color": "hsl(0, 0%, 11%)", "name": "Contrast (Rich Carbon)" },
				{ "slug": "neutral", "color": "hsl(206, 10%, 98%)", "name": "Neutral (Cupertino Clean Fill)" },
				{ "slug": "neutral-alt", "color": "hsl(206, 12%, 93%)", "name": "Neutral Alt (Cupertino Structural Border)" },
				{ "slug": "foreground-alt", "color": "hsl(0, 0%, 100%)", "name": "Foreground Alt (White)" },
				
				{ "slug": "highlight", "color": "hsl(206, 65%, 48%)", "name": "Highlight (Clean Slate Link)" },
				{ "slug": "highlight-alt", "color": "hsl(206, 70%, 38%)", "name": "Highlight Alt (Deep Slate Hover)" },
				
				{ "slug": "dark", "color": "hsl(34, 25%, 96%)", "name": "Dark (Warm Gold Footer Floor 96%)" },
				{ "slug": "dark-alt", "color": "hsl(34, 20%, 91%)", "name": "Dark Alt (Gold Footer Base 91%)" },			
				{ "slug": "dark-secondary", "color": "hsl(206, 20%, 96%)", "name": "Dark Secondary (Slate Footer Floor 96%)" },
				{ "slug": "dark-secondary-alt", "color": "hsl(206, 16%, 91%)", "name": "Dark Secondary Alt (Slate Footer Base 91%)" },						
				
				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(45, 27%, 97%)", "name": "Off White" },
				{ "slug": "very-light-gray", "color": "hsl(206, 12%, 93%)", "name": "Very Light Gray" },
				{ "slug": "light-gray", "color": "hsl(206, 8%, 88%)", "name": "Light Gray" },
				{ "slug": "gray", "color": "hsl(206, 4%, 65%)", "name": "Gray" },
				{ "slug": "dark-gray", "color": "hsl(206, 3%, 45%)", "name": "Dark Gray" },
				{ "slug": "very-dark-gray", "color": "hsl(206, 2%, 25%)", "name": "Very Dark Gray" },
				{ "slug": "almost-black", "color": "hsl(206, 30%, 12%)", "name": "Almost Black (Deep Slate Ink)" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black" }
			],
			"duotone": [
				{ "colors": ["hsl(154, 26%, 32%)", "hsl(0, 0%, 100%)"], "slug": "primary", "name": "Primary (Luminous Sage)" },
				{ "colors": ["hsl(154, 16%, 91%)", "hsl(0, 0%, 100%)"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["hsl(206, 26%, 32%)", "hsl(0, 0%, 100%)"], "slug": "secondary", "name": "Secondary (Slate Blue)" },
				{ "colors": ["hsl(206, 16%, 91%)", "hsl(0, 0%, 100%)"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["hsl(34, 30%, 32%)", "hsl(0, 0%, 100%)"], "slug": "tertiary", "name": "Tertiary (Muted Gold)" },
				{ "colors": ["hsl(34, 20%, 91%)", "hsl(0, 0%, 100%)"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(207, 22%, 19%)", "hsl(0, 18%, 36%)"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["hsl(0, 0%, 18%)", "hsl(207, 22%, 19%)"], "slug": "midnight", "name": "Midnight Blue" },
				{ "colors": ["hsl(0, 18%, 36%)", "hsl(33, 30%, 51%)"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(155, 16%, 46%)"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["hsl(207, 22%, 19%)", "hsl(12, 31%, 49%)"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(206, 3%, 45%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		}
	}
}