{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Zinc (Industrial Prototype: Machined metal and gunmetal zinc alloy)",
	"settings": {
		"custom": {
			"color": {			
				"contrast": {
					"tertiary": "var(--wp--preset--color--base)",
					"tertiary-alt": "var(--wp--preset--color--base)",
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)",
					"very-light-gray": "var(--wp--preset--color--foreground-alt)",
					"light-gray": "var(--wp--preset--color--foreground-alt)"
				},
				"heading": {
					"text": "hsl(204, 29%, 94%)",
					"separator": "var(--wp--preset--color--highlight-alt)"
				},
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"hover": "var(--wp--preset--color--primary-alt)",
					"hoverOpacity": "0.80"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.45), 0 1px 3px rgba(0, 0, 0, 0.25)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.55), 0 3px 6px rgba(0, 0, 0, 0.35)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.65), 0 6px 12px rgba(0, 0, 0, 0.40)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.75), 0 10px 20px rgba(0, 0, 0, 0.50)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(50, 4%, 44%)", "name": "Primary (Machine Stone Gray)" },
				{ "slug": "primary-alt", "color": "hsl(50, 4%, 32%)", "name": "Primary Alt (Oiled Gunmetal Steel)" },
				{ "slug": "secondary", "color": "hsl(210, 18%, 32%)", "name": "Secondary (Midnight Industrial Blue)" },
				{ "slug": "secondary-alt", "color": "hsl(210, 18%, 22%)", "name": "Secondary Alt (Dark Midnight Steel)" },
				{ "slug": "tertiary", "color": "hsl(50, 4%, 68%)", "name": "Tertiary (Machined Silver)" },
				{ "slug": "tertiary-alt", "color": "hsl(50, 4%, 56%)", "name": "Tertiary Alt (Burnished Zinc)" },

				{ "slug": "primary-subtle", "color": "hsl(0, 0%, 14%)", "name": "Primary Subtle (Carbon Plate Fill)" },
				{ "slug": "primary-subtle-alt", "color": "hsl(0, 0%, 18%)", "name": "Primary Subtle Alt (Light Carbon)" },
				{ "slug": "secondary-subtle", "color": "hsl(210, 14%, 14%)", "name": "Secondary Subtle (Gunmetal Blue Fill)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(210, 14%, 18%)", "name": "Secondary Subtle Alt (Light Gunmetal)" },
				{ "slug": "tertiary-subtle", "color": "hsl(50, 4%, 14%)", "name": "Tertiary Subtle (Technical Stone Fill)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(50, 4%, 18%)", "name": "Tertiary Subtle Alt (Light Stone)" },

				{ "slug": "base", "color": "hsl(0, 0%, 10%)", "name": "Base (Rich Carbon Dark Canvas)" },
				{ "slug": "contrast", "color": "hsl(45, 29%, 97%)", "name": "Contrast (Off White Paper Typography)" },
				{ "slug": "neutral", "color": "hsl(0, 0%, 18%)", "name": "Neutral (Industrial Grid Fill)" },
				{ "slug": "neutral-alt", "color": "hsl(50, 4%, 14%)", "name": "Neutral Alt (Technical Structural Border)" },
				{ "slug": "foreground-alt", "color": "hsl(45, 29%, 97%)", "name": "Foreground Alt (Off White)" },

				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(45, 29%, 97%)", "name": "Off White" },

				{ "slug": "very-light-gray", "color": "hsl(50, 4%, 12%)", "name": "Very Light Gray (Inverted Deep Zinc Floor 12%)" },
				{ "slug": "light-gray", "color": "hsl(50, 4%, 20%)", "name": "Light Gray (Inverted Zinc Plate Well 20%)" },
				{ "slug": "gray", "color": "hsl(50, 4%, 35%)", "name": "Gray (Inverted Machined Border Seam 35%)" },
				{ "slug": "dark-gray", "color": "hsl(50, 4%, 65%)", "name": "Dark Gray (Inverted Muted Zinc Typography 65%)" },
				{ "slug": "very-dark-gray", "color": "hsl(50, 4%, 85%)", "name": "Very Dark Gray (Inverted Specular Pop Typography 85%)" },

				{ "slug": "highlight", "color": "hsl(189, 64%, 53%)", "name": "Highlight (Technical Aqua Link)" },
				{ "slug": "highlight-alt", "color": "hsl(189, 85%, 78%)", "name": "Highlight Alt (Glow Aqua Hover)" },
				
				{ "slug": "dark", "color": "hsl(0, 0%, 6%)", "name": "Dark (Abyssal Carbon Floor 6%)" },
				{ "slug": "dark-alt", "color": "hsl(0, 0%, 3%)", "name": "Dark Alt (Absolute Dark Void 3%)" },							
				{ "slug": "tertiary-dark", "color": "hsl(210, 15%, 12%)", "name": "Dark Tertiary (Deep Industrial Slate Floor 12%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(210, 15%, 6%)", "name": "Dark Tertiary Alt (Abyssal Industrial Slate Void 6%)" },

				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black" }
			],
			"duotone": [
				{ "colors": ["hsl(50, 4%, 44%)", "hsl(45, 29%, 97%)"], "slug": "primary", "name": "Primary (Machine Gray)" },
				{ "colors": ["hsl(50, 4%, 32%)", "hsl(45, 29%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Oiled Gunmetal)" },
				{ "colors": ["hsl(210, 18%, 32%)", "hsl(45, 29%, 97%)"], "slug": "secondary", "name": "Secondary (Midnight Blue)" },
				{ "colors": ["hsl(210, 18%, 22%)", "hsl(45, 29%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Dark Midnight)" },
				{ "colors": ["hsl(50, 4%, 68%)", "hsl(45, 29%, 97%)"], "slug": "tertiary", "name": "Tertiary (Machined Silver)" },
				{ "colors": ["hsl(50, 4%, 56%)", "hsl(45, 29%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Burnished Zinc)" },
				{ "colors": ["hsl(327, 5%, 31%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(210, 22%, 19%)", "hsl(0, 18%, 27%)"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["hsl(0, 0%, 18%)", "hsl(210, 22%, 19%)"], "slug": "midnight", "name": "Midnight Blue" },
				{ "colors": ["hsl(0, 18%, 27%)", "hsl(33, 30%, 51%)"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["hsl(327, 5%, 31%)", "hsl(155, 16%, 46%)"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["hsl(210, 22%, 19%)", "hsl(12, 31%, 49%)"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(50, 4%, 44%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			}
		}
	}
}