{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina: Ember (High Contrast: Glowing heat and deep shadows)",
	"settings": {
		"custom": {
			"color": {
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"hover": "var(--wp--preset--color--primary-alt)",
					"hoverOpacity": "0.85"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(45, 35, 25, 0.20), 0 1px 3px rgba(45, 35, 25, 0.12)",
					"deep":    "0 6px 16px rgba(45, 35, 25, 0.35), 0 3px 6px rgba(45, 35, 25, 0.20)",
					"sharp":   "0 14px 30px rgba(45, 35, 25, 0.45), 0 6px 12px rgba(45, 35, 25, 0.25)",
					"crisp":   "0 24px 50px rgba(45, 35, 25, 0.55), 0 10px 20px rgba(45, 35, 25, 0.35)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}				
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(12, 32%, 53%)", "name": "Primary (Terra Cotta Core 53%)" },
				{ "slug": "primary-alt", "color": "hsl(12, 30%, 42%)", "name": "Primary Alt (Burnt Sienna Action 42%)" },
				{ "slug": "secondary", "color": "hsl(34, 36%, 53%)", "name": "Secondary (Muted Antique Gold Core 53%)" },
				{ "slug": "secondary-alt", "color": "hsl(33, 34%, 42%)", "name": "Secondary Alt (Antique Gold Action 42%)" },
				{ "slug": "tertiary", "color": "hsl(152, 20%, 32%)", "name": "Tertiary (Deep Alpine Sage Core 32%)" },
				{ "slug": "tertiary-alt", "color": "hsl(151, 18%, 22%)", "name": "Tertiary Alt (Deep Shadow Sage Action 22%)" },
				
				{ "slug": "primary-subtle", "color": "hsl(26, 22%, 91%)", "name": "Primary Subtle (Whisper Orange Fill 91%)" },
				{ "slug": "primary-subtle-alt", "color": "hsl(26, 16%, 83%)", "name": "Primary Subtle Alt (Orange Panel Border 83%)" },
				{ "slug": "secondary-subtle", "color": "hsl(44, 20%, 91%)", "name": "Secondary Subtle (Whisper Gold Fill 91%)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(44, 14%, 83%)", "name": "Secondary Subtle Alt (Gold Border 83%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(146, 14%, 91%)", "name": "Tertiary Subtle (Whisper Sage Fill 91%)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(146, 10%, 83%)", "name": "Tertiary Subtle Alt (Sage Seam 83%)" },
				
				{ "slug": "base", "color": "hsl(45, 27%, 97%)", "name": "Base (Off White Canvas)" },
				{ "slug": "contrast", "color": "hsl(0, 0%, 11%)", "name": "Contrast (Not Quite Black)" },
				{ "slug": "neutral", "color": "hsl(45, 14%, 96%)", "name": "Neutral (Custom Muted Off-White Component Well 96%)" },
				{ "slug": "neutral-alt", "color": "hsl(45, 10%, 88%)", "name": "Neutral Alt (Component Border Seam 88%)" },
				{ "slug": "foreground-alt", "color": "hsl(45, 27%, 97%)", "name": "Foreground Alt (Off White)" },
				
				{ "slug": "highlight", "color": "hsl(12, 88%, 62%)", "name": "Highlight (Blazing Ember Hover/Pop 62%)" },
				{ "slug": "highlight-alt", "color": "hsl(12, 76%, 38%)", "name": "Highlight Alt (Deep Volcanic Link Anchor 38%)" },
				
				{ "slug": "dark", "color": "hsl(11, 28%, 16%)", "name": "Dark (Deep Obsidian Heading 16%)" },
				{ "slug": "dark-alt", "color": "hsl(11, 28%, 10%)", "name": "Dark Alt (Classic Volcanic Ink Floor 10%)" },							
				{ "slug": "tertiary-dark", "color": "hsl(33, 30%, 16%)", "name": "Dark Tertiary (Bronze Clay Heading 16%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(33, 30%, 10%)", "name": "Dark Tertiary Alt (Bronze Clay Footer 10%)" },						
				
				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(45, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "hsl(45, 14%, 91%)", "name": "Very Light Gray (Warm Linen Paper 91%)" },
				{ "slug": "light-gray", "color": "hsl(45, 12%, 83%)", "name": "Light Gray (Warm Linen Well 83%)" },
				{ "slug": "gray", "color": "hsl(45, 8%, 71%)", "name": "Gray (Warm Sand Border Seam 71%)" },
				{ "slug": "dark-gray", "color": "hsl(50, 3%, 43%)", "name": "Dark Gray (Stone)" },
				{ "slug": "very-dark-gray", "color": "hsl(60, 2%, 23%)", "name": "Very Dark Gray (Muted Obsidian)" },
				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black (Carbon)" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black (Rich Carbon)" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black (True Black)" }
			],
			"duotone": [
				{ "colors": ["hsl(12, 30%, 42%)", "hsl(45, 27%, 97%)"], "slug": "primary", "name": "Primary (Orange)" },
				{ "colors": ["hsl(11, 28%, 16%)", "hsl(45, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Dark Orange)" },
				{ "colors": ["hsl(34, 36%, 53%)", "hsl(45, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Muted Gold)" },
				{ "colors": ["hsl(33, 34%, 42%)", "hsl(45, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Antique Gold)" },
				{ "colors": ["hsl(152, 20%, 32%)", "hsl(45, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Deep Alpine Sage)" },
				{ "colors": ["hsl(151, 18%, 22%)", "hsl(45, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Deep Shadow Sage)" },
				{ "colors": ["hsl(11, 28%, 10%)", "hsl(12, 32%, 53%)"], "slug": "midnight", "name": "Midnight Blue" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(50, 3%, 43%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]		
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		}
	}	
}