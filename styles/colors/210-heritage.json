{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Heritage - The Professor’s Library: Patina crimson, burnished brass, and ocean blue",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "heritage"
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--secondary)"
				},
				"highlight-alt": {
					"lighten": "brightness(1.8) saturate(0.8)"
				}
			}
		},	
		"color": {
			"palette": [			
				{ "slug": "primary", "color": "hsl(0, 18%, 34%)", "name": "Primary (Patina Crimson Core 34%)" },
				{ "slug": "secondary", "color": "hsl(38, 38%, 40%)", "name": "Secondary (Aged Brass Core 40%)" },
				{ "slug": "tertiary", "color": "hsl(208, 22%, 30%)", "name": "Tertiary (Midnight Blue Core 30%)" },

				{ "slug": "primary-subtle", "color": "hsl(14, 22%, 92%)", "name": "Primary Subtle (Warm Terracotta Linen 92%)" },
				{ "slug": "secondary-subtle", "color": "hsl(38, 20%, 91%)", "name": "Secondary Subtle (Whisper Brass Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(208, 20%, 91%)", "name": "Tertiary Subtle (Whisper Midnight Slate 91%)" },

				{ "slug": "primary-alt", "color": "hsl(0, 18%, 24%)", "name": "Primary Alt (Shadow Crimson Action 24%)" },
				{ "slug": "secondary-alt", "color": "hsl(38, 40%, 30%)", "name": "Secondary Alt (Burnished Brass Action 30%)" },
				{ "slug": "tertiary-alt", "color": "hsl(208, 24%, 20%)", "name": "Tertiary Alt (Abyssal Midnight Action 20%)" },

				{ "slug": "dark", "color": "hsl(38, 30%, 22%)", "name": "Dark (Secondary Aged Brass Footer Pair 22%)" },
				{ "slug": "dark-alt", "color": "hsl(38, 32%, 14%)", "name": "Dark Alt (Abyssal Brass Footer Deep 14%)" },

				{ "slug": "tertiary-dark", "color": "hsl(208, 21%, 22%)", "name": "Dark Tertiary (Lumina Midnight Floor 22%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(209, 24%, 16%)", "name": "Dark Tertiary Alt (Abyssal Midnight Deep 16%)" },			

				{ "slug": "highlight", "color": "hsl(0, 32%, 78%)", "name": "Highlight (Patina Rose Glow)" },
				{ "slug": "highlight-alt", "color": "hsl(0, 26%, 36%)", "name": "Highlight Alt (Muted Patina Crimson Link)" },

				{ "slug": "highlight-accent", "color": "hsl(206, 80%, 72%)", "name": "Highlight Accent (Luminescent Sky Glow)" },
				{ "slug": "highlight-accent-alt", "color": "hsl(206, 65%, 36%)", "name": "Highlight Accent Alt (Deep Sky Link Ink)" },

				{ "slug": "neutral", "color": "hsl(45, 14%, 94%)", "name": "Neutral (Custom Muted Off-White Component Well 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(45, 10%, 87%)", "name": "Neutral Alt (Component Border Seam 87%)" },

				{ "slug": "off-white", "color": "hsl(45, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "hsl(45, 14%, 91%)", "name": "Very Light Gray (Warm Linen Paper 91%)" },
				{ "slug": "light-gray", "color": "hsl(45, 12%, 83%)", "name": "Light Gray (Warm Linen Well 83%)" },
				{ "slug": "gray", "color": "hsl(45, 8%, 71%)", "name": "Gray (Warm Sand Border Seam 71%)" },
				{ "slug": "dark-gray", "color": "hsl(45, 4%, 44%)", "name": "Dark Gray (Muted Sand Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(45, 2%, 25%)", "name": "Very Dark Gray (Warm Obsidian Shadow 25%)" },
				{ "slug": "almost-black", "color": "hsl(208, 18%, 18%)", "name": "Almost Black (Tinted Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(209, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" },

				{ "slug": "base", "color": "hsl(40, 25%, 96%)", "name": "Base (Warm Parchment Canvas)" },
				{ "slug": "contrast", "color": "hsl(15, 18%, 11%)", "name": "Contrast (Mahogany Infused Ink)" }
			],
			"duotone": [
				{ "colors": ["hsl(0, 18%, 34%)", "hsl(40, 25%, 96%)"], "slug": "primary", "name": "Primary (Patina Crimson)" },
				{ "colors": ["hsl(0, 18%, 24%)", "hsl(40, 25%, 96%)"], "slug": "primary-alt", "name": "Primary Alt (Shadow Crimson)" },
				{ "colors": ["hsl(38, 38%, 40%)", "hsl(40, 25%, 96%)"], "slug": "secondary", "name": "Secondary (Aged Brass)" },
				{ "colors": ["hsl(38, 40%, 30%)", "hsl(40, 25%, 96%)"], "slug": "secondary-alt", "name": "Secondary Alt (Burnished Brass)" },
				{ "colors": ["hsl(208, 22%, 30%)", "hsl(40, 25%, 96%)"], "slug": "tertiary", "name": "Tertiary (Midnight Blue)" },
				{ "colors": ["hsl(208, 24%, 20%)", "hsl(40, 25%, 96%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Abyssal Midnight)" },
				{ "colors": ["hsl(0, 18%, 24%)", "hsl(38, 38%, 40%)"], "slug": "midnight", "name": "Crimson & Brass" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 11%)", "hsl(45, 8%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]		
		}
	}
}