{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Heritage - The Professor’s Library: Patina crimson, burnished brass, and oxford navy",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "heritage"
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--secondary)"
				}
			}
		},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(0, 23%, 32%)", "name": "Primary (Patina Crimson Core 32%)" },
				{ "slug": "secondary", "color": "hsl(38, 38%, 40%)", "name": "Secondary (Aged Brass Core 40%)" },
				{ "slug": "tertiary", "color": "hsl(215, 25%, 24%)", "name": "Tertiary (Oxford Navy Core 24%)" },

				{ "slug": "base", "color": "hsl(40, 25%, 96%)", "name": "Base (Warm Parchment Canvas)" },
				{ "slug": "neutral", "color": "hsl(45, 14%, 94%)", "name": "Neutral (Custom Muted Off-White Component Well 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(45, 10%, 87%)", "name": "Neutral Alt (Component Border Seam 87%)" },

				{ "slug": "primary-alt", "color": "hsl(0, 23%, 22%)", "name": "Primary Alt (Shadow Crimson Action 22%)" },
				{ "slug": "secondary-alt", "color": "hsl(38, 40%, 30%)", "name": "Secondary Alt (Burnished Brass Action 30%)" },
				{ "slug": "tertiary-alt", "color": "hsl(215, 28%, 18%)", "name": "Tertiary Alt (Midnight Oxford Action 18%)" },

				{ "slug": "primary-subtle", "color": "hsl(215, 14%, 92%)", "name": "Primary Subtle (Whisper Oxford Slate Fill 92%)" },
				{ "slug": "secondary-subtle", "color": "hsl(38, 18%, 91%)", "name": "Secondary Subtle (Whisper Amber Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(154, 14%, 91%)", "name": "Tertiary Subtle (Vintage Desk Felt Green 91%)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(215, 10%, 84%)", "name": "Primary Subtle Alt (Oxford Border 84%)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(38, 14%, 83%)", "name": "Secondary Subtle Alt (Brass Border 83%)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(154, 10%, 83%)", "name": "Tertiary Subtle Alt (Desk Felt Border 83%)" },

				{ "slug": "highlight", "color": "hsl(6, 70%, 82%)", "name": "Highlight (Patina Coral Glow - Dark BGs 82%)" },
				{ "slug": "highlight-secondary", "color": "hsl(38, 75%, 76%)", "name": "Highlight Secondary (Gilded Amber Glow 76%)" },
				{ "slug": "highlight-tertiary", "color": "hsl(215, 65%, 78%)", "name": "Highlight Tertiary (Oxford Sky Glow 78%)" },

				{ "slug": "highlight-alt", "color": "hsl(0, 62%, 40%)", "name": "Highlight Alt (Patina Crimson Link 40%)" },
				{ "slug": "highlight-secondary-alt", "color": "hsl(32, 65%, 34%)", "name": "Highlight Secondary Alt (Warm Copper Link 34%)" },
				{ "slug": "highlight-tertiary-alt", "color": "hsl(215, 60%, 34%)", "name": "Highlight Tertiary Alt (Vivid Oxford Link 34%)" },

				{ "slug": "primary-dark", "color": "hsl(0, 32%, 18%)", "name": "Primary Dark (Deep Crimson Floor)" },
				{ "slug": "dark", "color": "hsl(38, 30%, 16%)", "name": "Dark (Secondary Aged Brass Footer Pair)" },
				{ "slug": "tertiary-dark", "color": "hsl(215, 25%, 16%)", "name": "Dark Tertiary (Deep Oxford Navy Floor)" },

				{ "slug": "primary-dark-alt", "color": "hsl(0, 35%, 11%)", "name": "Primary Dark Alt (Abyssal Crimson Void)" },
				{ "slug": "dark-alt", "color": "hsl(38, 32%, 10%)", "name": "Dark Alt (Abyssal Brass Footer Deep)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(215, 28%, 11%)", "name": "Dark Tertiary Alt (Abyssal Navy Void)" },

				{ "slug": "off-white", "color": "hsl(45, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "hsl(45, 14%, 91%)", "name": "Very Light Gray (Warm Linen Paper 91%)" },
				{ "slug": "light-gray", "color": "hsl(45, 12%, 83%)", "name": "Light Gray (Warm Linen Well 83%)" },
				{ "slug": "gray", "color": "hsl(45, 8%, 71%)", "name": "Gray (Warm Sand Border Seam 71%)" },
				{ "slug": "dark-gray", "color": "hsl(45, 4%, 44%)", "name": "Dark Gray (Muted Sand Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(45, 2%, 25%)", "name": "Very Dark Gray (Warm Obsidian Shadow 25%)" },

				{ "slug": "contrast", "color": "hsl(15, 18%, 11%)", "name": "Contrast (Mahogany Infused Ink)" },
				{ "slug": "almost-black", "color": "hsl(208, 18%, 18%)", "name": "Almost Black (Tinted Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(209, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" }
			],
			"duotone": [
				{ "colors": ["hsl(0, 23%, 32%)", "hsl(40, 25%, 96%)"], "slug": "primary", "name": "Primary (Luxury Crimson)" },
				{ "colors": ["hsl(0, 23%, 22%)", "hsl(40, 25%, 96%)"], "slug": "primary-alt", "name": "Primary Alt (Shadow Crimson)" },
				{ "colors": ["hsl(38, 38%, 40%)", "hsl(40, 25%, 96%)"], "slug": "secondary", "name": "Secondary (Aged Brass)" },
				{ "colors": ["hsl(38, 40%, 30%)", "hsl(40, 25%, 96%)"], "slug": "secondary-alt", "name": "Secondary Alt (Burnished Brass)" },
				{ "colors": ["hsl(215, 25%, 24%)", "hsl(40, 25%, 96%)"], "slug": "tertiary", "name": "Tertiary (Oxford Navy)" },
				{ "colors": ["hsl(215, 28%, 18%)", "hsl(40, 25%, 96%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Midnight Oxford)" },
				{ "colors": ["hsl(0, 23%, 22%)", "hsl(38, 38%, 40%)"], "slug": "midnight", "name": "Crimson & Brass" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(45, 8%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]		
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			}
		}
	}
}