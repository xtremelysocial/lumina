{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Sol (Ocean, Gold, Dune) - The Golden Hour: Sun-drenched maritime earth tones",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "sol"
				},
				"heading": {
					"text": "var(--wp--preset--color--dark)",
					"separator": "var(--wp--preset--color--secondary)"
				},
				"highlight-alt": {
					"lighten": "brightness(1.7) saturate(0.8)"
				}				
			}
		},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(206, 24%, 44%)", "name": "Primary (Ocean Blue 44%)" },
				{ "slug": "secondary", "color": "hsl(34, 32%, 48%)", "name": "Secondary (Antique Gold 48%)" },
				{ "slug": "tertiary", "color": "hsl(38, 28%, 42%)", "name": "Tertiary (Dune Bronze 42%)" },

				{ "slug": "primary-subtle", "color": "hsl(206, 24%, 91%)", "name": "Primary Subtle (Whisper Sky Fill 91%)" },
				{ "slug": "secondary-subtle", "color": "hsl(34, 22%, 91%)", "name": "Secondary Subtle (Whisper Gold Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(38, 20%, 91%)", "name": "Tertiary Subtle (Whisper Dune Fill 91%)" },

				{ "slug": "primary-alt", "color": "hsl(206, 26%, 34%)", "name": "Primary Alt (Storm Navy 34%)" },
				{ "slug": "secondary-alt", "color": "hsl(34, 34%, 38%)", "name": "Secondary Alt (Burnished Ochre 38%)" },
				{ "slug": "tertiary-alt", "color": "hsl(38, 30%, 32%)", "name": "Tertiary Alt (Deep Dune Bronze 32%)" },

				{ "slug": "dark", "color": "hsl(34, 34%, 22%)", "name": "Dark (Antique Gold Deep Footer 22%)" },
				{ "slug": "dark-alt", "color": "hsl(34, 34%, 14%)", "name": "Dark Alt (Antique Gold Abyssal 14%)" },				

				{ "slug": "tertiary-dark", "color": "hsl(38, 28%, 28%)", "name": "Dark Tertiary (Warm Dune Bronze Band 28%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(38, 30%, 20%)", "name": "Dark Tertiary Alt (Deep Dune Bronze Floor 20%)" },

				{ "slug": "highlight", "color": "hsl(206, 80%, 72%)", "name": "Highlight (Luminescent Sky Glow for Dark Cards)" },
				{ "slug": "highlight-alt", "color": "hsl(206, 65%, 36%)", "name": "Highlight Alt (Deep Sky Primary Link Ink)" },

				{ "slug": "highlight-accent", "color": "hsl(34, 80%, 72%)", "name": "Highlight Accent (Luminescent Ochre for Dark Cards)" },
				{ "slug": "highlight-accent-alt", "color": "hsl(34, 65%, 36%)", "name": "Highlight Accent Alt (Deep Ochre Alternate Link Ink)" },

				{ "slug": "neutral", "color": "hsl(45, 14%, 94%)", "name": "Neutral (Custom Muted Off-White Component Well 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(45, 10%, 87%)", "name": "Neutral Alt (Component Border Seam 87%)" },
								
				{ "slug": "off-white", "color": "hsl(45, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "hsl(45, 14%, 91%)", "name": "Very Light Gray (Warm Linen Paper 91%)" },
				{ "slug": "light-gray", "color": "hsl(45, 12%, 83%)", "name": "Light Gray (Warm Linen Well 83%)" },
				{ "slug": "gray", "color": "hsl(45, 8%, 71%)", "name": "Gray (Warm Sand Border Seam 71%)" },
				{ "slug": "dark-gray", "color": "hsl(45, 4%, 44%)", "name": "Dark Gray (Muted Sand Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(45, 2%, 25%)", "name": "Very Dark Gray (Warm Obsidian Shadow 25%)" },

				{ "slug": "almost-black", "color": "hsl(34, 18%, 18%)", "name": "Almost Black (Tinted Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(34, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" },

				{ "slug": "base", "color": "hsl(45, 27%, 97%)", "name": "Base (Off White Canvas)" },
				{ "slug": "contrast", "color": "hsl(214, 12%, 11%)", "name": "Contrast (Midnight Indigo Typographic Ink)" }
			],
			"duotone": [
				{ "colors": ["hsl(206, 24%, 44%)", "hsl(45, 27%, 97%)"], "slug": "primary", "name": "Primary (Ocean Blue)" },
				{ "colors": ["hsl(206, 26%, 34%)", "hsl(45, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Storm Navy)" },
				{ "colors": ["hsl(34, 32%, 48%)", "hsl(45, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Antique Gold)" },
				{ "colors": ["hsl(34, 34%, 38%)", "hsl(45, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Burnished Ochre)" },
				{ "colors": ["hsl(38, 28%, 42%)", "hsl(45, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Dune Bronze)" },
				{ "colors": ["hsl(38, 30%, 32%)", "hsl(45, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Deep Dune Bronze)" },
				{ "colors": ["hsl(34, 34%, 14%)", "hsl(34, 32%, 48%)"], "slug": "midnight", "name": "Midnight Gold" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 11%)", "hsl(45, 8%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]		
		}
	}
}