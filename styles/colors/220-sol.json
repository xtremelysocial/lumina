{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Sol (Ocean, Gold, Sage) - The Golden Hour: Sun-drenched maritime earth tones",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "heritage-blue"
				},
				"heading": {
					"text": "var(--wp--preset--color--dark)",
					"separator": "var(--wp--preset--color--primary)"
				}
			}
		},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(206, 24%, 44%)", "name": "Primary (Ocean Blue 44%)" },
				{ "slug": "secondary", "color": "hsl(34, 32%, 48%)", "name": "Secondary (Antique Gold 48%)" },
				{ "slug": "tertiary", "color": "hsl(154, 24%, 48%)", "name": "Tertiary (Crisp Sage 48%)" },

				{ "slug": "base", "color": "hsl(45, 27%, 97%)", "name": "Base (Off White Canvas)" },
				{ "slug": "neutral", "color": "hsl(45, 14%, 94%)", "name": "Neutral (Custom Muted Off-White Component Well 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(45, 10%, 87%)", "name": "Neutral Alt (Component Border Seam 87%)" },

				{ "slug": "primary-alt", "color": "hsl(206, 26%, 34%)", "name": "Primary Alt (Storm Navy 34%)" },
				{ "slug": "secondary-alt", "color": "hsl(34, 34%, 38%)", "name": "Secondary Alt (Burnished Ochre 38%)" },
				{ "slug": "tertiary-alt", "color": "hsl(154, 26%, 38%)", "name": "Tertiary Alt (Deep Alpine Sage 38%)" },
				
				{ "slug": "primary-subtle", "color": "hsl(206, 24%, 91%)", "name": "Primary Subtle (Whisper Sky Fill 91%)" },
				{ "slug": "secondary-subtle", "color": "hsl(34, 22%, 91%)", "name": "Secondary Subtle (Whisper Gold Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(154, 20%, 91%)", "name": "Tertiary Subtle (Whisper Sage Fill 91%)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(206, 18%, 83%)", "name": "Primary Subtle Alt (Sky Border Seam 83%)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(34, 16%, 83%)", "name": "Secondary Subtle Alt (Gold Border 83%)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(154, 16%, 83%)", "name": "Tertiary Subtle Alt (Sage Seam 83%)" },
				
				{ "slug": "highlight", "color": "hsl(206, 80%, 72%)", "name": "Highlight (Luminescent Sky Hover)" },
				{ "slug": "highlight-secondary", "color": "hsl(34, 80%, 72%)", "name": "Highlight Secondary (Luminescent Ochre)" },
				{ "slug": "highlight-tertiary", "color": "hsl(154, 65%, 68%)", "name": "Highlight Tertiary (Electric Sage)" },
				
				{ "slug": "highlight-alt", "color": "hsl(206, 65%, 36%)", "name": "Highlight Alt (Deep Sky Link Ink)" },
				{ "slug": "highlight-secondary-alt", "color": "hsl(34, 65%, 36%)", "name": "Highlight Secondary Alt (Deep Ochre Link)" },
				{ "slug": "highlight-tertiary-alt", "color": "hsl(154, 75%, 28%)", "name": "Highlight Tertiary Alt (Vivid Pine Link)" },

				{ "slug": "primary-dark", "color": "hsl(208, 21%, 22%)", "name": "Primary Dark (Ocean Midnight 22%)" },
				{ "slug": "dark", "color": "hsl(34, 34%, 22%)", "name": "Dark (Antique Gold Deep Footer 22%)" },
				{ "slug": "tertiary-dark", "color": "hsl(170, 45%, 20%)", "name": "Dark Tertiary (Deep Forest Sage 20%)" },

				{ "slug": "primary-dark-alt", "color": "hsl(209, 24%, 16%)", "name": "Primary Dark Alt (Ocean Midnight Deep 16%)" },
				{ "slug": "dark-alt", "color": "hsl(34, 34%, 14%)", "name": "Dark Alt (Antique Gold Abyssal 14%)" },				
				{ "slug": "tertiary-dark-alt", "color": "hsl(170, 50%, 15%)", "name": "Dark Tertiary Alt (Rich Hero Green 15%)" },
								
				{ "slug": "off-white", "color": "hsl(45, 27%, 97%)", "name": "Off White (Gallery Bone)" },
				{ "slug": "very-light-gray", "color": "hsl(45, 14%, 91%)", "name": "Very Light Gray (Warm Linen Paper 91%)" },
				{ "slug": "light-gray", "color": "hsl(45, 12%, 83%)", "name": "Light Gray (Warm Linen Well 83%)" },
				{ "slug": "gray", "color": "hsl(45, 8%, 71%)", "name": "Gray (Warm Sand Border Seam 71%)" },
				{ "slug": "dark-gray", "color": "hsl(45, 4%, 44%)", "name": "Dark Gray (Muted Sand Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(45, 2%, 25%)", "name": "Very Dark Gray (Warm Obsidian Shadow 25%)" },

				{ "slug": "contrast", "color": "hsl(214, 12%, 11%)", "name": "Contrast (Midnight Indigo Typographic Ink)" },
				{ "slug": "almost-black", "color": "hsl(34, 18%, 18%)", "name": "Almost Black (Tinted Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(34, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" }
			],
			"duotone": [
				{ "colors": ["hsl(206, 24%, 44%)", "hsl(45, 27%, 97%)"], "slug": "primary", "name": "Primary (Ocean Blue)" },
				{ "colors": ["hsl(206, 26%, 34%)", "hsl(45, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Storm Navy)" },
				{ "colors": ["hsl(34, 32%, 48%)", "hsl(45, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Antique Gold)" },
				{ "colors": ["hsl(34, 34%, 38%)", "hsl(45, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Burnished Ochre)" },
				{ "colors": ["hsl(154, 24%, 48%)", "hsl(45, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Crisp Sage)" },
				{ "colors": ["hsl(154, 26%, 38%)", "hsl(45, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Deep Alpine Sage)" },
				{ "colors": ["hsl(209, 24%, 16%)", "hsl(34, 32%, 48%)"], "slug": "midnight", "name": "Midnight Gold" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 11%)", "hsl(45, 8%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]		
		}	
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			}
		}
	}
}