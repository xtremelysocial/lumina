{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Ember - Glowing Heat: Terracotta, Gold & Volcanic Umber",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "ember"
				},
				"button": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--off-white)"
				},
				"heading": { 
					"text": "var(--wp--preset--color--dark-alt)", 
					"separator": "var(--wp--preset--color--secondary)"
				},
				"highlight-alt": {
				  "lighten": "brightness(1.7) saturate(0.6)"
				},
				"link": {
					"hoverOpacity": "0.75" 
				}						
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(12, 32%, 48%)", "name": "Primary (Terra Cotta Core 48%)" },
				{ "slug": "secondary", "color": "hsl(34, 32%, 48%)", "name": "Secondary (Muted Antique Gold Core 48%)" },
				{ "slug": "tertiary", "color": "hsl(18, 28%, 42%)", "name": "Tertiary (Volcanic Umber Core 42%)" },

				{ "slug": "primary-subtle", "color": "hsl(26, 22%, 91%)", "name": "Primary Subtle (Whisper Terracotta Fill 91%)" },
				{ "slug": "secondary-subtle", "color": "hsl(44, 20%, 91%)", "name": "Secondary Subtle (Whisper Gold Fill 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(18, 18%, 91%)", "name": "Tertiary Subtle (Whisper Volcanic Wash 91%)" },

				{ "slug": "primary-alt", "color": "hsl(12, 32%, 38%)", "name": "Primary Alt (Burnt Sienna Action 38%)" },
				{ "slug": "secondary-alt", "color": "hsl(34, 34%, 38%)", "name": "Secondary Alt (Burnished Ochre Action 38%)" },
				{ "slug": "tertiary-alt", "color": "hsl(18, 30%, 32%)", "name": "Tertiary Alt (Volcanic Charcoal Action 32%)" },
				
				{ "slug": "dark", "color": "hsl(34, 34%, 22%)", "name": "Dark (Bronze Clay Heading 22%)" },
				{ "slug": "dark-alt", "color": "hsl(34, 34%, 14%)", "name": "Dark Alt (Bronze Clay Footer Deep 14%)" },							

				{ "slug": "tertiary-dark", "color": "hsl(18, 28%, 28%)", "name": "Dark Tertiary (Warm Volcanic Clay Band 28%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(18, 30%, 20%)", "name": "Dark Tertiary Alt (Deep Volcanic Floor 20%)" },

				{ "slug": "highlight", "color": "hsl(12, 75%, 68%)", "name": "Highlight Alt (Warm Coral Glow for Dark Cards)" },
				{ "slug": "highlight-alt", "color": "hsl(12, 75%, 36%)", "name": "Highlight (Deep Volcanic Primary Link Ink)" },

				{ "slug": "highlight-accent", "color": "hsl(34, 80%, 72%)", "name": "Highlight Accent (Luminescent Ochre for Dark Cards)" },
				{ "slug": "highlight-accent-alt", "color": "hsl(34, 65%, 36%)", "name": "Highlight Accent Alt (Deep Ochre Alternate Link Ink)" },
				
				{ "slug": "neutral", "color": "hsl(40, 18%, 94%)", "name": "Neutral (Warm Sand Well 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(40, 15%, 88%)", "name": "Neutral Alt (Sand Border Seam 88%)" },

				{ "slug": "off-white", "color": "hsl(40, 20%, 97.5%)", "name": "Off White (Desert Alabaster Surface 97.5%)" },
				{ "slug": "very-light-gray", "color": "hsl(40, 16%, 91.5%)", "name": "Very Light Gray (Warm Sand Footer Floor 91.5%)" },
				{ "slug": "light-gray", "color": "hsl(40, 14%, 84%)", "name": "Light Gray (Warm Sand Inner Well 84%)" },
				{ "slug": "gray", "color": "hsl(40, 8%, 71%)", "name": "Gray (Warm Structural Border 71%)" },
				{ "slug": "dark-gray", "color": "hsl(40, 4%, 44%)", "name": "Dark Gray (Muted Espresso Typography 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(40, 2%, 25%)", "name": "Very Dark Gray (Smoky Sand Shadow 25%)" },

				{ "slug": "almost-black", "color": "hsl(34, 18%, 18%)", "name": "Almost Black (Tinted Carbon Floor)" },
				{ "slug": "not-quite-black", "color": "hsl(34, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Ink)" },

				{ "slug": "base", "color": "hsl(45, 27%, 97%)", "name": "Base (Off White Canvas)" },
				{ "slug": "contrast", "color": "hsl(34, 15%, 11%)", "name": "Contrast (Rich Tinted Ink)" }
			],
			"duotone": [
				{ "colors": ["hsl(12, 32%, 48%)", "hsl(45, 27%, 97%)"], "slug": "primary", "name": "Primary (Terra Cotta)" },
				{ "colors": ["hsl(12, 32%, 38%)", "hsl(45, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Burnt Sienna)" },
				{ "colors": ["hsl(34, 32%, 48%)", "hsl(45, 27%, 97%)"], "slug": "secondary", "name": "Secondary (Muted Gold)" },
				{ "colors": ["hsl(34, 34%, 38%)", "hsl(45, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Burnished Ochre)" },
				{ "colors": ["hsl(18, 28%, 42%)", "hsl(45, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary (Volcanic Umber)" },
				{ "colors": ["hsl(18, 30%, 32%)", "hsl(45, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Volcanic Charcoal)" },
				{ "colors": ["hsl(34, 34%, 14%)", "hsl(34, 32%, 48%)"], "slug": "midnight", "name": "Volcanic Gold" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(50, 3%, 43%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]		
		}
	}
}