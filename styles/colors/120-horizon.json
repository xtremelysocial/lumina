{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Horizon - Earth & Sea: Coastal Terracotta, Ocean Blue, and Golden Sun",
	"description": "A refined modern theme inspired by warm clay, ocean depth, and ambient gold light, featuring subtle animation on actionable elements",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"scheme": 	"Horizon",
					"mode": 	"is-light-theme"
				},
				"border": 			"color-mix(in srgb, currentColor 15%, transparent)",
				"divider": 			"color-mix(in srgb, currentColor 18%, transparent)",
				"button": {
					"background": 	"var(--wp--preset--color--primary)",
					"text": 		"var(--wp--preset--color--off-white)"
				},
				"navigation": {
					"highlight":    "var(--wp--preset--color--highlight-alt)"
				},
				"highlight-alt": {
					"lighten": "brightness(1.85) saturate(0.85)"
				},
				"link": {
					"hoverOpacity": "0.75"
				},
				"heading": {
					"text": 		"var(--wp--preset--color--contrast)",
					"separator": 	"var(--wp--preset--color--tertiary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(18, 38%, 48%)", "name": "Primary (Coastal Terracotta 48%)" },
				{ "slug": "secondary", "color": "hsl(206, 24%, 44%)", "name": "Secondary (Ocean Blue 44%)" },
				{ "slug": "tertiary", "color": "hsl(34, 32%, 48%)", "name": "Tertiary (Antique Gold 48%)" },

				{ "slug": "primary-subtle", "color": "hsl(18, 28%, 91%)", "name": "Primary Subtle (Whisper Clay 91%)" },
				{ "slug": "secondary-subtle", "color": "hsl(206, 24%, 91%)", "name": "Secondary Subtle (Whisper Sky 91%)" },
				{ "slug": "tertiary-subtle", "color": "hsl(34, 22%, 91%)", "name": "Tertiary Subtle (Whisper Parchment 91%)" },

				{ "slug": "primary-subtle-alt", "color": "hsl(18, 22%, 84%)", "name": "Primary Subtle Alt (Clay Hairline 84%)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(206, 18%, 83%)", "name": "Secondary Subtle Alt (Sky 83%)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(34, 20%, 84%)", "name": "Tertiary Subtle Alt (Parchment Border 84%)" },

				{ "slug": "primary-alt", "color": "hsl(18, 40%, 38%)", "name": "Primary Alt (Deep Coastal Terracotta 38%)" },
				{ "slug": "secondary-alt", "color": "hsl(206, 26%, 34%)", "name": "Secondary Alt (Storm Navy 34%)" },
				{ "slug": "tertiary-alt", "color": "hsl(34, 34%, 38%)", "name": "Tertiary Alt (Burnished Ochre 38%)" },

				{ "slug": "dark", "color": "hsl(208, 21%, 22%)", "name": "Dark (Midnight Blue 22%)" },
				{ "slug": "dark-alt", "color": "hsl(209, 24%, 16%)", "name": "Dark Alt (Midnight Blue 16%)" },				

				{ "slug": "tertiary-dark", "color": "hsl(34, 34%, 22%)", "name": "Dark Accent (Antique Gold Deep 22%)" },
				{ "slug": "tertiary-dark-alt", "color": "hsl(34, 34%, 14%)", "name": "Dark Accent Alt (Antique Gold Abyssal 14%)" },

				{ "slug": "highlight", "color": "hsl(206, 75%, 68%)", "name": "Highlight Links (Luminescent Sky)" },
				{ "slug": "highlight-alt", "color": "hsl(206, 65%, 34%)", "name": "Highlight Links Alt (Deep Sky Links)" },

				{ "slug": "highlight-accent", "color": "hsl(18, 75%, 72%)", "name": "Highlight Accent (Luminescent Terracotta Links)" },
				{ "slug": "highlight-accent-alt", "color": "hsl(18, 65%, 36%)", "name": "Highlight Accent Alt (Deep Terracotta Links)" },

				{ "slug": "neutral", "color": "hsl(40, 18%, 94%)", "name": "Neutral (Warm Sand 94%)" },
				{ "slug": "neutral-alt", "color": "hsl(40, 15%, 88%)", "name": "Neutral Alt (Sand 88%)" },
				{ "slug": "off-white", "color": "hsl(40, 20%, 97.5%)", "name": "Off White (Desert Alabaster 97.5%)" },
				{ "slug": "very-light-gray", "color": "hsl(40, 16%, 91.5%)", "name": "Very Light Gray (Warm Sand 91.5%)" },
				{ "slug": "light-gray", "color": "hsl(40, 14%, 84%)", "name": "Light Gray (Warm Sand Inner 84%)" },
				{ "slug": "gray", "color": "hsl(40, 8%, 71%)", "name": "Gray (Warm Sand 71%)" },
				{ "slug": "dark-gray", "color": "hsl(40, 4%, 44%)", "name": "Dark Gray (Muted Espresso 44%)" },
				{ "slug": "very-dark-gray", "color": "hsl(40, 2%, 25%)", "name": "Very Dark Gray (Smoky Sand Shadow 25%)" },
	
				{ "slug": "almost-black", "color": "hsl(208, 10%, 14%)", "name": "Almost Black (Tinted Carbon 14%)" },
				{ "slug": "not-quite-black", "color": "hsl(209, 15%, 11%)", "name": "Not Quite Black (Rich Tinted Carbon)" },
				
				{ "slug": "base", "color": "hsl(32, 20%, 97%)", "name": "Base (Almond White)" },
				{ "slug": "contrast", "color": "hsl(214, 12%, 11%)", "name": "Contrast (Midnight Indigo)" }
			],
			"duotone": [
				{ "colors": ["hsl(18, 38%, 48%)", "hsl(32, 20%, 97%)"], "slug": "primary", "name": "Primary (Coastal Terracotta)" },
				{ "colors": ["hsl(18, 40%, 38%)", "hsl(32, 20%, 97%)"], "slug": "primary-alt", "name": "Primary Alt (Deep Coastal Terracotta)" },
				{ "colors": ["hsl(206, 24%, 44%)", "hsl(32, 20%, 97%)"], "slug": "secondary", "name": "Secondary (Ocean Blue)" },
				{ "colors": ["hsl(206, 26%, 34%)", "hsl(32, 20%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt (Storm Navy)" },
				{ "colors": ["hsl(34, 32%, 48%)", "hsl(32, 20%, 97%)"], "slug": "tertiary", "name": "Tertiary (Antique Gold)" },
				{ "colors": ["hsl(34, 34%, 38%)", "hsl(32, 20%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt (Burnished Ochre)" },
				{ "colors": ["hsl(209, 24%, 16%)", "hsl(206, 24%, 44%)"], "slug": "midnight", "name": "Midnight (SaaS Dark Mode)" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 11%)", "hsl(32, 6%, 71%)"], "slug": "dark-grayscale", "name": "Dark Grayscale (Muted Carbon)" }
			]
		}
	}
}
