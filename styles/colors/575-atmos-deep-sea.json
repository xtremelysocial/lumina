				{ "slug": "light-purple", "color": "#D3CED2", "name": "Light Purple" },
				{ "slug": "purple", "color": "#8E838A", "name": "Purple" },
				{ "slug": "dark-purple", "color": "#6B6066", "name": "Dark Purple" },
				{ "slug": "very-light-red", "color": "#F0E6E6", "name": "Very Light Red" },
