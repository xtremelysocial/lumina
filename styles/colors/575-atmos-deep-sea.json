{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Deep Sea (Oceanic Dark: Dark midnight slate canvas with technical maritime accents)",
	"settings": {
		"custom": {
			"color": {			
				"contrast": {
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)"
				},
				"heading": {
					"text": "#BCEBE3",
					"separator": "#3D7A9E"
				},
				"button": {
					"background": "var:preset|color|primary"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(10, 15, 20, 0.55), 0 1px 3px rgba(0, 0, 0, 0.35)",
					"deep": "0 6px 16px rgba(6, 10, 14, 0.65), 0 3px 6px rgba(0, 0, 0, 0.45)",
					"sharp": "0 14px 30px rgba(6, 10, 14, 0.75), 0 6px 12px rgba(0, 0, 0, 0.50)",
					"crisp": "0 24px 50px rgba(6, 10, 14, 0.85), 0 10px 20px rgba(0, 0, 0, 0.60)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#3D7A9E", "name": "Primary (Deep Sea Cyan)" },
				{ "slug": "primary-alt", "color": "#529CC4", "name": "Primary Alt (Glacial Hover)" },			
				{ "slug": "secondary", "color": "#1C2633", "name": "Secondary (Submerged Panel)" },
				{ "slug": "secondary-alt", "color": "#253342", "name": "Secondary Alt (Hero & CTA Canvas)" },
				{ "slug": "tertiary", "color": "#0D1218", "name": "Tertiary (Abyssal Recess)" },
				{ "slug": "tertiary-alt", "color": "#151D26", "name": "Tertiary Alt (Deep Recess)" },		
				{ "slug": "primary-subtle", "color": "#1E2B38", "name": "Primary Subtle (Deep Slate Fill)" },
				{ "slug": "primary-subtle-alt", "color": "#2A3C4E", "name": "Primary Subtle Alt (Light Slate Fill)" },
				{ "slug": "secondary-subtle", "color": "#141C26", "name": "Secondary Subtle (Abyssal Marine Fill)" },
				{ "slug": "secondary-subtle-alt", "color": "#202C3C", "name": "Secondary Subtle Alt (Marine Layer)" },
				{ "slug": "tertiary-subtle", "color": "#090D12", "name": "Tertiary Subtle (Floor Fill)" },
				{ "slug": "tertiary-subtle-alt", "color": "#111822", "name": "Tertiary Subtle Alt (Floor Panel)" },	
				{ "slug": "base", "color": "#121921", "name": "Base (Dark Deep Sea Canvas)" },
				{ "slug": "contrast", "color": "#FAF9F6", "name": "Contrast (Off White Typography)" },
