				{ "colors": ["#151D26", "#FAF9F6"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["#8E838A", "#A8855A"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["#1C2633", "#946B6B"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["#0D1218", "#3A5266"], "slug": "midnight", "name": "Midnight" },
