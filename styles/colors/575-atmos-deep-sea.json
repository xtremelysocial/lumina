{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Deep Sea (Oceanic Dark: Dark midnight slate canvas with technical maritime accents)",
	"settings": {
		"custom": {
			"color": {			
				"contrast": {
					"primary-subtle": "var(--wp--preset--color--foreground-alt)",
					"primary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle": "var(--wp--preset--color--foreground-alt)",
					"secondary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle": "var(--wp--preset--color--foreground-alt)",
					"tertiary-subtle-alt": "var(--wp--preset--color--foreground-alt)",
					"neutral": "var(--wp--preset--color--foreground-alt)",
					"neutral-alt": "var(--wp--preset--color--foreground-alt)"
				},
				"heading": {
					"text": "hsl(169, 56%, 83%)",
					"separator": "var(--wp--preset--color--primary)"
				},
				"button": {
					"background": "var:preset|color|primary"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(10, 15, 20, 0.55), 0 1px 3px rgba(0, 0, 0, 0.35)",
					"deep": "0 6px 16px rgba(6, 10, 14, 0.65), 0 3px 6px rgba(0, 0, 0, 0.45)",
					"sharp": "0 14px 30px rgba(6, 10, 14, 0.75), 0 6px 12px rgba(0, 0, 0, 0.50)",
					"crisp": "0 24px 50px rgba(6, 10, 14, 0.85), 0 10px 20px rgba(0, 0, 0, 0.60)",				
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--primary)"
				}
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(202, 32%, 38%)", "name": "Primary (Toned Deep Sea Cyan)" },
				{ "slug": "primary-alt", "color": "hsl(202, 35%, 48%)", "name": "Primary Alt (Glacial Hover)" },			
				{ "slug": "secondary", "color": "hsl(212, 29%, 15%)", "name": "Secondary (Submerged Panel)" },
				{ "slug": "secondary-alt", "color": "hsl(212, 28%, 20%)", "name": "Secondary Alt (Hero & CTA Canvas)" },
				{ "slug": "tertiary", "color": "hsl(212, 30%, 7%)", "name": "Tertiary (Abyssal Recess)" },
				{ "slug": "tertiary-alt", "color": "hsl(212, 29%, 12%)", "name": "Tertiary Alt (Deep Recess)" },		

				{ "slug": "primary-subtle", "color": "hsl(212, 26%, 16%)", "name": "Primary Subtle (Deep Slate Fill)" },
				{ "slug": "primary-subtle-alt", "color": "hsl(212, 22%, 24%)", "name": "Primary Subtle Alt (Light Slate Fill)" },
				{ "slug": "secondary-subtle", "color": "hsl(212, 24%, 13%)", "name": "Secondary Subtle (Abyssal Marine Fill)" },
				{ "slug": "secondary-subtle-alt", "color": "hsl(212, 20%, 18%)", "name": "Secondary Subtle Alt (Marine Layer)" },
				{ "slug": "tertiary-subtle", "color": "hsl(212, 33%, 5%)", "name": "Tertiary Subtle (Floor Fill)" },
				{ "slug": "tertiary-subtle-alt", "color": "hsl(212, 33%, 8%)", "name": "Tertiary Subtle Alt (Floor Panel)" },	

				{ "slug": "base", "color": "hsl(212, 29%, 10%)", "name": "Base (Dark Deep Sea Canvas)" },
				{ "slug": "contrast", "color": "hsl(43, 27%, 97%)", "name": "Contrast (Off White Typography)" },
				{ "slug": "neutral", "color": "hsl(212, 29%, 15%)", "name": "Neutral (Submerged Slate)" },
				{ "slug": "neutral-alt", "color": "hsl(212, 28%, 20%)", "name": "Neutral Alt (Maritime Border)" },
				{ "slug": "foreground-alt", "color": "hsl(43, 27%, 97%)", "name": "Foreground Alt (Off White)" },

				{ "slug": "highlight", "color": "hsl(202, 75%, 70%)", "name": "Highlight (Luminous Sky Blue Link)" },
				{ "slug": "highlight-alt", "color": "hsl(202, 82%, 80%)", "name": "Highlight Alt (Glacial Ice Hover)" },
				{ "slug": "dark", "color": "hsl(212, 35%, 4%)", "name": "Dark (Abyssal Midnight)" },
				{ "slug": "dark-alt", "color": "hsl(0, 0%, 0%)", "name": "Dark Alt (True Black)" },							

				{ "slug": "white", "color": "hsl(0, 0%, 100%)", "name": "White" },
				{ "slug": "off-white", "color": "hsl(43, 27%, 97%)", "name": "Off White" },
				{ "slug": "very-light-gray", "color": "hsl(43, 15%, 91%)", "name": "Very Light Gray" },
				{ "slug": "light-gray", "color": "hsl(43, 10%, 88%)", "name": "Light Gray" },
				{ "slug": "gray", "color": "hsl(43, 4%, 68%)", "name": "Gray" },
				{ "slug": "dark-gray", "color": "hsl(43, 3%, 43%)", "name": "Dark Gray" },
				{ "slug": "very-dark-gray", "color": "hsl(60, 2%, 23%)", "name": "Very Dark Gray" },
				{ "slug": "almost-black", "color": "hsl(0, 0%, 18%)", "name": "Almost Black" },
				{ "slug": "not-quite-black", "color": "hsl(0, 0%, 11%)", "name": "Not Quite Black" },
				{ "slug": "black", "color": "hsl(0, 0%, 0%)", "name": "Black" },

				{ "slug": "very-light-green", "color": "hsl(154, 13%, 91%)", "name": "Very Light Green" },
				{ "slug": "light-green", "color": "hsl(154, 11%, 83%)", "name": "Light Green" },
				{ "slug": "green", "color": "hsl(155, 16%, 46%)", "name": "Green" },
				{ "slug": "dark-green", "color": "hsl(154, 9%, 25%)", "name": "Dark Green" },
				{ "slug": "very-light-yellow", "color": "hsl(43, 15%, 91%)", "name": "Very Light Yellow" },
				{ "slug": "light-yellow", "color": "hsl(43, 19%, 80%)", "name": "Light Yellow" },
				{ "slug": "yellow", "color": "hsl(33, 30%, 51%)", "name": "Yellow" },
				{ "slug": "dark-yellow", "color": "hsl(32, 38%, 42%)", "name": "Dark Yellow" },
				{ "slug": "very-light-orange", "color": "hsl(27, 27%, 91%)", "name": "Very Light Orange" },
				{ "slug": "light-orange", "color": "hsl(26, 21%, 82%)", "name": "Light Orange" },
				{ "slug": "orange", "color": "hsl(12, 31%, 49%)", "name": "Orange" },
				{ "slug": "dark-orange", "color": "hsl(11, 36%, 36%)", "name": "Dark Orange" },
				{ "slug": "very-light-blue", "color": "hsl(200, 15%, 90%)", "name": "Very Light Blue" },
				{ "slug": "light-blue", "color": "hsl(202, 13%, 81%)", "name": "Light Blue" },
				{ "slug": "blue", "color": "hsl(207, 28%, 31%)", "name": "Blue (Maritime Slate)" },
				{ "slug": "dark-blue", "color": "hsl(211, 28%, 20%)", "name": "Dark Blue (Hero Canvas)" },
				{ "slug": "midnight-blue", "color": "hsl(214, 29%, 15%)", "name": "Midnight Blue" },
				{ "slug": "dark-midnight-blue", "color": "hsl(211, 29%, 10%)", "name": "Dark Midnight Blue" },
				{ "slug": "very-light-purple", "color": "hsl(320, 7%, 91%)", "name": "Very Light Purple" },
				{ "slug": "light-purple", "color": "hsl(320, 5%, 82%)", "name": "Light Purple" },
				{ "slug": "purple", "color": "hsl(327, 5%, 40%)", "name": "Purple" },
				{ "slug": "dark-purple", "color": "hsl(327, 5%, 31%)", "name": "Dark Purple" },
				{ "slug": "very-light-red", "color": "hsl(0, 17%, 92%)", "name": "Very Light Red" },
				{ "slug": "light-red", "color": "hsl(0, 16%, 82%)", "name": "Light Red" },
				{ "slug": "red", "color": "hsl(0, 18%, 36%)", "name": "Red" },
				{ "slug": "dark-red", "color": "hsl(0, 18%, 27%)", "name": "Dark Red" }
			],
			"duotone": [
				{ "colors": ["hsl(207, 28%, 31%)", "hsl(43, 27%, 97%)"], "slug": "primary", "name": "Primary" },
				{ "colors": ["hsl(207, 28%, 41%)", "hsl(43, 27%, 97%)"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["hsl(212, 29%, 15%)", "hsl(43, 27%, 97%)"], "slug": "secondary", "name": "Secondary" },
				{ "colors": ["hsl(212, 28%, 20%)", "hsl(43, 27%, 97%)"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["hsl(212, 30%, 7%)", "hsl(43, 27%, 97%)"], "slug": "tertiary", "name": "Tertiary" },
				{ "colors": ["hsl(212, 29%, 12%)", "hsl(43, 27%, 97%)"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(33, 30%, 51%)"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["hsl(212, 29%, 15%)", "hsl(0, 18%, 36%)"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["hsl(212, 30%, 7%)", "hsl(207, 28%, 31%)"], "slug": "midnight", "name": "Midnight" },
				{ "colors": ["hsl(0, 18%, 36%)", "hsl(33, 30%, 51%)"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["hsl(327, 5%, 40%)", "hsl(155, 16%, 46%)"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["hsl(207, 28%, 31%)", "hsl(12, 31%, 49%)"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(0, 0%, 100%)"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["hsl(0, 0%, 0%)", "hsl(212, 29%, 15%)"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--custom--color--heading--text)"
				}
			}
		}
	}
}