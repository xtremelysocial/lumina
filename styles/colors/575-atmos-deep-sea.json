				{ "slug": "light-blue", "color": "#C9D1D6", "name": "Light Blue" },
				{ "slug": "blue", "color": "#3A5266", "name": "Blue (Maritime Slate)" },
				{ "slug": "dark-blue", "color": "#253342", "name": "Dark Blue (Hero Canvas)" },
				{ "slug": "midnight-blue", "color": "#1C2633", "name": "Midnight Blue" },
				{ "slug": "dark-midnight-blue", "color": "#121921", "name": "Dark Midnight Blue" },
