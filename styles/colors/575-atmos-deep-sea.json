			"duotone": [
				{ "colors": ["#3A5266", "#FAF9F6"], "slug": "primary", "name": "Primary" },
				{ "colors": ["#4B6B85", "#FAF9F6"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["#1C2633", "#FAF9F6"], "slug": "secondary", "name": "Secondary" },
				{ "colors": ["#253342", "#FAF9F6"], "slug": "secondary-alt", "name": "Secondary Alt" },
