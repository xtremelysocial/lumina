				{ "slug": "tertiary-alt", "color": "hsl(0, 23%, 32%)", "name": "Tertiary Alt (Patina Crimson Flagship 32%)" },

				{ "slug": "primary-subtle", "color": "hsl(212, 20%, 95%)", "name": "Primary Subtle (Whisper Oxford Veil 95%)" },
				{ "slug": "secondary-subtle", "color": "hsl(42, 24%, 95%)", "name": "Secondary Subtle (Whisper Brass Veil 95%)" },
