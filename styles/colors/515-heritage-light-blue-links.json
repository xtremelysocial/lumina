{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Heritage Light w/Blue Links - High-Key Professor’s Library: Oxford slate fills, patina crimson accents, and aged brass",
	"settings": {
		"custom": {
			"color": {
				"theme": {
					"mode": "is-light-theme",
					"scheme": "heritage-light"
				},
				"highlight": {
					"darken": "brightness(0.75) saturate(0.85)"
				},
				"highlight-alt": {
					"lighten": "brightness(1.33) saturate(1.18)"
				},
				"contrast": {
					"primary": "var(--wp--preset--color--contrast)",
					"secondary": "var(--wp--preset--color--contrast)",
					"tertiary": "var(--wp--preset--color--contrast)"
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--secondary-alt)"
				},
				"button": {
					"background": "var(--wp--preset--color--tertiary-alt)",
					"text": "var(--wp--preset--color--foreground-alt)"
				},
				"image": {
					"hoverOpacity": "0.8"
				}
			}
		},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(212, 24%, 91%)", "name": "Primary (Soft Oxford Slate Fill 91%)" },
				{ "slug": "secondary", "color": "hsl(42, 30%, 90%)", "name": "Secondary (Soft Golden Brass Fill 90%)" },
				{ "slug": "tertiary", "color": "hsl(14, 28%, 91%)", "name": "Tertiary (Soft Rose Linen Fill 91%)" },

				{ "slug": "base", "color": "hsl(40, 25%, 96%)", "name": "Base (Warm Parchment Canvas)" },
				
