{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Cupertino (Precision White: Minimalist, clean-room laboratory tech)",
	"settings": {
		"custom": {
			"color": {
				"contrast": {
					"primary": "var(--wp--preset--color--almost-black)",
					"secondary": "var(--wp--preset--color--almost-black)",
					"secondary-alt": "var(--wp--preset--color--white)",
					"tertiary": "var(--wp--preset--color--white)",
					"highlight": "var(--wp--preset--color--white)",
					"highlight-alt": "var(--wp--preset--color--white)",
					"dark": "var(--wp--preset--color--almost-black)",
					"dark-alt": "var(--wp--preset--color--almost-black)",
					"neutral": "var(--wp--preset--color--almost-black)",
					"neutral-alt": "var(--wp--preset--color--almost-black)",
					"yellow": "var(--wp--preset--color--foreground-alt)",
					"bright-green": "var(--wp--preset--color--almost-black)",
					"light-green": "var(--wp--preset--color--almost-black)",
					"light-orange": "var(--wp--preset--color--almost-black)"
				},
				"shadow": {
					"natural": "0 2px 8px rgba(0, 0, 0, 0.06), 0 1px 3px rgba(0, 0, 0, 0.03)",
					"deep":    "0 6px 16px rgba(0, 0, 0, 0.08), 0 3px 6px rgba(0, 0, 0, 0.04)",
					"sharp":   "0 14px 30px rgba(0, 0, 0, 0.10), 0 6px 12px rgba(0, 0, 0, 0.06)",
					"crisp":   "0 24px 50px rgba(0, 0, 0, 0.12), 0 10px 20px rgba(0, 0, 0, 0.08)",
					"outline": "0 0 0 2px var(--wp--preset--color--base), 0 0 0 4px var(--wp--preset--color--highlight)"
				}				
			}
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#F5F5F7", "name": "System Gray Light" },
				{ "slug": "primary-alt", "color": "#E8E8ED", "name": "System Gray Medium" },
				{ "slug": "secondary", "color": "#D2D2D7", "name": "System Gray Border" },
				{ "slug": "secondary-alt", "color": "#86868B", "name": "Secondary Text" },
				{ "slug": "tertiary", "color": "#1D1D1F", "name": "Apple Black" },
				{ "slug": "tertiary-alt", "color": "#000000", "name": "Pure Black" },
				{ "slug": "base", "color": "#FFFFFF", "name": "Base" },
				{ "slug": "contrast", "color": "#1B1B1B", "name": "Contrast" },
				{ "slug": "neutral", "color": "#F5F5F7", "name": "Neutral" },
				{ "slug": "neutral-alt", "color": "#D2D2D7", "name": "Neutral Alt" },
				{ "slug": "foreground-alt", "color": "#FFFFFF", "name": "Foreground Alt" },
				{ "slug": "highlight", "color": "#007AFF", "name": "Highlight" },
				{ "slug": "highlight-alt", "color": "#0051AF", "name": "Highlight Hover" },
				{ "slug": "dark", "color": "#F5F5F7", "name": "Dark" },
				{ "slug": "dark-alt", "color": "#E8E8ED", "name": "Dark Alt" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" },
				{ "slug": "off-white", "color": "#FAF9F6", "name": "Off White" },
				{ "slug": "very-light-gray", "color": "#F2F1ED", "name": "Very Light Gray" },
				{ "slug": "light-gray", "color": "#E5E4DF", "name": "Light Gray" },
				{ "slug": "gray", "color": "#B0AFA9", "name": "Gray" },
				{ "slug": "dark-gray", "color": "#706F6A", "name": "Dark Gray" },
				{ "slug": "very-dark-gray", "color": "#3D3D3A", "name": "Very Dark Gray" },
				{ "slug": "light-green", "color": "#C8D6CF", "name": "Light Green" },
				{ "slug": "green", "color": "#78A391", "name": "Green" },
				{ "slug": "bright-green", "color": "#8DBA9D", "name": "Bright Green" },
				{ "slug": "dark-bright-green", "color": "#4A6E5D", "name": "Dark Bright Green" },
				{ "slug": "light-yellow", "color": "#EDE6D8", "name": "Light Yellow" },
				{ "slug": "yellow", "color": "#B38B59", "name": "Yellow" },
				{ "slug": "light-orange", "color": "#E6C6BA", "name": "Light Orange" },
				{ "slug": "orange", "color": "#A36555", "name": "Orange" },
				{ "slug": "dark-orange", "color": "#7D483B", "name": "Dark Orange" },
				{ "slug": "light-blue", "color": "#C0CCD3", "name": "Light Blue" },
				{ "slug": "blue", "color": "#536A78", "name": "Blue" },
				{ "slug": "dark-blue", "color": "#384952", "name": "Dark Blue" },
				{ "slug": "midnight-blue", "color": "#3D4E5B", "name": "Midnight Blue" },
				{ "slug": "dark-midnight-blue", "color": "#2A323D", "name": "Dark Midnight Blue" },
				{ "slug": "light-purple", "color": "#D2C9CE", "name": "Light Purple" },
				{ "slug": "purple", "color": "#7D7178", "name": "Purple" },
				{ "slug": "dark-purple", "color": "#574E53", "name": "Dark Purple" },
				{ "slug": "light-red", "color": "#D9C4C4", "name": "Light Red" },
				{ "slug": "red", "color": "#946B6B", "name": "Red" },
				{ "slug": "dark-red", "color": "#6E4C4C", "name": "Dark Red" },
				{ "slug": "almost-black", "color": "#2D2D2D", "name": "Almost Black" },
				{ "slug": "not-quite-black", "color": "#1A1A1A", "name": "Not Quite Black" },
				{ "slug": "black", "color": "#000000", "name": "Black" }
			],
			"duotone": [
				{ "colors": ["#4A6E5D", "#FAF9F6"], "slug": "primary", "name": "Primary" },
				{ "colors": ["#78A391", "#FAF9F6"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["#2A323D", "#FAF9F6"], "slug": "secondary", "name": "Secondary" },
				{ "colors": ["#1E242C", "#FAF9F6"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["#B38B59", "#FAF9F6"], "slug": "tertiary", "name": "Tertiary" },
				{ "colors": ["#946E42", "#FAF9F6"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["#7D7178", "#B38B59"], "slug": "purple-yellow", "name": "Purple and Yellow" },
				{ "colors": ["#384952", "#946B6B"], "slug": "blue-red", "name": "Blue and Red" },
				{ "colors": ["#2D2D2D", "#384952"], "slug": "midnight", "name": "Midnight" },
				{ "colors": ["#946B6B", "#B38B59"], "slug": "magenta-yellow", "name": "Red and Yellow" },
				{ "colors": ["#7D7178", "#78A391"], "slug": "purple-green", "name": "Purple and Green" },
				{ "colors": ["#384952", "#A36555"], "slug": "blue-orange", "name": "Blue and Orange" },
				{ "colors": ["#000000", "#FFFFFF"], "slug": "grayscale", "name": "Grayscale" },
				{ "colors": ["#000000", "#706F6A"], "slug": "dark-grayscale", "name": "Dark Grayscale" }
			]
		}
	}
}