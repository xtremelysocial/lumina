{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Light - High-Key Ethereal: Soft mist fills and crisp charcoal ink",
	"settings": {
		"custom": {
			"color": {		
				"theme": {
					"mode": "is-light-theme",
					"scheme": "light"
				},
				"contrast": {
					"primary": "var(--wp--preset--color--contrast)",
					"secondary": "var(--wp--preset--color--contrast)",
					"tertiary": "var(--wp--preset--color--contrast)"
				},
				"heading": {
					"text": "var(--wp--preset--color--contrast)",
					"separator": "var(--wp--preset--color--primary-alt)"
				},
				"button": {
					"background": 	"var(--wp--preset--color--primary-alt)",
					"text": 		"var(--wp--preset--color--foreground-alt)",
					"hover": 		"var(--wp--preset--color--secondary-alt)",
					"hoverOpacity": "0.8" 
				}		
			}
		},	
		"color": {
			"palette": [
				{ "slug": "primary", "color": "hsl(154, 22%, 92%)", "name": "Primary (Soft Sage Mist Fill 92%)" },
				{ "slug": "secondary", "color": "hsl(206, 22%, 92%)", "name": "Secondary (Soft Sky Slate Fill 92%)" },
				{ "slug": "tertiary", "color": "hsl(38, 24%, 92%)", "name": "Tertiary (Soft Linen Amber Fill 92%)" },

				{ "slug": "primary-alt", "color": "hsl(154, 38%, 32%)", "name": "Primary Alt (Deep Pine Action 32%)" },
				{ "slug": "secondary-alt", "color": "hsl(206, 38%, 32%)", "name": "Secondary Alt (Deep Storm Action 32%)" },
				{ "slug": "tertiary-alt", "color": "hsl(34, 45%, 34%)", "name": "Tertiary Alt (Deep Ochre Action 34%)" },
				
