			"duotone": [
				{ "colors": ["hsl(154, 38%, 32%)", "hsl(0, 0%, 99%)"], "slug": "primary", "name": "Primary (Pine & Crisp)" },
				{ "colors": ["hsl(154, 22%, 92%)", "hsl(0, 0%, 99%)"], "slug": "primary-alt", "name": "Primary Alt" },
				{ "colors": ["hsl(206, 38%, 32%)", "hsl(0, 0%, 99%)"], "slug": "secondary", "name": "Secondary (Storm & Crisp)" },
				{ "colors": ["hsl(206, 22%, 92%)", "hsl(0, 0%, 99%)"], "slug": "secondary-alt", "name": "Secondary Alt" },
				{ "colors": ["hsl(34, 45%, 34%)", "hsl(0, 0%, 99%)"], "slug": "tertiary", "name": "Tertiary (Ochre & Crisp)" },
				{ "colors": ["hsl(38, 24%, 92%)", "hsl(0, 0%, 99%)"], "slug": "tertiary-alt", "name": "Tertiary Alt" },
				{ "colors": ["hsl(215, 20%, 13%)", "hsl(154, 22%, 92%)"], "slug": "midnight", "name": "High Key Mist" },
