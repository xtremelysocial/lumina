{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Spacious",
	"description": "An ultra-modern, fluid mood. Organic 40px 'pebble' corners, elastic spring physics, and soft-focus glassmorphic diffusion designed for warm, burnished clay palettes.",
	"settings": {
		"custom": {
			"border": {
				"radius": "40px" 
			},
			"button": {
				"radius": "999px" 
			},
			"spacing": {
				"gap": "25px"
			},
			"animation": {
				"duration": {
					"short": "200ms",
					"normal": "350ms",
					"medium": "500ms",
					"slow": "900ms"
				},
				"timingFunction": "cubic-bezier(0.34, 1.56, 0.64, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.03)",
					"hoverTransform": "scale(1.07)",
					"hoverLargeTransform": "scale(1.15)",
					"objectSmallTransform": "translateY(-2px)",
					"objectTransform": "translateY(-4px)"
				}
			},
			"typography": {
				"fontWeight": {
					"light": "200",
					"normal": "300",
					"medium": "400",
					"bold": "500"
				}
			}
		}
	}
}