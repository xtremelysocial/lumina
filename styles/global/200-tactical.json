{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Tactical",
	"description": "A high-performance tactical mood. Rugged 9px corners, fast animation response times.",
	"settings": {
		"custom": {
			"border": {
				"radius": "var(--wp--preset--border-radius--md, 9px)"
			},
			"button": {
				"radius": "var(--wp--preset--border-radius--sm, 6px)" 
			},
			"spacing": {
				"gap": "20px"
			},
			"animation": {
				"duration": {
					"short": "180ms",
					"medium": "300ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.02)",
					"hoverTransform": "scale(1.04)",
					"hoverLargeTransform": "scale(1.10)",
					"objectSmallTransform": "translateY(-3px)",
					"objectTransform": "translateY(-4px)"
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"core/button" : {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--lg, 12px)"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--lg, 12px)"
						}
					}
				}
			}
		}
	}
}