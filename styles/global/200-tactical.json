{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Tactical",
	"description": "A high-performance tactical mood. Rugged 9px corners, fast animation response times.",
	"settings": {
		"custom": {
			"border": {
				"radius": "12px"
			},
			"button": {
				"radius": "var(--wp--preset--border-radius--sm)" 
			},
			"spacing": {
				"gap": "20px"
			},
			"animation": {
				"duration": {
					"short": "180ms",
					"medium": "300ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"transform": 		"none",
					"hoverTransform": 	"scale(1.04)"
				},
				"button": {
					"transform": "none",
					"hoverTransform": "scale(1.04)"
				},
				"card": {
					"transform": "none",
					"hoverTransform": "translateY(-3px)"
				},
				"image": {
					"transform": "none",
					"hoverTransform": "translateY(-4px)"
				},
				"mediaText": {
					"hoverTransform": "scale(1.10)"
				},
				"motion": {
					"panIntensity":  1.15,
					"zoomIntensity": 1.20,
					"durationFactor": 0.75
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--md)"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--md)"
						}
					}
				}
			}
		}
	}
}