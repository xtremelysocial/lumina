{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Gallery",
	"description": "A sophisticated, art gallery mood featuring sharp architectural corners, and a weighted, luxurious physical presence.",
	"settings": {
		"custom": {
			"border": {
				"radius": "8px"
			},
			"button": {
				"radius": "var(--wp--preset--border-radius--sm)"
			},
			"spacing": {
				"gap": "28px"
			},
			"animation": {
				"duration": {
					"short": 		"200ms",
					"medium": 		"800ms"
				},
				"timingFunction": "cubic-bezier(0.2, 0, 0, 1)",
				"fillMode": 		"both",
				"motion": {
					"panIntensity":  0.85,
					"zoomIntensity": 0.85,
					"durationFactor": 1.25
				},
				"default": {
					"transform": 		"none",
					"hoverTransform": 	"scale(1.02)"
				},
				"button": {
					"transform": "none",
					"hoverTransform": "scale(1.05)"
				},
				"card": {
					"transform": "none",
					"hoverTransform": "translateY(-3px)"
				},
				"image": {
					"transform": "none",
					"hoverTransform": "translateY(-4px)"
				},
				"mediaText": {
					"transform": "scale(1.00)",
					"hoverTransform": "scale(1.05)"
				}
			},
			"link": {
				"style": "solid",
				"thickness": "1px",
				"position": "under",
				"offset": "4px"
			}
		}	
	},
	"styles": {
		"blocks": {
			"core/button": {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--md)"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--md)"
						}
					}
				}
			}
		}
	}
}