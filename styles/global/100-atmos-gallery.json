{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Gallery",
	"description": "A sophisticated, art gallery mood featuring sharp architectural corners, and a weighted, luxurious physical presence.",
	"settings": {
		"custom": {
			"color": {
				"border": "var(--wp--preset--color--neutral-alt)",
				"field": { 
					"outline": "rgba(45, 35, 25, 0.25)" 
				},
				"button": { 
					"hoverOpacity": "0.9" 
				},
				"link": { 
					"hoverOpacity": "0.8" 
				},
				"navigation": { 
					"background": "var(--wp--preset--color--base)" 
				}
			},
			"border": {
				"radius": "var(--wp--preset--border-radius--xs, 4.5px)"
			},
			"button": {
				"radius": "var(--wp--preset--border-radius--xs, 4.5px)"
			},
			"spacing": {
				"gap": "24px"
			},
			"animation": {
				"duration": {
					"short": "200ms",
					"medium": "800ms"
				},
				"timingFunction": "cubic-bezier(0.2, 0, 0, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.02)",
					"hoverTransform": "scale(1.03)",
					"hoverLargeTransform": "scale(1.05)",
					"objectSmallTransform": "translateY(-2px)",
					"objectTransform": "translateY(-3px)"
				}
			},
			"link": {
				"style": "solid",
				"thickness": "1px",
				"postion": "under",
				"offset": "4px"
			}
		}	
	}
}