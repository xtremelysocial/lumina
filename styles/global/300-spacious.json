{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Spacious",
	"description": "An ultra-modern, fluid mood. Organic 30px 'pebble' corners, elastic spring physics.",
	"settings": {
		"custom": {
			"border": {
				"radius": "var(--wp--preset--border-radius--3-xl, 30px)" 
			},
			"button": {
				"radius": "999px" 
			},
			"spacing": {
				"gap": "25px"
			},
			"animation": {
				"duration": {
					"short": "350ms",
					"medium": "500ms"
				},
				"timingFunction": "cubic-bezier(0.34, 1.56, 0.64, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.03)",
					"hoverTransform": "scale(1.07)",
					"hoverLargeTransform": "scale(1.15)",
					"objectSmallTransform": "translateY(-4px)",
					"objectTransform": "translateY(-5px)"
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"core/button" : {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--3-xl, 30px)"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--3-xl, 30px)"
						}
					}
				}
			}
		}
	}
}