{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lumina Spacious",
	"description": "An ultra-modern, fluid mood. Organic 24px 'pebble' corners, elastic spring physics.",
	"settings": {
		"custom": {
			"border": {
				"radius": "24px" 
			},
			"button": {
				"radius": "999px" 
			},
			"spacing": {
				"gap": "28px"
			},
			"animation": {
				"duration": {
					"short": "350ms",
					"medium": "500ms"
				},
				"timingFunction": "cubic-bezier(0.34, 1.56, 0.64, 1)",
				"fillMode": "both",
				"default": {
					"transform": 		"none",
					"hoverTransform": 	"scale(1.03)"
				},
				"button": {
					"transform": "none",
					"hoverTransform": "scale(1.07)"
				},
				"card": {
					"transform": "none",
					"hoverTransform": "translateY(-4px)"
				},
				"image": {
					"transform": "none",
					"hoverTransform": "translateY(-5px)"
				},
				"mediaText": {
					"transform": "scale(1.00)",
					"hoverTransform": "scale(1.15)"
				},
				"motion": {
					"panIntensity":  1.25,
					"zoomIntensity": 1.30,
					"durationFactor": 1.10
				}
			}
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"variations": {
					"button-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--2-xl)"
						}
					},
					"button-outline-alt": {
						"border": {
							"radius": "var(--wp--preset--border-radius--2-xl)"
						}
					}
				}
			}
		}
	}
}