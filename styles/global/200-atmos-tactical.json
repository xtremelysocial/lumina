{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Tactical",
	"description": "A high-performance tactical mood. Rugged 8px corners, mechanical 180ms response times, and high-visibility 'Glow' engagement states designed for deep jewel-tone environments.",
	"settings": {
		"custom": {
			"border": {
				"radius": "var(--wp--preset--border-radius--sm, 9px)"
			},
			"button": {
				"radius": "var(--wp--preset--border-radius--xs, 4.5px)" 
			},
			"spacing": {
				"gap": "20px"
			},
			"animation": {
				"duration": {
					"short": "180ms",
					"medium": "300ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.02)",
					"hoverTransform": "scale(1.04)",
					"hoverLargeTransform": "scale(1.10)",
					"objectSmallTransform": "translateY(-3px)",
					"objectTransform": "translateY(-6px)"
				}
			},
			"typography": {
				"fontWeight": {
					"light": "200",
					"normal": "300",
					"medium": "400",
					"bold": "500"
				}
			}
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var:preset|font-family|roboto",
			"fontSize": "1.1rem",
			"fontWeight": "400",
			"lineHeight": "1.5"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|roboto",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.01em"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|20"
					}
				}
			},
			"link": {
				"typography": {
					"textDecoration": "none"
				},
				"spacing": {
					"margin": { "bottom": "0" }
				}
			}
		},
		"blocks": {
			"core/social-link": {
				"elements": {
					"link": {
						"spacing": {
							"margin": { "top": "0", "bottom": "0" }
						}
					}
				},
				"spacing": {
					"margin": { "top": "0", "bottom": "0" },
					"padding": { "top": "0", "bottom": "0", "left": "0", "right": "0" }
				}
			}
		}
	}	
}