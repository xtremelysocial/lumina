{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Atmos Tactical",
	"description": "A high-performance tactical mood. Rugged 9px corners, fast animation response times.",
	"settings": {
		"custom": {
			"border": {
				"radius": "var(--wp--preset--border-radius--sm, 9px)"
			},
			"button": {
				"radius": "var(--wp--preset--border-radius--xs, 4.5px)" 
			},
			"spacing": {
				"gap": "20px"
			},
			"animation": {
				"duration": {
					"short": "180ms",
					"medium": "300ms"
				},
				"timingFunction": "cubic-bezier(0.4, 0, 0.2, 1)",
				"fillMode": "both",
				"default": {
					"hoverSmallTransform": "scale(1.02)",
					"hoverTransform": "scale(1.04)",
					"hoverLargeTransform": "scale(1.10)",
					"objectSmallTransform": "translateY(-3px)",
					"objectTransform": "translateY(-6px)"
				}
			}
		}
	}
}