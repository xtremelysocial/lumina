{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "pan-zoom",
	"title": "Auto Pan & Zoom",
	"blockTypes": [ "core/image", "core/post-featured-image", "core/cover" ],
	"styles": {
		"border": {
			"style": "solid",
			"width": "1px",
			"color": "var(--wp--custom--color--border)",
			"radius": "var:preset|border-radius|lg"
		}
	}
}
