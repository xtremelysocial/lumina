{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "image-border",
	"title": "Border",
	"blockTypes": [ "core/image", "core/video" ],
	"styles": {
		"border": {
			"style": "solid",
			"width": "1px",
			"color": "var(--wp--custom--color--border)",
			"radius": "var:preset|border-radius|lg"
		}
	}
}
