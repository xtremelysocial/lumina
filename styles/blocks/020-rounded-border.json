{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"slug": "rounded-border",
	"title": "Card w/Border",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/cover", "core/media-text", "core/comments" ],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--neutral)"
		},
		"border": {
			"style": "solid",
			"width": "1px",
			"color": "var(--wp--custom--color--border)",
			"radius": "var:preset|border-radius|lg"
		},
		"spacing": {
			"padding": "var(--wp--preset--spacing--40)"
		}
	}
}
