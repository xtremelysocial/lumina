{
  "name": "lumina",
  "version": "1.0.0",
  "description": "Lumina Wordpress Theme",
  "main": "index.js",
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src/scss --output-path=assets/css && npm run copy:readme",
    "watch:readme": "onchange \"readme.txt\" -- shx cp readme.txt readme.md",
    "start": "concurrently \"wp-scripts start --webpack-src-dir=src/scss --output-path=assets/css\" \"npm run watch:readme\"",
    "copy:readme": "shx cp readme.txt readme.md",
    "theme-zip": "npm run build && npm run copy:readme && zip -r lumina-theme.zip . -x \"*.DS_Store\" \"node_modules/*\" \"zz_unused/*\" \".git*\" \"src/*\" \"package*\" \"webpack*\" \"postcss*\" \"readme.md\""
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "mini-css-extract-plugin": "^2.9.0",
    "onchange": "^7.1.0",
    "postcss-loader": "^8.1.1",
    "remove-files-webpack-plugin": "^1.5.0",
    "shx": "^0.4.0",
    "webpack-remove-empty-scripts": "^1.0.4",
    "webpack-watched-glob-entries-plugin": "^2.2.6"
  }
}
